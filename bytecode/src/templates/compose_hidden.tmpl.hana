function init {
    jump {{concurrent}}::init
}

#[arity(0, 1)]
sentence set {
    jump {{hidden_fn_inner}}
}

function accept_inner {
    jump {{concurrent}}::accept_inner
    jump {{hidden_fn_inner}}
    set_difference
}

function accept {
    untuple 2
    pick 1
    jump {{hidden_fn}}
    branch {
        drop 0
        drop 0
        push false
    } {
        tuple 2
        jump {{concurrent}}::accept
    }
}

function emit {
    pick 0
    jump {{concurrent}}::emit
    untuple 2
    branch {
        pick 0
        jump {{hidden_fn}}
        branch {
            drop 0
            drop 0
            tuple 0
            push false
            tuple 2
        } {
            roll 1
            drop 0
            push true
            tuple 2
        }
    } {
        drop 0
        drop 0
        tuple 0
        push false
        tuple 2
    }
}

function process {
    jump {{concurrent}}::process
}

function tau_reduce {
    pick 0
    jump {{concurrent}}::tau_reduce
    untuple 2
    branch {
        roll 1
        drop 0
        push true
        tuple 2
    } {
        drop 0
        pick 0
        jump {{concurrent}}::emit
        untuple 2
        branch {
            pick 0
            jump {{hidden_fn}}
            branch {
                tuple 2
                jump {{concurrent}}::process
                push true
                tuple 2
            } {
                drop 0
                push false
                tuple 2
            }
        } {
            drop 0
            push false
            tuple 2
        }
    }
}

function is_done {
    jump {{concurrent}}::is_done
}

function is_ready_to_finish {
    jump {{concurrent}}::is_ready_to_finish
}
