#[arity(0, 1)]
sentence init {
    tuple 0
    push 0
    tuple 2
}

#[arity(1, 1)]
sentence accept {
    untuple 2
    push 0
    equal
    branch {
        drop 0
        jump {{val_set_path}}
    } {
        jump {{machine}}::accept
    }
}

#[arity(1, 1)]
sentence tau_reduce {
    untuple 2
    pick 0
    push 0
    equal
    branch {
        tuple 2
        push false
        tuple 2
    } {
        pick 1
        jump {{machine}}::tau_reduce
        untuple 2
        branch {
            roll 1
            roll 2
            drop 0
            tuple 2
            push true
            tuple 2
        } {
            drop 0
            tuple 2
            push false
            tuple 2
        }
    }
}

#[arity(1, 1)]
sentence emit {
    untuple 2
    pick 0
    push 0
    equal
    branch {
        drop 0
        drop 0
        tuple 0
        push false
        tuple 2
    } {
        drop 0
        jump {{machine}}::emit
    }
}

#[arity(2, 1)]
sentence process {
    roll 1
    untuple 2
    pick 0
    push 0
    equal
    branch {
        pick 2
        push {{val_set_path}}
        set_contains
        branch {
            drop 0
            drop 0
            drop 0
            jump {{machine}}::init
            push 1
            tuple 2
        } {
            roll 2
            drop 0
            tuple 2
        }
    } {
        drop 0
        roll 1
        jump {{machine}}::process
        push 1
        tuple 2
    }
}

#[arity(1, 1)]
sentence is_done {
    untuple 2
    pick 0
    push 0
    equal
    branch {
        drop 0
        drop 0
        push false
    } {
        drop 0
        jump {{machine}}::is_done
    }
}

#[arity(1, 1)]
sentence is_ready_to_finish {
    untuple 2
    pick 0
    push 0
    equal
    branch {
        drop 0
        drop 0
        push false
    } {
        drop 0
        jump {{machine}}::is_ready_to_finish
    }
}
