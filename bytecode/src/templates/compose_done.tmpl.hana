#[arity(0, 1)]
sentence init {
    push 0
}

#[arity(1, 1)]
sentence accept {
    drop 0
    push empty_set
}

#[arity(1, 1)]
sentence emit {
    drop 0
    tuple 0
    push false
    tuple 2
}

#[arity(2, 1)]
sentence process {
    drop 0
}

#[arity(1, 1)]
sentence tau_reduce {
    push false
    tuple 2
}

#[arity(1, 1)]
sentence is_done {
    drop 0
    push true
}

#[arity(1, 1)]
sentence is_ready_to_finish {
    drop 0
    push false
}
