function init {
    untuple 0
    push {{val}}
    jump {{machine}}::init
}

function accept_inner {
    jump {{machine}}::accept_inner
}

function accept {
    untuple 2
    jump accept_inner
    set_contains
}

function emit {
    jump {{machine}}::emit
}

function process {
    jump {{machine}}::process
}

function tau_reduce {
    jump {{machine}}::tau_reduce
}

function is_done {
    jump {{machine}}::is_done
}

function is_ready_to_finish {
    jump {{machine}}::is_ready_to_finish
}
