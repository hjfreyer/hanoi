function init {
    untuple 0
    push {{val}}
    jump {{machine}}::init
}

function accept {
    jump {{machine}}::accept
}

function emit {
    jump {{machine}}::emit
}

#[arity(2, 1)]
sentence process {
    jump {{machine}}::process
}

function tau_reduce {
    jump {{machine}}::tau_reduce
}

function is_done {
    jump {{machine}}::is_done
}

function is_ready_to_finish {
    jump {{machine}}::is_ready_to_finish
}
