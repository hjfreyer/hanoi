#[flags]
function init {
    // Stack: [args]
    jump {{target}}::init
    // Stack: [state]
}


#[flags]
function accept {
    // Stack: [(state, event)]
    untuple 2
    assert
    // Stack: [event, state]
    pick 1
    push crate::prelude::start
    equal
    pick 2
    push crate::prelude::pass
    equal
    or
    pick 2
    push crate::prelude::fail
    equal
    or
    branch {
        drop 0
        drop 0
        push false
    } {
        // Stack: [event, state]
        pick 1 // duplicate event
        untuple 2
        assert
        // Stack: [event, state, payload, prefix]
        push {{to_symbol}}
        equal
        // Stack: [event, state, payload, prefix == {{to_symbol}}]
        branch {
            // Stack: [event, state, payload]
            push {{from_symbol}}
            // Stack: [event, state, payload, {{from_symbol}}]
            tuple 2
            // Stack: [event, state, ({{from_symbol}}, payload)]
            drop 2 // drops event
            // Stack: [state, ({{from_symbol}}, payload)]
            roll 1 // swap them
            // Stack: [({{from_symbol}}, payload), state]
            tuple 2
            // Stack: [(state, ({{from_symbol}}, payload))]
            jump {{target}}::accept
            // Stack: [Bool]
        } {
            // Stack: [event, state, payload]
            drop 0 // drop payload
            // Stack: [event, state]
            tuple 2
            // Stack: [(state, event)]
            jump {{target}}::accept
            // Stack: [Bool]
        }
    }
}

#[flags]
function emit {
    // Stack: [state]
    jump {{target}}::emit
    // Stack: [(has_event, event)]
    untuple 2
    assert
    // Stack: [event, has_event]
    branch {
        // Stack: [event]
        untuple 2
        assert
        // Stack: [payload, prefix]
        pick 0
        // Stack: [payload, prefix, prefix]
        push {{from_symbol}}
        // Stack: [payload, prefix, prefix, {{from_symbol}}]
        equal
        // Stack: [payload, prefix, is_from_symbol]
        branch {
            // Stack: [payload, prefix]
            drop 0
            // Stack: [payload]
            push {{to_symbol}}
            // Stack: [payload, {{to_symbol}}]
            tuple 2
            // Stack: [({{to_symbol}}, payload)]
            push true
            // Stack: [({{to_symbol}}, payload), true]
            tuple 2
            // Stack: [(true, ({{to_symbol}}, payload))]
        } {
            // Stack: [payload, prefix]
            tuple 2
            // Stack: [(prefix, payload)]
            push true
            // Stack: [(prefix, payload), true]
            tuple 2
            // Stack: [(true, (prefix, payload))]
        }
    } {
        // Stack: [event]
        drop 0
        // Stack: []
        tuple 0
        // Stack: [()]
        push false
        // Stack: [(), false]
        tuple 2
        // Stack: [(false, ())]
    }
}

#[flags]
function process {
    // Stack: [(state, event)]
    untuple 2
    assert
    // Stack: [event, state]
    roll 1
    // Stack: [state, event]
    untuple 2
    assert
    // Stack: [state, payload, prefix]
    pick 0
    // Stack: [state, payload, prefix, prefix]
    push {{to_symbol}}
    // Stack: [state, payload, prefix, prefix, {{to_symbol}}]
    equal
    // Stack: [state, payload, prefix, is_to_symbol]
    branch {
        // Stack: [state, payload, prefix]
        drop 0
        // Stack: [state, payload]
        push {{from_symbol}}
        // Stack: [state, payload, {{from_symbol}}]
        tuple 2
        // Stack: [state, ({{from_symbol}}, payload)]
        roll 1
        // Stack: [({{from_symbol}}, payload), state]
        tuple 2
        // Stack: [(state, ({{from_symbol}}, payload))]
        jump {{target}}::process
        // Stack: [next_state]
    } {
        // Stack: [state, payload, prefix]
        tuple 2
        // Stack: [state, (prefix, payload)]
        roll 1
        // Stack: [(prefix, payload), state]
        tuple 2
        // Stack: [(state, (prefix, payload))]
        jump {{target}}::process
        // Stack: [next_state]
    }
}

#[flags]
function tau_reduce {
    // Stack: [state]
    jump {{target}}::tau_reduce
    // Stack: [(did_reduce, next_state)]
}

#[flags]
function is_done {
    // Stack: [state]
    jump {{target}}::is_done
    // Stack: [Bool]
}

#[flags]
function is_ready_to_finish {
    // Stack: [state]
    jump {{target}}::is_ready_to_finish
    // Stack: [Bool]
}
