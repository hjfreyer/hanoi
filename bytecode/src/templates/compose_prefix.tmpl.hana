function init {
    // Stack: [args]
    jump {{target}}::init
    // Stack: [state]
}


function accept {
    // Stack: [(state, event)]
    untuple 2
    // Stack: [event, state]
    pick 1
    // Stack: [event, state, event]
    push universal_set
    // Stack: [event, state, event, universal_set]
    push {{prefix}}
    // Stack: [event, state, event, universal_set, {{prefix}}]
    set_singleton
    // Stack: [event, state, event, universal_set, singleton({{prefix}})]
    set_tuple 2
    // Stack: [event, state, event, set_tuple(singleton({{prefix}}), universal_set)]
    set_contains
    // Stack: [event, state, is_prefixed]
    branch {
        // Stack: [event, state]
        roll 1
        // Stack: [state, event]
        untuple 2
        // Stack: [state, payload, prefix]
        drop 0
        // Stack: [state, payload]
        roll 1
        // Stack: [payload, state]
        tuple 2
        // Stack: [(state, payload)]
        jump {{target}}::accept
        // Stack: [Bool]
    } {
        // Stack: [event, state]
        drop 0
        // Stack: [event]
        drop 0
        // Stack: []
        push false
        // Stack: [false]
    }
}

function emit {
    // Stack: [state]
    jump {{target}}::emit
    // Stack: [(has_event, event)]
    untuple 2
    // Stack: [event, has_event]
    branch {
        // Stack: [event]
        push {{prefix}}
        // Stack: [event, {{prefix}}]
        tuple 2
        // Stack: [({{prefix}}, event)]
        push true
        // Stack: [({{prefix}}, event), true]
        tuple 2
        // Stack: [(true, ({{prefix}}, event))]
    } {
        // Stack: [event]
        drop 0
        // Stack: []
        tuple 0
        // Stack: [()]
        push false
        // Stack: [(), false]
        tuple 2
        // Stack: [(false, ())]
    }
}

function process {
    // Stack: [(event, state)]
    untuple 2
    // Stack: [state, event]
    untuple 2
    // Stack: [state, payload, prefix]
    push {{prefix}}
    // Stack: [state, payload, prefix, {{prefix}}]
    assert_eq
    // Stack: [state, payload]
    tuple 2
    // Stack: [(payload, state)]
    jump {{target}}::process
    // Stack: [next_state]
}

function tau_reduce {
    // Stack: [state]
    push false
    // Stack: [state, false]
    tuple 2
    // Stack: [(false, state)]
}

function is_done {
    // Stack: [state]
    jump {{target}}::is_done
    // Stack: [Bool]
}

function is_ready_to_finish {
    // Stack: [state]
    jump {{target}}::is_ready_to_finish
    // Stack: [Bool]
}
