function init {
    jump {{target}}::init
}

function accept {
    jump {{target}}::accept
    push {{prefix}}
    set_singleton
    set_tuple 2
}

function emit {
    jump {{target}}::emit
    untuple 2
    branch {
        push {{prefix}}
        tuple 2
        push true
        tuple 2
    } {
        drop 0
        tuple 0
        push false
        tuple 2
    }
}

#[arity(2, 1)]
sentence process {
    untuple 2
    push {{prefix}}
    assert_eq
    jump {{target}}::process
}

function tau_reduce {
    push false
    tuple 2
}

function is_done {
    jump {{target}}::is_done
}

function is_ready_to_finish {
    jump {{target}}::is_ready_to_finish
}
