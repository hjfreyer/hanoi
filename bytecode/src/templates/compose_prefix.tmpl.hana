function init {
    jump {{target}}::init
}

function accept_inner {
    jump {{target}}::accept_inner
    push {{prefix}}
    set_singleton
    set_tuple 2
}

function accept {
    untuple 2
    pick 1
    untuple 2
    push {{prefix}}
    equal
    branch {
        drop 2
        roll 1
        tuple 2
        jump {{target}}::accept
    } {
        drop 0
        drop 0
        drop 0
        push false
    }
}

function emit {
    jump {{target}}::emit
    untuple 2
    branch {
        push {{prefix}}
        tuple 2
        push true
        tuple 2
    } {
        drop 0
        tuple 0
        push false
        tuple 2
    }
}

function process {
    untuple 2
    untuple 2
    push {{prefix}}
    assert_eq
    tuple 2
    jump {{target}}::process
}

function tau_reduce {
    push false
    tuple 2
}

function is_done {
    jump {{target}}::is_done
}

function is_ready_to_finish {
    jump {{target}}::is_ready_to_finish
}
