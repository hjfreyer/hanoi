// The laws `bin/rewrite` rewrites by, checked against the interpreter.
//
// Each equation there claims two programs behave identically. The rewriter
// takes that on faith — it is an axiom — so the claims are worth stating
// somewhere that runs them. A law that turned out to be false would show up
// here rather than as a silently wrong derivation.

symbol some_sym

// `pick 0 ; is_bool ; branch { branch { push true } { push false } } { }` = ε.
//
// A boolean is either true or false: ask whether the value is one, and if it
// is, branch on it and push back the literal that branching just told you it
// was. The guard is what makes it unconditional — on anything that is not a
// boolean the block does nothing at all.
#[total]
function split_bool {
    pick 0
    is_bool
    branch {
        branch { push true } { push false }
    } { }
}

test sentence split_bool_is_the_identity {
    push true     jump split_bool   push true     assert_eq
    push false    jump split_bool   push false    assert_eq
    push 42       jump split_bool   push 42       assert_eq
    push 0        jump split_bool   push 0        assert_eq
    push 3.5      jump split_bool   push 3.5      assert_eq
    push some_sym jump split_bool   push some_sym assert_eq
    push ()       jump split_bool   push ()       assert_eq
    push (1, 2)   jump split_bool   push (1, 2)   assert_eq
}

// `roll 1 ; op` = `op`, for the commutative operators.
//
// `vm` measures the commutative set exhaustively over every pair of value
// shapes; this checks the shape of the law the rewriter actually applies.
test sentence commuting_operands_changes_nothing {
    push 3 push 4 roll 1 add   assert   push 7    assert_eq
    push 3 push 4 add          assert   push 7    assert_eq

    push 3 push 4 roll 1 mul   assert   push 12   assert_eq
    push true push false roll 1 and     push false assert_eq
    push true push false roll 1 or      push true  assert_eq
    push 3 push some_sym roll 1 equal   push false assert_eq
}

// `X` = `drop^n` where `X : n -> 0` — the annihilation with nothing to read.
//
// A computation that leaves nothing is exactly the discarding of what it
// consumed. `branch { } { }` is the case that wanted it: two empty arms take
// the condition and do nothing else.
test sentence a_computation_that_leaves_nothing_is_a_drop {
    push 9  push true  branch { } { }
    push 9 assert_eq

    push 9  push false branch { } { }
    push 9 assert_eq

    push 9  push true  drop 0
    push 9 assert_eq

    // Arms that consume as well: (2 -> 0), so it is two drops.
    push 9  push 1 push true  branch { drop 0 } { drop 0 }
    push 9 assert_eq

    push 9  push 1 push true  drop 0 drop 0
    push 9 assert_eq
}

// `pick 0 ; branch { branch { A } { B } ; R } { Q }`
//   = `pick 0 ; branch { drop ; A ; R } { Q }`, and the mirror of it.
//
// The same value tested twice answers the same, so the arm the outer branch
// took already decides the inner one. Read at the then arm the value is
// truthy; at the else arm it is `false`, which is the only falsy value.
#[total] #[arity(1,1)] function retest_then_lhs {
    pick 0 branch { branch { push 1 } { push 2 } } { drop 0 push 9 } }
#[total] #[arity(1,1)] function retest_then_rhs {
    pick 0 branch { drop 0 push 1 } { drop 0 push 9 } }
#[total] #[arity(1,1)] function retest_else_lhs {
    pick 0 branch { drop 0 push 9 } { branch { push 3 } { push 4 } } }
#[total] #[arity(1,1)] function retest_else_rhs {
    pick 0 branch { drop 0 push 9 } { drop 0 push 4 } }
#[total] #[arity(1,1)] function retest_both_lhs {
    pick 0 branch { branch { push 1 } { push 2 } } { branch { push 3 } { push 4 } } }
#[total] #[arity(1,1)] function retest_both_rhs { branch { push 1 } { push 4 } }

test sentence a_value_tested_twice_answers_the_same {
    push true  jump retest_then_lhs push 1 assert_eq
    push true  jump retest_then_rhs push 1 assert_eq
    push false jump retest_then_lhs push 9 assert_eq
    push false jump retest_then_rhs push 9 assert_eq
    push 42    jump retest_then_lhs push 1 assert_eq
    push 42    jump retest_then_rhs push 1 assert_eq

    push true  jump retest_else_lhs push 9 assert_eq
    push true  jump retest_else_rhs push 9 assert_eq
    push false jump retest_else_lhs push 4 assert_eq
    push false jump retest_else_rhs push 4 assert_eq
    push 42    jump retest_else_lhs push 9 assert_eq
    push 42    jump retest_else_rhs push 9 assert_eq

    // Both arms, which is where the whole thing collapses to the diagonal.
    push true  jump retest_both_lhs push 1 assert_eq
    push true  jump retest_both_rhs push 1 assert_eq
    push false jump retest_both_lhs push 4 assert_eq
    push false jump retest_both_rhs push 4 assert_eq
    push 42    jump retest_both_lhs push 1 assert_eq
    push 42    jump retest_both_rhs push 1 assert_eq
}

// `pick 0 ; dip 1 { drop }` = nothing — the other counit.
//
// Copy a value and discard the *original*. `pick d ; drop` discards the copy
// instead; the two are the two counit laws of the comonoid `pick` builds, and
// only one of them was here. Deeper it is not the identity at all: `pick 1 ;
// dip 2 { drop }` moves the value, which is a `roll`.
test sentence copying_and_discarding_the_original_is_nothing {
    push 7 push 8  pick 0 dip 1 { drop 0 }
    push 8 assert_eq   push 7 assert_eq

    push 7 push 8
    push 8 assert_eq   push 7 assert_eq
}

// `op ; is_bool` = `op ; drop ; push true`, for an op that yields a boolean.
//
// The one fact here that no rewriting can reach: a codomain is not something a
// case split discovers. `vm` measures which instructions qualify; this checks
// the shape of the law the rewriter applies, on a predicate and on a flag.
test sentence a_test_on_something_already_boolean_is_decided {
    push true     is_bool is_bool  push true assert_eq
    push false    is_bool is_bool  push true assert_eq
    push 42       is_bool is_bool  push true assert_eq
    push 3.5      is_bool is_bool  push true assert_eq
    push some_sym is_bool is_bool  push true assert_eq
    push (1, 2)   is_bool is_bool  push true assert_eq

    // The right-hand side, once `annihilate` has taken the operator away.
    push 42       drop 0 push true  push true assert_eq

    // A flag is a boolean, so it folds where the operator cannot be deleted.
    push 3 push 4 add is_bool       push true assert_eq  push 7 assert_eq
    push 3 push 4 add drop 0 push true
                                    push true assert_eq  push 7 assert_eq

    // And one that fails, where the flag says so and is still a boolean.
    push some_sym push 4 add is_bool
                                    push true assert_eq  drop 0
}

// `op ; pick 0 ; is_bool` = `op ; push true`, for an op that yields a boolean.
//
// The same fact as the law above, read through a **copy** — and the copy is
// what makes it a claim worth stating separately. `split_bool` is the only law
// that can put a branch on an unknown condition into a term, and it pays for
// being unconditional by asking `is_bool` in the term; the value has to survive
// for the branch that follows, so what it asks is `pick 0 ; is_bool`, which
// `bool_result` cannot read. The two laws built to compose could not meet.
//
// It is a lemma and the proof says so: un-share the copy into a second run of
// the operator, which puts an `op` next to the `is_bool`, fold that, and let
// the annihilation and the counits take the second run away again.
test sentence asking_whether_a_copy_of_a_test_is_a_test {
    push 3 push 4 equal pick 0 is_bool
    push true assert_eq   push false assert_eq

    push 3 push 4 equal push true
    push true assert_eq   push false assert_eq

    push 5 push 5 equal pick 0 is_bool
    push true assert_eq   push true assert_eq

    push 5 push 5 equal push true
    push true assert_eq   push true assert_eq
}

// `dip d { X } ; (roll (d+m-1))^m` = `(roll (d+n-1))^n ; X`, for `X : n -> m`.
//
// A framed computation is a rolled one. Both sides apply `X` to the `n` values
// under the top `d` and leave its `m` results on top of those `d` — the left by
// reaching under them with a frame, the right by rolling the operands up,
// computing at the top, and leaving the answers there.
//
// It is what brings a value to where the folding laws can see it: every law
// about what a value *is* is stated about the top of the stack, and a branch
// inside a frame cannot show its cases to the code outside one.
test sentence a_framed_computation_is_a_rolled_one {
    // d = 1, X = not : 1 -> 1, so one roll either side.
    push 9 push true  dip 1 { not }
    push true assert_eq   push false assert_eq

    push 9 push true  roll 1 not roll 1
    push true assert_eq   push false assert_eq

    // d = 2, X = add : 2 -> 2 — the rolls are all at one depth because a
    // rotation does not change how many values there are.
    push 1 push 2 push 8 push 9  dip 2 { add } roll 3 roll 3
    assert  push 3 assert_eq  push 9 assert_eq  push 8 assert_eq

    push 1 push 2 push 8 push 9  roll 3 roll 3 add
    assert  push 3 assert_eq  push 9 assert_eq  push 8 assert_eq
}

// `push v1 … push vn ; op` = the pushes of what `op` answers — for `tuple` and
// `untuple`, which `eval` did not know.
//
// What `eval` owes is not a licence but an obligation: to agree with the
// interpreter exactly, on junk as much as on anything else. So the element
// order is measured here rather than reasoned about — `tuple n` takes the top
// `n` and the *topmost* becomes the first element — and so is what `untuple`
// hands back when the width does not match: the value in the deepest slot it
// filled, `()` in the rest, and `false` on top.
test sentence building_and_taking_apart_literals {
    push 1 push 2 tuple 2       push (2, 1) assert_eq
    push some_sym push 1 tuple 2
                                push (1, some_sym) assert_eq

    push (2, 1) untuple 2       assert   push 2 assert_eq   push 1 assert_eq
    push 2 untuple 2            not assert   push () assert_eq   push 2 assert_eq

    // `tuple 0` is the one an operator with no operands at all answers.
    tuple 0                     push () assert_eq

    // At `n = 0` there is no room for the value: the flag is the whole answer.
    push 7 untuple 0            not assert
}

// `X ; drop^m` = `drop^n`, and `pick d ; drop` = nothing.
test sentence discarded_work_is_no_work {
    push 9
    push 3 push 4 add drop 0 drop 0
    push 9 assert_eq

    push 9
    pick 0 drop 0
    push 9 assert_eq
}

// `tuple n ; untuple n` = `push true`.
test sentence building_and_taking_apart_leaves_the_flag {
    push 1 push 2
    tuple 2 untuple 2
    assert
    push 2 assert_eq
    push 1 assert_eq
}

// `pick (n-1)^n ; X ; dip m { X }` = `X ; pick (m-1)^m`, for `X : n -> m`.
//
// Copying is natural: copy the inputs and run X on both the copy and the
// original, or run it once and copy the outputs. The one law here that needs X
// to be *deterministic* — every other equation is sound even for an X that
// answered differently each time — so it is the one most worth running.
#[total]
function classify { pick 0 is_int branch { drop 0 push 7 } { drop 0 push 8 } }

test sentence copying_inputs_is_copying_outputs {
    // X = equal : 2 -> 1
    push 3 push 4  pick 1 pick 1 equal dip 1 { equal }
    push false assert_eq   push false assert_eq
    push 3 push 4  equal pick 0
    push false assert_eq   push false assert_eq

    push 5 push 5  pick 1 pick 1 equal dip 1 { equal }
    push true assert_eq    push true assert_eq
    push 5 push 5  equal pick 0
    push true assert_eq    push true assert_eq

    // X = add : 2 -> 2, where the flag is copied too
    push 3 push 4  pick 1 pick 1 add dip 2 { add }
    push true assert_eq  push 7 assert_eq
    push true assert_eq  push 7 assert_eq
    push 3 push 4  add pick 1 pick 1
    push true assert_eq  push 7 assert_eq
    push true assert_eq  push 7 assert_eq

    // X = a call, which is the case `share { jump ... }` is for
    push 42  pick 0 jump classify dip 1 { jump classify }
    push 7 assert_eq   push 7 assert_eq
    push 42  jump classify pick 0
    push 7 assert_eq   push 7 assert_eq

    // X = push c : 0 -> 1, the constant case that makes `copy_const` a lemma
    push 9 dip 1 { push 9 }
    push 9 assert_eq   push 9 assert_eq
    push 9 pick 0
    push 9 assert_eq   push 9 assert_eq
}

// ---------------------------------------------------------------------------
// The same laws again, stated for the rewriter rather than the interpreter.
//
// Everything above runs both sides and asserts they agree, which is a check on
// finitely many inputs. An `identity` is the claim itself, and `bin/prove`
// discharges it by deriving one side from the other — so the two readings of
// this file answer different questions: does the law hold on these values, and
// does the rewriter's own equation set reach it.
// ---------------------------------------------------------------------------

// `op ; is_bool` = `op ; drop ; push true`, then the annihilation takes the
// operator away. Two steps, and neither is `is_bool`-specific.
identity testing_a_test { is_bool is_bool } = { drop 0 push true };

// The four-arm collapse. `retest` fires once per arm, `factor` lifts the two
// `drop`s out, and `counit_under` deletes the copy whose original went.
identity a_value_tested_twice
    { pick 0 branch { branch { push 1 } { push 2 } } { branch { push 3 } { push 4 } } }
  = { branch { push 1 } { push 4 } };

// `push c ; pick 0` = `push c ; push c` — the constant case of `copy_nat`,
// which is why `copy_const` is a lemma and not an axiom.
//
// The proof is what makes the point: it never uses the `copy_const` matcher.
// `inv(share { push 9 })` reads the naturality law backwards to put the second
// `push` inside a frame, and the movement laws take the frame away again.
identity copying_a_constant { push 9 pick 0 } = { push 9 push 9 };

// `pick (n-1)^n ; X ; drop^m` = nothing, for `X : n -> m`.
//
// Compute on copies, discard the results, and the originals were never
// touched. The law that looked essential and turned out to be derivable — read
// backwards it is the only way to introduce work into a term at all — so it is
// a lemma a generator emits as one firing, not an axiom.
//
// Note the two sides need different amounts of stack and leave the same:
// `(2 -> 2)` against `(0 -> 0)`. That asymmetry is `counit`'s, and it is why an
// identity is held to its net change rather than to its arity.
identity discarded_work_on_copies { pick 1 pick 1 equal drop 0 } = { };

// The same law as `testing_a_test`, with the right-hand side written as the
// call it is rather than pasted out in full.
//
// `cleanup` leaves `drop 0 push true` on the left and nothing folds it back up,
// because nothing can read a window and say which sentence to fold into. So the
// two sides are compared *up to inlining*: both are unfolded, and the proof is
// what the left reached meeting what the right unfolds to. That is one
// derivation still — the fold-back is the right-hand side's own unfold script,
// read backwards.
#[total]
function drop_and_true { drop 0 push true }

identity testing_a_test_by_name { is_bool is_bool } = { jump drop_and_true };

// Two spellings of one test, and neither of them is the normal form.
//
// `is_int` leaves a bool behind, so testing that bool with `is_bool` is the
// same `true` that `testing_a_test` produces. Both sides reduce to
// `drop 0 push true`; neither reduces to the other. A one-sided proof cannot
// close this at all — rewriting the left gets to the normal form and the right
// is still sitting where it was written, and unfolding reconciles nothing
// because there is nothing here to unfold.
//
// So the proof drives *both* sides and meets in the middle. The derivation is
// the left's script followed by the right's read backwards, which is why the
// listing shows `bool_result` firing forwards at the top and backwards at the
// bottom.
identity two_spellings_of_one_test { is_bool is_bool } = { is_int is_bool };

// The same claim, one level down, and proved by congruence rather than by
// reaching in with a traversal.
//
// `descend` cuts the goal into one sub-goal per child: the `then` arms become a
// goal of their own, discharged by the proof above, and the `else` arms are
// claimed to need no proof — a claim that is checked and not assumed. What each
// sub-proof produces is lifted back through the context, which is why every
// step in the listing is addressed `[0.then]`.
//
// `normalize` alone would also close this, since it would drive the whole term
// rather than the arm. Written this way it says where the difference is, and
// the derivation says it too.
identity a_test_inside_an_arm
    { branch { is_bool is_bool } { not } }
  = { branch { is_int is_bool } { not } };

// The same claim again, with something in front of it — so the goal has to be
// narrowed before it can be decomposed.
//
// `peel` strips what the two sides already share at either end and leaves a
// smaller goal, which is what makes it a *move* rather than something taking the
// rest of the proof: `peel ; descend(...)` reads left to right, and every step
// the descent finds comes back addressed past the peeled prefix. The listing
// says `[1.then]` where the last one said `[0.then]`, and that one index is the
// whole of what narrowing costs.
identity a_test_inside_an_arm_with_a_prefix
    { drop 0 branch { is_bool is_bool } { not } }
  = { drop 0 branch { is_int is_bool } { not } };

// `op ; pick 0 ; is_bool` = `op ; push true` — the guard a case split leaves.
//
// `split_bool` asks `is_bool` behind a `pick 0`, because the value it is about
// to branch on has to survive the question. `bool_result` reads `op ; is_bool`
// and a matcher's width is fixed before it looks, so the copy in the middle put
// the answer out of reach and a split placed on an operator's result stalled
// holding a question the equation set could already discharge.
//
// Eight steps, no new law: `inv(share { equal })` turns the copy into a second
// run of `equal`, which is what puts an `equal` in front of the `is_bool`;
// `bool_result` folds that; and the run left over is exactly what the
// annihilation and two counits the copies paid for take away again.
identity the_guard_a_split_leaves { equal pick 0 is_bool } = { equal push true };

// `dip d { X }` = `(roll (d+n-1))^n ; X ; (roll (d+m-1))^d` — a frame taken off.
//
// The equation has rolls on both sides and the term holds none, so the firing
// puts them in first: `roll_cycle` backwards is the only way to introduce a
// roll at all, and it introduces a whole cycle, of which the unframing eats
// `m` and leaves `d`.
//
// Two steps, and what they buy is the operand at the **top of the stack**,
// where `split_bool` and the folding laws are stated. `docs/tactics.md` gave
// the reason there was no matcher as "`unframe` can only fix one of `n` and `m`
// before it looks" — true of one reading the rolls, whose count is `m`. Reading
// the frame, `d` is on the node and `n` and `m` are its body's arity, so the
// window is one node and all three are known.
identity taking_a_frame_off { dip 1 { not } } = { roll 1 not roll 1 };

// `push a ; push b ; tuple 2 ; … ; equal` decided, which needs `eval` to know
// how to build a tuple and how to take one apart.
//
// It did not. Every value law is stated about literals, and a constructed tuple
// was not one — so a postcondition comparing what a function just built against
// what it should have built stalled with both operands right there. Widening
// `eval_op` is not a new law: `Rule::Eval` already says "the pushes of what the
// operator answers", and `tuple` is an operator that answers.
identity comparing_two_built_tuples
    { push some_sym push 1 tuple 2 push some_sym push 1 tuple 2 equal }
  = { push true };
