// The laws an equational account of the ISA rewrites by, checked against the
// interpreter.
//
// Each equation claims two programs behave identically. Anything rewriting by
// one takes that on faith — it is an axiom — so the claims are worth stating
// somewhere that runs them. A law that turned out to be false shows up here
// rather than as a silently wrong proof.

symbol some_sym

// `pick 0 ; is_bool ; branch { branch { push true } { push false } } { }` = ε.
//
// A boolean is either true or false: ask whether the value is one, and if it
// is, branch on it and push back the literal that branching just told you it
// was. The guard is what makes it unconditional — on anything that is not a
// boolean the block does nothing at all.
function split_bool {
    pick 0
    is_bool
    branch {
        branch { push true } { push false }
    } { }
}

test sentence split_bool_is_the_identity {
    push true     jump split_bool   push true     jump crate::prelude::check_equals ? drop 0
    push false    jump split_bool   push false    jump crate::prelude::check_equals ? drop 0
    push 42       jump split_bool   push 42       jump crate::prelude::check_equals ? drop 0
    push 0        jump split_bool   push 0        jump crate::prelude::check_equals ? drop 0
    push "hi"     jump split_bool   push "hi"     jump crate::prelude::check_equals ? drop 0
    push some_sym jump split_bool   push some_sym jump crate::prelude::check_equals ? drop 0
    push ()       jump split_bool   push ()       jump crate::prelude::check_equals ? drop 0
    push (2, 1)   jump split_bool   push (2, 1)   jump crate::prelude::check_equals
}

// `roll 1 ; op` = `op`, for the commutative operators.
//
// `vm` measures the commutative set exhaustively over every pair of value
// shapes; this checks the shape the law is actually applied in.
test sentence commuting_operands_changes_nothing {
    push 3 push 4 roll 1 add            push 7  jump crate::prelude::check_equals ? drop 0
    push 3 push 4 add                   push 7  jump crate::prelude::check_equals ? drop 0

    push 3 push 4 roll 1 mul            push 12 jump crate::prelude::check_equals ? drop 0
    push true push false roll 1 and     push false jump crate::prelude::check_equals ? drop 0
    push true push false roll 1 or      push true  jump crate::prelude::check_equals ? drop 0
    push 3 push some_sym roll 1 equal   push false jump crate::prelude::check_equals
}

// `X` = `drop^n` where `X : n -> 0` — the annihilation with nothing to read.
//
// A computation that leaves nothing is exactly the discarding of what it
// consumed. `branch { } { }` is the case that wanted it: two empty arms take
// the condition and do nothing else.
test sentence a_computation_that_leaves_nothing_is_a_drop {
    push 9  push true  branch { } { }
    push 9 jump crate::prelude::check_equals ? drop 0

    push 9  push false branch { } { }
    push 9 jump crate::prelude::check_equals ? drop 0

    push 9  push true  drop 0
    push 9 jump crate::prelude::check_equals ? drop 0

    // Arms that consume as well: (2 -> 0), so it is two drops.
    push 9  push 1 push true  branch { drop 0 } { drop 0 }
    push 9 jump crate::prelude::check_equals ? drop 0

    push 9  push 1 push true  drop 0 drop 0
    push 9 jump crate::prelude::check_equals
}

// `pick 0 ; branch { branch { A } { B } ; R } { Q }`
//   = `pick 0 ; branch { drop ; A ; R } { Q }`, and the mirror of it.
//
// The same value tested twice answers the same, so the arm the outer branch
// took already decides the inner one. Read at the then arm the value is
// truthy; at the else arm it is `false`, which is the only falsy value.
#[arity(1,1)] function retest_then_lhs {
    pick 0 branch { branch { push 1 } { push 2 } } { drop 0 push 9 } }
#[arity(1,1)] function retest_then_rhs {
    pick 0 branch { drop 0 push 1 } { drop 0 push 9 } }
#[arity(1,1)] function retest_else_lhs {
    pick 0 branch { drop 0 push 9 } { branch { push 3 } { push 4 } } }
#[arity(1,1)] function retest_else_rhs {
    pick 0 branch { drop 0 push 9 } { drop 0 push 4 } }
#[arity(1,1)] function retest_both_lhs {
    pick 0 branch { branch { push 1 } { push 2 } } { branch { push 3 } { push 4 } } }
#[arity(1,1)] function retest_both_rhs { branch { push 1 } { push 4 } }

test sentence a_value_tested_twice_answers_the_same {
    push true  jump retest_then_lhs push 1 jump crate::prelude::check_equals ? drop 0
    push true  jump retest_then_rhs push 1 jump crate::prelude::check_equals ? drop 0
    push false jump retest_then_lhs push 9 jump crate::prelude::check_equals ? drop 0
    push false jump retest_then_rhs push 9 jump crate::prelude::check_equals ? drop 0
    push 42    jump retest_then_lhs push 1 jump crate::prelude::check_equals ? drop 0
    push 42    jump retest_then_rhs push 1 jump crate::prelude::check_equals ? drop 0

    push true  jump retest_else_lhs push 9 jump crate::prelude::check_equals ? drop 0
    push true  jump retest_else_rhs push 9 jump crate::prelude::check_equals ? drop 0
    push false jump retest_else_lhs push 4 jump crate::prelude::check_equals ? drop 0
    push false jump retest_else_rhs push 4 jump crate::prelude::check_equals ? drop 0
    push 42    jump retest_else_lhs push 9 jump crate::prelude::check_equals ? drop 0
    push 42    jump retest_else_rhs push 9 jump crate::prelude::check_equals ? drop 0

    // Both arms, which is where the whole thing collapses to the diagonal.
    push true  jump retest_both_lhs push 1 jump crate::prelude::check_equals ? drop 0
    push true  jump retest_both_rhs push 1 jump crate::prelude::check_equals ? drop 0
    push false jump retest_both_lhs push 4 jump crate::prelude::check_equals ? drop 0
    push false jump retest_both_rhs push 4 jump crate::prelude::check_equals ? drop 0
    push 42    jump retest_both_lhs push 1 jump crate::prelude::check_equals ? drop 0
    push 42    jump retest_both_rhs push 1 jump crate::prelude::check_equals
}

// `pick 0 ; dip 1 { drop }` = nothing — the other counit.
//
// Copy a value and discard the *original*. `pick d ; drop` discards the copy
// instead; the two are the two counit laws of the comonoid `pick` builds, and
// only one of them was here. Deeper it is not the identity at all: `pick 1 ;
// dip 2 { drop }` moves the value, which is a `roll`.
test sentence copying_and_discarding_the_original_is_nothing {
    push 7 push 8  pick 0 dip 1 { drop 0 }
    push 8 jump crate::prelude::check_equals ? drop 0
    push 7 jump crate::prelude::check_equals ? drop 0

    push 7 push 8
    push 8 jump crate::prelude::check_equals ? drop 0
    push 7 jump crate::prelude::check_equals
}

// `op ; is_bool` = `op ; drop ; push true`, for an op that yields a boolean.
//
// The one fact here that no rewriting can reach: a codomain is not something a
// case split discovers. `vm` measures which instructions qualify; this checks
// the shape the law is applied in, on a predicate and on a comparison.
test sentence a_test_on_something_already_boolean_is_decided {
    push true     is_bool is_bool  push true jump crate::prelude::check_equals ? drop 0
    push false    is_bool is_bool  push true jump crate::prelude::check_equals ? drop 0
    push 42       is_bool is_bool  push true jump crate::prelude::check_equals ? drop 0
    push "hi"     is_bool is_bool  push true jump crate::prelude::check_equals ? drop 0
    push some_sym is_bool is_bool  push true jump crate::prelude::check_equals ? drop 0
    push (2, 1)   is_bool is_bool  push true jump crate::prelude::check_equals ? drop 0

    // The right-hand side, once `annihilate` has taken the operator away.
    push 42       drop 0 push true  push true jump crate::prelude::check_equals ? drop 0

    // A comparison is a boolean, so it folds where the operator cannot be
    // deleted: `less` answers about its operands rather than leaving them.
    push 3 push 4 less is_bool      push true jump crate::prelude::check_equals ? drop 0
    push 3 push 4 less drop 0 push true
                                    push true jump crate::prelude::check_equals ? drop 0

    // And one with no ordering to report, whose `false` is a boolean too.
    push some_sym push 4 less is_bool
                                    push true jump crate::prelude::check_equals ? drop 0
    push ((), crate::prelude::ok)
}

// `op ; pick 0 ; is_bool` = `op ; push true`, for an op that yields a boolean.
//
// The same fact as the law above, read through a **copy** — and the copy is
// what makes it a claim worth stating separately. `split_bool` is the only law
// that can put a branch on an unknown condition into a term, and it pays for
// being unconditional by asking `is_bool` in the term; the value has to survive
// for the branch that follows, so what it asks is `pick 0 ; is_bool`, which
// `bool_result` cannot read. The two laws built to compose could not meet.
//
// It is a lemma and the proof says so: un-share the copy into a second run of
// the operator, which puts an `op` next to the `is_bool`, fold that, and let
// the annihilation and the counits take the second run away again.
test sentence asking_whether_a_copy_of_a_test_is_a_test {
    push 3 push 4 equal pick 0 is_bool
    push true jump crate::prelude::check_equals ? drop 0
    push false jump crate::prelude::check_equals ? drop 0

    push 3 push 4 equal push true
    push true jump crate::prelude::check_equals ? drop 0
    push false jump crate::prelude::check_equals ? drop 0

    push 5 push 5 equal pick 0 is_bool
    push true jump crate::prelude::check_equals ? drop 0
    push true jump crate::prelude::check_equals ? drop 0

    push 5 push 5 equal push true
    push true jump crate::prelude::check_equals ? drop 0
    push true jump crate::prelude::check_equals
}

// `dip d { X } ; (roll (d+m-1))^m` = `(roll (d+n-1))^n ; X`, for `X : n -> m`.
//
// A framed computation is a rolled one. Both sides apply `X` to the `n` values
// under the top `d` and leave its `m` results on top of those `d` — the left by
// reaching under them with a frame, the right by rolling the operands up,
// computing at the top, and leaving the answers there.
//
// It is what brings a value to where the folding laws can see it: every law
// about what a value *is* is stated about the top of the stack, and a branch
// inside a frame cannot show its cases to the code outside one.
test sentence a_framed_computation_is_a_rolled_one {
    // d = 1, X = not : 1 -> 1, so one roll either side.
    push 9 push true  dip 1 { not }
    push true jump crate::prelude::check_equals ? drop 0
    push false jump crate::prelude::check_equals ? drop 0

    push 9 push true  roll 1 not roll 1
    push true jump crate::prelude::check_equals ? drop 0
    push false jump crate::prelude::check_equals ? drop 0

    // d = 2, X = add : 2 -> 1 — one roll on the left for the single result,
    // two on the right for the two operands it reads.
    push 1 push 2 push 8 push 9  dip 2 { add } roll 2
    push 3 jump crate::prelude::check_equals ? drop 0
    push 9 jump crate::prelude::check_equals ? drop 0
    push 8 jump crate::prelude::check_equals ? drop 0

    push 1 push 2 push 8 push 9  roll 3 roll 3 add
    push 3 jump crate::prelude::check_equals ? drop 0
    push 9 jump crate::prelude::check_equals ? drop 0
    push 8 jump crate::prelude::check_equals
}

// `push v1 … push vn ; op` = the pushes of what `op` answers — for `tuple` and
// `untuple`, which `eval` did not know.
//
// What `eval` owes is not a licence but an obligation: to agree with the
// interpreter exactly, on junk as much as on anything else. So the element
// order is measured here rather than reasoned about — `tuple n` takes the top
// `n` in the order they sit on the stack, so the *topmost* becomes the last
// element — and so is what `untuple` hands back when the width does not match:
// `()` in every slot it filled.
test sentence building_and_taking_apart_literals {
    push 1 push 2 tuple 2       push (1, 2) jump crate::prelude::check_equals ? drop 0
    push some_sym push 1 tuple 2
                                push (some_sym, 1) jump crate::prelude::check_equals ? drop 0

    push (1, 2) untuple 2       push 2 jump crate::prelude::check_equals ? drop 0
                                push 1 jump crate::prelude::check_equals ? drop 0

    // A value that is not a pair has no two parts to give.
    push 2 untuple 2            push () jump crate::prelude::check_equals ? drop 0
                                push () jump crate::prelude::check_equals ? drop 0

    // `tuple 0` is the one an operator with no operands at all answers.
    tuple 0                     push () jump crate::prelude::check_equals ? drop 0

    // At `n = 0` there are no slots to fill, so `untuple 0` is a drop.
    push 7 untuple 0
    push ((), crate::prelude::ok)
}

// `pick 0 ; push c ; equal ; branch { A } { B }`
//   = `pick 0 ; push c ; equal ; branch { drop ; push c ; A } { B }`.
//
// A value that tested equal to a literal *is* that literal. The condition is a
// copy, so the arm still holds the value the `equal` looked at, and in the then
// arm the two are names for one thing.
//
// `equal` is structural identity on every value the machine has, so the law
// holds unconditionally — floats, where `0.0 == -0.0` answers `true` on two
// values that stay distinguishable, were the one exception and are gone.
#[arity(1,1)] function specialize_lhs {
    pick 0 push 7 equal branch { push 7 equal } { drop 0 push false } }
#[arity(1,1)] function specialize_rhs {
    pick 0 push 7 equal branch { drop 0 push 7 push 7 equal } { drop 0 push false } }

test sentence a_value_equal_to_a_literal_is_that_literal {
    push 7        jump specialize_lhs   push true  jump crate::prelude::check_equals ? drop 0
    push 7        jump specialize_rhs   push true  jump crate::prelude::check_equals ? drop 0
    push 8        jump specialize_lhs   push false jump crate::prelude::check_equals ? drop 0
    push 8        jump specialize_rhs   push false jump crate::prelude::check_equals ? drop 0
    push some_sym jump specialize_lhs   push false jump crate::prelude::check_equals ? drop 0
    push some_sym jump specialize_rhs   push false jump crate::prelude::check_equals ? drop 0

    // A tuple too: `equal` reads the whole value, so the law reads it whole.
    push (2, 1)   jump specialize_lhs   push false jump crate::prelude::check_equals ? drop 0
    push (2, 1)   jump specialize_rhs   push false jump crate::prelude::check_equals
}

// `X ; drop^m` = `drop^n`, and `pick d ; drop` = nothing.
test sentence discarded_work_is_no_work {
    push 9
    push 3 push 4 add drop 0
    push 9 jump crate::prelude::check_equals ? drop 0

    push 9
    pick 0 drop 0
    push 9 jump crate::prelude::check_equals
}

// `tuple n ; untuple n` = nothing.
//
// The one direction that holds: `untuple n ; tuple n` is not the identity, it
// junk-normalizes, mapping every value that is not an `n`-tuple to `((), …)`.
test sentence building_and_taking_apart_is_the_identity {
    push 1 push 2
    tuple 2 untuple 2
    push 2 jump crate::prelude::check_equals ? drop 0
    push 1 jump crate::prelude::check_equals
}

// `untuple n ; tuple n` = `as_tuple n`, run rather than claimed.
test sentence taking_apart_and_rebuilding_is_the_coercion {
    push (1, 2)   untuple 2 tuple 2   push (1, 2)   jump crate::prelude::check_equals ? drop 0
    push (1, 2)   as_tuple 2          push (1, 2)   jump crate::prelude::check_equals ? drop 0

    push some_sym untuple 2 tuple 2   push ((), ()) jump crate::prelude::check_equals ? drop 0
    push some_sym as_tuple 2          push ((), ()) jump crate::prelude::check_equals
}

// `pick (n-1)^n ; X ; dip m { X }` = `X ; pick (m-1)^m`, for `X : n -> m`.
//
// Copying is natural: copy the inputs and run X on both the copy and the
// original, or run it once and copy the outputs. The one law here that needs X
// to be *deterministic* — every other equation is sound even for an X that
// answered differently each time — so it is the one most worth running.
function classify { pick 0 is_int branch { drop 0 push 7 } { drop 0 push 8 } }

test sentence copying_inputs_is_copying_outputs {
    // X = equal : 2 -> 1
    push 3 push 4  pick 1 pick 1 equal dip 1 { equal }
    push false jump crate::prelude::check_equals ? drop 0
    push false jump crate::prelude::check_equals ? drop 0
    push 3 push 4  equal pick 0
    push false jump crate::prelude::check_equals ? drop 0
    push false jump crate::prelude::check_equals ? drop 0

    push 5 push 5  pick 1 pick 1 equal dip 1 { equal }
    push true jump crate::prelude::check_equals ? drop 0
    push true jump crate::prelude::check_equals ? drop 0
    push 5 push 5  equal pick 0
    push true jump crate::prelude::check_equals ? drop 0
    push true jump crate::prelude::check_equals ? drop 0

    // X = add : 2 -> 1
    push 3 push 4  pick 1 pick 1 add dip 1 { add }
    push 7 jump crate::prelude::check_equals ? drop 0
    push 7 jump crate::prelude::check_equals ? drop 0
    push 3 push 4  add pick 0
    push 7 jump crate::prelude::check_equals ? drop 0
    push 7 jump crate::prelude::check_equals ? drop 0

    // X = a call, which is the case `share { jump ... }` is for
    push 42  pick 0 jump classify dip 1 { jump classify }
    push 7 jump crate::prelude::check_equals ? drop 0
    push 7 jump crate::prelude::check_equals ? drop 0
    push 42  jump classify pick 0
    push 7 jump crate::prelude::check_equals ? drop 0
    push 7 jump crate::prelude::check_equals ? drop 0

    // X = push c : 0 -> 1, the constant case that makes `copy_const` a lemma
    push 9 dip 1 { push 9 }
    push 9 jump crate::prelude::check_equals ? drop 0
    push 9 jump crate::prelude::check_equals ? drop 0
    push 9 pick 0
    push 9 jump crate::prelude::check_equals ? drop 0
    push 9 jump crate::prelude::check_equals
}

// ---------------------------------------------------------------------------
// The same laws again, stated as claims rather than run against the
// interpreter.
//
// Everything above runs both sides and asserts they agree, which is a check on
// finitely many inputs. An `identity` is the claim itself, over every input,
// and the two readings of this file answer different questions: does the law
// hold on these values, and does it hold at all.
//
// Nothing discharges the claims today — the equational rewriter that did has
// been removed pending a reboot. They are kept because the claims are what a
// replacement has to be measured against, and because the compiler still holds
// each one to having two sides that leave the stack the same way.
// ---------------------------------------------------------------------------

// `op ; is_bool` = `op ; drop ; push true`, then the annihilation takes the
// operator away. Two steps, and neither is `is_bool`-specific.
identity testing_a_test { is_bool is_bool } = { drop 0 push true };

// The four-arm collapse: each arm's inner test is decided by the outer one, the
// two `drop`s lift out, and the copy whose original went is deleted.
identity a_value_tested_twice
    { pick 0 branch { branch { push 1 } { push 2 } } { branch { push 3 } { push 4 } } }
  = { branch { push 1 } { push 4 } };

// `push c ; pick 0` = `push c ; push c` — the constant case of copy naturality,
// which is why copying a constant is a lemma and not an axiom: reading
// naturality backwards puts the second `push` inside a frame, and the movement
// laws take the frame away again.
identity copying_a_constant { push 9 pick 0 } = { push 9 push 9 };

// `pick (n-1)^n ; X ; drop^m` = nothing, for `X : n -> m`.
//
// Compute on copies, discard the results, and the originals were never
// touched. The law that looked essential and turned out to be derivable — read
// backwards it is the only way to introduce work into a term at all — so it is
// a lemma a generator emits as one firing, not an axiom.
//
// Note the two sides need different amounts of stack and leave the same:
// `(2 -> 2)` against `(0 -> 0)`. That asymmetry is the counit's, and it is why
// an identity is held to its net change rather than to its arity.
identity discarded_work_on_copies { pick 1 pick 1 equal drop 0 } = { };

// The same law as `testing_a_test`, with the right-hand side written as the
// call it is rather than pasted out in full.
//
// Reducing the left leaves `drop 0 push true` and nothing folds it back up,
// because nothing can read a window and say which sentence to fold into. So the
// two sides have to be compared *up to inlining*: unfold both, and the claim is
// what the left reaches meeting what the right unfolds to.
function drop_and_true { drop 0 push true }

identity testing_a_test_by_name { is_bool is_bool } = { jump drop_and_true };

// Two spellings of one test, and neither of them is the normal form.
//
// `is_int` leaves a bool behind, so testing that bool with `is_bool` is the
// same `true` that `testing_a_test` produces. Both sides reduce to
// `drop 0 push true`; neither reduces to the other. A one-sided proof cannot
// close this at all — rewriting the left gets to the normal form and the right
// is still sitting where it was written, and unfolding reconciles nothing
// because there is nothing here to unfold. Closing it means driving *both*
// sides and meeting in the middle.
identity two_spellings_of_one_test { is_bool is_bool } = { is_int is_bool };

// The same claim, one level down, and proved by congruence rather than by
// reaching in with a traversal.
//
// The claim cuts into one sub-claim per child: the `then` arms are the claim
// above, and the `else` arms are identical and need nothing. What each
// sub-proof produces lifts back through the context. Driving the whole term
// would close it too; stated this way it says where the difference is.
identity a_test_inside_an_arm
    { branch { is_bool is_bool } { not } }
  = { branch { is_int is_bool } { not } };

// The same claim again, with something in front of it — so the goal has to be
// narrowed before it can be decomposed.
//
// Stripping what the two sides already share at either end leaves the smaller
// claim above, and every step found inside it comes back addressed past the
// stripped prefix. That one index is the whole of what narrowing costs.
identity a_test_inside_an_arm_with_a_prefix
    { drop 0 branch { is_bool is_bool } { not } }
  = { drop 0 branch { is_int is_bool } { not } };

// `op ; pick 0 ; is_bool` = `op ; push true` — the guard a case split leaves.
//
// `split_bool` asks `is_bool` behind a `pick 0`, because the value it is about
// to branch on has to survive the question. The `op ; is_bool` law reads a
// window of fixed width, so the copy in the middle puts the answer out of
// reach: a split placed on an operator's result stalls holding a question the
// equation set can already discharge.
//
// No new law is needed. Reading copy naturality backwards turns the copy into a
// second run of `equal`, which is what puts an `equal` in front of the
// `is_bool`; folding that leaves a run the annihilation and two counits the
// copies paid for take away again.
identity the_guard_a_split_leaves { equal pick 0 is_bool } = { equal push true };

// `dip d { X }` = `(roll (d+n-1))^n ; X ; (roll (d+m-1))^d` — a frame taken off.
//
// The equation has rolls on both sides and the term holds none, so applying it
// has to put them in first: `(roll d)^(d+1)` = nothing, read backwards, is the
// only way to introduce a roll at all, and it introduces a whole cycle, of
// which the unframing eats `m` and leaves `d`.
//
// What that buys is the operand at the **top of the stack**, where
// `split_bool` and the folding laws are stated. Matching it is a question of
// which side you read: reading the rolls, only their count `m` is visible
// before the match; reading the frame, `d` is on the node and `n` and `m` are
// its body's arity, so the window is one node and all three are known.
identity taking_a_frame_off { dip 1 { not } } = { roll 1 not roll 1 };

// `push a ; push b ; tuple 2 ; … ; equal` decided, which needs constant folding
// to know how to build a tuple and how to take one apart.
//
// The obstacle is that value laws are stated about literals, and a constructed
// tuple is not one — so a postcondition comparing what a function just built
// against what it should have built stalls with both operands right there.
// Widening folding to cover it is not a new law: "the pushes of what the
// operator answers" already covers `tuple`, which is an operator that answers.
identity comparing_two_built_tuples
    { push some_sym push 1 tuple 2 push some_sym push 1 tuple 2 equal }
  = { push true };

// `untuple n ; tuple n` = `as_tuple n` — the one direction that is not the
// identity, and what it is instead.
//
// Taking a value apart and putting it back is the identity only where there was
// something to take apart. Everywhere else `untuple n` fills its slots with
// `()`s, so what comes back is `((), …)`: the coercion, which is where those
// `()`s came from. It is the law that says junk-normalizing has a name.
identity untupling_and_retupling_is_the_coercion { untuple 2 tuple 2 } = { as_tuple 2 };

// The value an arm tested equal to, written into the arm.
//
// What it buys is the second line: once the literal is there, folding reads a
// window it could not read before, and the arm collapses to the constant. That
// is the entire content of the law — it is the first fact here about what an
// instruction *computes* rather than about shape, and nothing else reaches it,
// since `split_bool` splits the boolean and leaves the value opaque in both
// arms.
identity specializing_a_tested_value
    { pick 0 push 7 equal branch { push 7 equal } { drop 0 push false } }
  = { pick 0 push 7 equal branch { drop 0 push true } { drop 0 push false } };
