// Integration tests for sentence arity annotations

#[arity(2, 1)]
sentence add_two {
    add
    assert
}

#[arity(0, 1)]
sentence push_val {
    push 100
}

function double_val {
    pick 0
    add
    assert
}

test sentence test_arity_add_two {
    push 40
    push 2
    jump add_two
    push 42
    test_assert_eq
    push crate::prelude::pass
}

test sentence test_arity_push_val {
    jump push_val
    push 100
    test_assert_eq
    push crate::prelude::pass
}

test sentence test_arity_double {
    push 21
    jump double_val
    push 42
    test_assert_eq
    push crate::prelude::pass
}

function recursive_helper {
    push 1
    add
    assert
}

function nested_arity_calls {
    jump recursive_helper
    jump recursive_helper
}

test sentence test_arity_nested_calls {
    push 10
    jump nested_arity_calls
    push 12
    test_assert_eq
    push crate::prelude::pass
}

function square {
    pick 0
    multiply
    assert
}

test sentence test_function_keyword {
    push 6
    jump square
    push 36
    test_assert_eq
    push crate::prelude::pass
}
