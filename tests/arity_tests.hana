// Integration tests for sentence arity annotations

#[arity(2, 1)]
sentence add_two {
    add
}

#[arity(0, 1)]
sentence push_val {
    push 100
}

function double_val {
    pick 0
    add
}

test sentence test_arity_add_two {
    push 40
    push 2
    jump add_two
    push 42
    jump crate::prelude::check_equals
}

test sentence test_arity_push_val {
    jump push_val
    push 100
    jump crate::prelude::check_equals
}

test sentence test_arity_double {
    push 21
    jump double_val
    push 42
    jump crate::prelude::check_equals
}

function increment_helper {
    push 1
    add
}

function nested_arity_calls {
    jump increment_helper
    jump increment_helper
}

test sentence test_arity_nested_calls {
    push 10
    jump nested_arity_calls
    push 12
    jump crate::prelude::check_equals
}

function square {
    pick 0
    multiply
}

test sentence test_function_keyword {
    push 6
    jump square
    push 36
    jump crate::prelude::check_equals
}
