symbol test_sym
symbol other_sym

type TestInt int;
type TestBool bool;
type TestConstString const_string;
type TestSymbol symbol;
type TestTuple tuple;

type IntOrBool int | bool;
type SymOr42 test_sym | 42;

type SimpleTuple (bool, int);
type NestedTuple (int | test_sym, SimpleTuple);
type EmptyTuple ();

enum MyEnum {
    Case1(bool, int),
    Case2(symbol),
    Case3(),
}

test sentence test_primitive_checks {
    // Test int
    push 42
    jump TestInt::check
    assert

    push true
    jump TestInt::check
    not
    assert

    // Test bool
    push true
    jump TestBool::check
    assert

    push 42
    jump TestBool::check
    not
    assert

    // Test const string
    push "hi"
    jump TestConstString::check
    assert

    push 42
    jump TestConstString::check
    not
    assert

    // Test symbol
    push test_sym
    jump TestSymbol::check
    assert

    push other_sym
    jump TestSymbol::check
    assert

    push 42
    jump TestSymbol::check
    not
    assert

    // Test tuple
    push (2, 1)
    jump TestTuple::check
    assert

    push 42
    jump TestTuple::check
    not
    assert
    push crate::prelude::pass
}

test sentence test_union_checks {
    push 42
    jump IntOrBool::check
    assert

    push false
    jump IntOrBool::check
    assert

    push "hi"
    jump IntOrBool::check
    not
    assert

    push test_sym
    jump SymOr42::check
    assert

    push 42
    jump SymOr42::check
    assert

    push other_sym
    jump SymOr42::check
    not
    assert

    push 43
    jump SymOr42::check
    not
    assert
    push crate::prelude::pass
}

test sentence test_tuple_checks {
    // SimpleTuple = (bool, int)
    push (true, 42)
    jump SimpleTuple::check
    assert

    // Wrong types
    push (43, 42)
    jump SimpleTuple::check
    not
    assert

    // Wrong length
    push (44, true, 42)
    jump SimpleTuple::check
    not
    assert

    // Not a tuple
    push 42
    jump SimpleTuple::check
    not
    assert

    // NestedTuple = (int | test_sym, SimpleTuple)
    push (3, (false, 10))
    jump NestedTuple::check
    assert

    push (test_sym, (false, 10))
    jump NestedTuple::check
    assert

    push (other_sym, (false, 10))
    jump NestedTuple::check
    not
    assert

    // EmptyTuple = ()
    push ()
    jump EmptyTuple::check
    assert

    push (1)
    jump EmptyTuple::check
    not
    assert

    push 42
    jump EmptyTuple::check
    not
    assert
    push crate::prelude::pass
}

test sentence test_enum_checks {
    // Test MyEnum::Case1
    push ((true, 42), MyEnum::Case1::tag)
    jump MyEnum::check
    assert

    push ((true, 42), MyEnum::Case1::tag)
    jump MyEnum::Case1::check
    assert

    push (true, 42)
    jump MyEnum::Case1::Body::check
    assert

    // Test MyEnum::Case2
    push ((test_sym), MyEnum::Case2::tag)
    jump MyEnum::check
    assert

    push ((test_sym), MyEnum::Case2::tag)
    jump MyEnum::Case2::check
    assert

    push (test_sym)
    jump MyEnum::Case2::Body::check
    assert

    // Test MyEnum::Case3
    push ((), MyEnum::Case3::tag)
    jump MyEnum::check
    assert

    push ((), MyEnum::Case3::tag)
    jump MyEnum::Case3::check
    assert

    push ()
    jump MyEnum::Case3::Body::check
    assert

    // Test invalid variant
    push ((), MyEnum::Case1::tag)
    jump MyEnum::Case1::check
    not
    assert

    push ((42), MyEnum::Case2::tag)
    jump MyEnum::Case2::check
    not
    assert

    push ((1), MyEnum::Case3::tag)
    jump MyEnum::Case3::check
    not
    assert

    // Test invalid tags
    push ((true, 42), test_sym)
    jump MyEnum::check
    not
    assert
    push crate::prelude::pass
}

// A variant payload naming a sibling by a *relative* path. The check for this
// lands three modules deep (RelEnum / Variant / Body), so the path has to be
// shifted by three during lowering; getting that wrong resolves to the wrong
// item or fails outright.
type Small int | bool;

enum RelEnum {
    Wraps(Small),
    Pair(other_sym, Small),
}

mod nested {
    // Same, but reaching back out of an enclosing module.
    enum Outer {
        Holds(super::Small),
    }
}

test sentence test_enum_relative_payload_paths {
    push ((42), RelEnum::Wraps::tag)
    jump RelEnum::check
    assert

    push ((true), RelEnum::Wraps::tag)
    jump RelEnum::check
    assert

    // A const string is not `Small`, so the payload check must reject it.
    push (("no"), RelEnum::Wraps::tag)
    jump RelEnum::check
    not
    assert

    push ((other_sym, 42), RelEnum::Pair::tag)
    jump RelEnum::check
    assert

    push ((test_sym, 42), RelEnum::Pair::tag)
    jump RelEnum::check
    not
    assert

    push (42)
    jump RelEnum::Wraps::Body::check
    assert

    push ("no")
    jump RelEnum::Wraps::Body::check
    not
    assert

    push ((true), nested::Outer::Holds::tag)
    jump nested::Outer::check
    assert

    push (("no"), nested::Outer::Holds::tag)
    jump nested::Outer::check
    not
    assert
    push crate::prelude::pass
}
