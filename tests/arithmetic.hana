// Tests for arithmetic operations

test sentence add_numbers {
    push 10
    push 20
    add
    jump crate::prelude::check_true
    ?
    drop 0
    push 30
    jump crate::prelude::check_equals
}

test sentence subtract_numbers {
    push 50
    push 20
    sub
    jump crate::prelude::check_true
    ?
    drop 0
    push 30
    jump crate::prelude::check_equals
}

test sentence multiply_numbers {
    push 5
    push 6
    mul
    jump crate::prelude::check_true
    ?
    drop 0
    push 30
    jump crate::prelude::check_equals
}

test sentence divide_numbers {
    push 90
    push 3
    div
    jump crate::prelude::check_true
    ?
    drop 0
    push 30
    jump crate::prelude::check_equals
}

test sentence modulo_numbers {
    push 35
    push 10
    mod
    jump crate::prelude::check_true
    ?
    drop 0
    push 5
    jump crate::prelude::check_equals
}

test sentence negate_number {
    push 42
    neg
    jump crate::prelude::check_true
    ?
    drop 0
    push -42
    jump crate::prelude::check_equals
}

test sentence logical_not {
    push true
    not
    push false
    jump crate::prelude::check_equals
    ?
    drop 0
    
    push false
    not
    push true
    jump crate::prelude::check_equals
}

test sentence boolean_operations {
    push true
    push true
    and
    push true
    jump crate::prelude::check_equals
    ?
    drop 0

    push true
    push false
    and
    push false
    jump crate::prelude::check_equals
    ?
    drop 0

    push false
    push false
    and
    push false
    jump crate::prelude::check_equals
    ?
    drop 0

    push true
    push false
    or
    push true
    jump crate::prelude::check_equals
    ?
    drop 0

    push false
    push false
    or
    push false
    jump crate::prelude::check_equals
}
