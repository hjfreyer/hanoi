// Tests for arithmetic operations

test sentence add_numbers {
    push 10
    push 20
    add
    push 30
    assert_eq
}

test sentence subtract_numbers {
    push 50
    push 20
    sub
    push 30
    assert_eq
}

test sentence multiply_numbers {
    push 5
    push 6
    mul
    push 30
    assert_eq
}

test sentence divide_numbers {
    push 90
    push 3
    div
    push 30
    assert_eq
}

test sentence modulo_numbers {
    push 35
    push 10
    mod
    push 5
    assert_eq
}

test sentence negate_number {
    push 42
    neg
    push -42
    assert_eq
}

test sentence logical_not {
    push true
    not
    push false
    assert_eq
    
    push false
    not
    push true
    assert_eq
}

test sentence boolean_operations {
    push true
    push true
    and
    push true
    assert_eq

    push true
    push false
    and
    push false
    assert_eq

    push false
    push false
    and
    push false
    assert_eq

    push true
    push false
    or
    push true
    assert_eq

    push false
    push false
    or
    push false
    assert_eq
}
