// Tests for arithmetic operations

test sentence add_numbers {
    push 10
    push 20
    add
    assert
    push 30
    test_assert_eq
    push crate::prelude::pass
}

test sentence subtract_numbers {
    push 50
    push 20
    sub
    assert
    push 30
    test_assert_eq
    push crate::prelude::pass
}

test sentence multiply_numbers {
    push 5
    push 6
    mul
    assert
    push 30
    test_assert_eq
    push crate::prelude::pass
}

test sentence divide_numbers {
    push 90
    push 3
    div
    assert
    push 30
    test_assert_eq
    push crate::prelude::pass
}

test sentence modulo_numbers {
    push 35
    push 10
    mod
    assert
    push 5
    test_assert_eq
    push crate::prelude::pass
}

test sentence negate_number {
    push 42
    neg
    assert
    push -42
    test_assert_eq
    push crate::prelude::pass
}

test sentence logical_not {
    push true
    not
    push false
    test_assert_eq
    
    push false
    not
    push true
    test_assert_eq
    push crate::prelude::pass
}

test sentence boolean_operations {
    push true
    push true
    and
    push true
    test_assert_eq

    push true
    push false
    and
    push false
    test_assert_eq

    push false
    push false
    and
    push false
    test_assert_eq

    push true
    push false
    or
    push true
    test_assert_eq

    push false
    push false
    or
    push false
    test_assert_eq
    push crate::prelude::pass
}
