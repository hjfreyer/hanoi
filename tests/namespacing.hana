// Tests for Hanoi Namespacing Mechanism

mod foo {
    symbol inner_sym

    sentence target_sentence {
        push 42
        jump crate::prelude::check_equals
    }

    mod bar {
        symbol deepest_sym

        export test sentence check_deep {
            // Reference sibling
            push deepest_sym
            push deepest_sym
            equal
            jump crate::prelude::check_true
            ?
            drop 0
            
            // Reference parent's symbol using super::
            push super::inner_sym
            push super::inner_sym
            equal
            jump crate::prelude::check_true
            ?
            drop 0
            
            // Reference root symbol using crate::
            push crate::namespacing::root_sym
            push crate::namespacing::root_sym
            equal
            jump crate::prelude::check_true
            ?
            drop 0

            // Jump to parent's sentence using super::target_sentence
            push 42
            jump super::target_sentence
        }
    }

    test sentence check_sibling {
        push inner_sym
        push inner_sym
        equal
        jump crate::prelude::check_true
    }
}

symbol root_sym

test sentence check_root {
    // Reference nested symbol using path
    push foo::inner_sym
    push foo::inner_sym
    equal
    jump crate::prelude::check_true
    ?
    drop 0

    push foo::bar::deepest_sym
    push foo::bar::deepest_sym
    equal
    jump crate::prelude::check_true
    ?
    drop 0
    
    // Jump to nested sentence using path
    push 42
    jump foo::target_sentence
}
