# Tests for Hanoi Namespacing Mechanism

mod foo {
    symbol inner_sym "Inner"

    target_sentence {
        push 42
        assert_eq
    }

    mod bar {
        symbol deepest_sym "Deepest"

        export test check_deep {
            # Reference sibling
            push deepest_sym
            push deepest_sym
            equal
            assert
            
            # Reference parent's symbol using super::
            push super::inner_sym
            push super::inner_sym
            equal
            assert
            
            # Reference root symbol using crate::
            push crate::root_sym
            push crate::root_sym
            equal
            assert

            # Jump to parent's sentence using super::target_sentence
            push 42
            jump super::target_sentence
        }
    }

    test check_sibling {
        push inner_sym
        push inner_sym
        equal
        assert
    }
}

symbol root_sym "Root"

test check_root {
    # Reference nested symbol using path
    push foo::inner_sym
    push foo::inner_sym
    equal
    assert

    push foo::bar::deepest_sym
    push foo::bar::deepest_sym
    equal
    assert
    
    # Jump to nested sentence using path
    push 42
    jump foo::target_sentence
}
