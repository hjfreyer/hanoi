// Tests for unique Symbols

symbol sym_a
symbol sym_b
symbol sym_c

test sentence symbol_equality {
    // Pushing the same symbol multiple times compares equal
    push sym_a
    push sym_a
    equal
    assert
}

test sentence symbol_inequality {
    // Distinct symbol definitions compare unequal
    push sym_a
    push sym_b
    equal
    not
    assert
    
    push sym_b
    push sym_c
    equal
    not
    assert
}

test sentence symbol_cross_sentence {
    push sym_c
    jump check_symbol
}

sentence check_symbol {
    push sym_c
    equal
    assert
}

test sentence a_symbol_carries_no_text {
    // A symbol is opaque: the string instructions have nothing to read in one,
    // so they report failure and hand it back.
    push sym_a
    const_string_len
    not
    assert
    push sym_a
    assert_eq

    push sym_a
    push 0
    const_string_char_at
    not
    assert
    push 0
    assert_eq
}

test sentence a_symbol_is_not_a_const_string {
    push sym_a
    is_symbol
    assert

    push sym_a
    is_const_string
    not
    assert

    push "sym_a"
    is_symbol
    not
    assert
}
