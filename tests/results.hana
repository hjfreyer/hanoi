// The `?` operator: unwrap a result, or leave the sentence carrying the error.
//
// A result is the 2-tuple `(value, tag)` with `tag` being `crate::prelude::ok`
// or `crate::prelude::err`. `?` takes one apart: on `ok` the block carries on
// with the value it was holding, and on `err` the block ends there and hands
// the error back as its own answer.

mod result {
    #[arity(1, 1)]
    sentence ok {
        push crate::prelude::ok
        tuple 2
    }

    #[arity(1, 1)]
    sentence err {
        push crate::prelude::err
        tuple 2
    }
}

// Halves an even number, and calls an odd one an error carrying the number it
// could not halve.
#[arity(1, 1)]
sentence halve {
    pick 0
    push 2
    modulo
    branch {
        push 0
        equal
        branch {
            push 2
            divide
            branch {
                jump result::ok
            } {
                // `divide` says no: the quotient it invented is all that is
                // left, so that is what the error carries.
                jump result::err
            }
        } {
            jump result::err
        }
    } {
        drop 0
        jump result::err
    }
}

// Nothing but the unwrap: `?` reads the flag `untuple` leaves rather than
// relying on the shape, so a value that is not a result comes back as an error
// carrying that value.
#[arity(1, 1)]
sentence unwrap {
    ?
}

test sentence unwrapping_an_ok_leaves_the_value {
    push (7, crate::prelude::ok)
    jump unwrap
    push 7
    jump crate::prelude::check_equals
}

test sentence unwrapping_an_err_hands_it_back {
    push (7, crate::prelude::err)
    jump unwrap
    push (7, crate::prelude::err)
    jump crate::prelude::check_equals
}

// A value that is not a 2-tuple is not a result, and `?` calls it an error
// carrying that value rather than failing on it.
test sentence unwrapping_a_non_result_makes_it_an_error {
    push 7
    jump unwrap
    push (7, crate::prelude::err)
    jump crate::prelude::check_equals
}

// Two halvings, the second reached only if the first succeeded.
#[arity(1, 1)]
sentence quarter {
    jump halve
    ?
    jump halve
}

test sentence a_quarter_of_twelve {
    push 12
    jump quarter
    push (3, crate::prelude::ok)
    jump crate::prelude::check_equals
}

test sentence the_first_error_ends_it {
    push 5
    jump quarter
    push (5, crate::prelude::err)
    jump crate::prelude::check_equals
}

test sentence the_second_error_ends_it_too {
    push 6
    jump quarter
    push (3, crate::prelude::err)
    jump crate::prelude::check_equals
}

// Both `?`s here have work sitting under them — the other number, and then the
// half already computed — so both early returns drop what they are leaving
// behind.
#[arity(2, 1)]
sentence sum_of_halves {
    jump halve
    ?
    roll 1
    jump halve
    ?
    add
    branch {
        jump result::ok
    } {
        jump result::err
    }
}

test sentence summing_two_halves {
    push 10
    push 4
    jump sum_of_halves
    push (7, crate::prelude::ok)
    jump crate::prelude::check_equals
}

test sentence the_second_half_fails_and_the_first_is_dropped {
    push 3
    push 4
    jump sum_of_halves
    push (3, crate::prelude::err)
    jump crate::prelude::check_equals
}

test sentence the_first_half_fails_and_the_second_is_never_taken {
    push 10
    push 5
    jump sum_of_halves
    push (5, crate::prelude::err)
    jump crate::prelude::check_equals
}

// `?` leaves the block it is written in, and a branch arm is a block: the error
// lands in the code after the branch rather than at the end of the sentence.
#[arity(1, 1)]
sentence inside_an_arm {
    push true
    branch {
        jump halve
        ?
        push 100
        add
        // Nothing follows in this arm, so the flag has nowhere to go: the
        // answer is the sum, junk or not, and the test's check catches it.
        drop 0
    } {
        drop 0
        push 0
    }
    jump result::ok
}

test sentence an_arm_is_the_block_that_is_left {
    push 8
    jump inside_an_arm
    push (104, crate::prelude::ok)
    jump crate::prelude::check_equals
    ?
    drop 0

    push 5
    jump inside_an_arm
    push ((5, crate::prelude::err), crate::prelude::ok)
    jump crate::prelude::check_equals
}

// -- crate::prelude::check_equals ------------------------------------------

test sentence equal_values_check_out {
    push 10
    push 10
    jump crate::prelude::check_equals
}

test sentence unequal_values_report_the_pair_that_did_not_match {
    push 10
    push 11
    jump crate::prelude::check_equals
    push ((10, 11), crate::prelude::err)
    jump crate::prelude::check_equals
}

test sentence checking_true {
    push true
    jump crate::prelude::check_true
}

test sentence checking_something_that_is_not_true {
    push 3
    jump crate::prelude::check_true
    push ((3, true), crate::prelude::err)
    jump crate::prelude::check_equals
}
