    # 6. Check emitted: (split::out, (split::end, ()))
    pick 0
    jump split_system::emit
    untuple 2
    assert
    push (split::out, (split::end, ()))
    assert_eq
    
    # Process end event
    push (split::out, (split::end, ()))
    jump split_system::process
    
    # --- Field 2: "b" ---
    # 7. Send (split::out, (split::next, ()))
    push (split::out, (split::next, ()))
    jump split_system::process
    
    # 8. Drive 3 taus for 'b'
    jump split_system::tau_reduce
    untuple 2
    assert
    jump split_system::tau_reduce
    untuple 2
    assert
    jump split_system::tau_reduce
    untuple 2
    assert
    
    # 9. Check emitted: (split::out, (split::start, ()))
    pick 0
    jump split_system::emit
    untuple 2
    assert
    push (split::out, (split::start, ()))
    assert_eq
    
    push (split::out, (split::start, ()))
    jump split_system::process
    
    # 10. Check emitted: (split::out, (split::item, (next, 98))) ('b')
    pick 0
    jump split_system::emit
    untuple 2
    assert
    push (split::out, (split::item, (next, 98)))
    assert_eq
    
    push (split::out, (split::item, (next, 98)))
    jump split_system::process
    
    # 11. Drive 3 taus for done
    jump split_system::tau_reduce
    untuple 2
    assert
    jump split_system::tau_reduce
    untuple 2
    assert
    jump split_system::tau_reduce
    untuple 2
    assert
    
    # 12. Check emitted: (split::out, (split::end, ()))
    pick 0
    jump split_system::emit
    untuple 2
    assert
    push (split::out, (split::end, ()))
    assert_eq
    
    push (split::out, (split::end, ()))
    jump split_system::process
    
    # --- Done ---
    # 13. Send (split::out, (split::next, ()))
    push (split::out, (split::next, ()))
    jump split_system::process
    
    # 14. Check emitted: (split::out, (split::done, ()))
    pick 0
    jump split_system::emit
    untuple 2
    assert
    push (split::out, (split::done, ()))
    assert_eq
    
    push (split::out, (split::done, ()))
    jump split_system::process
    
    drop 0
}
