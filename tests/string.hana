test iterate_unicode {
    jump cafe_string_hidden::init
    
    # 'c' (99)
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    
    pick 0
    jump cafe_string_hidden::emit
    push (out, (next, 99))
    roll 1
    set_contains
    assert
    push (out, (next, 99))
    jump cafe_string_hidden::process
    
    # 'a' (97)
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    
    pick 0
    jump cafe_string_hidden::emit
    push (out, (next, 97))
    roll 1
    set_contains
    assert
    push (out, (next, 97))
    jump cafe_string_hidden::process
    
    # 'f' (102)
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    
    pick 0
    jump cafe_string_hidden::emit
    push (out, (next, 102))
    roll 1
    set_contains
    assert
    push (out, (next, 102))
    jump cafe_string_hidden::process
    
    # 'é' (233)
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    
    pick 0
    jump cafe_string_hidden::emit
    push (out, (next, 233))
    roll 1
    set_contains
    assert
    push (out, (next, 233))
    jump cafe_string_hidden::process
    
    # done
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    push crate::prelude::event::tau
    jump cafe_string_hidden::process
    
    pick 0
    jump cafe_string_hidden::emit
    push (out, (done, ()))
    roll 1
    set_contains
    assert
    push (out, (done, ()))
    jump cafe_string_hidden::process
    
    drop 0
}
