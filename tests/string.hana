# String character iterator machine and tests
# Unprefixed string_ref state machine, prefixed_string_ref decorator & CSP char_iterator (hard-coded ports)

symbol next "Next character event"
symbol done "Iteration finished event"

symbol in   "in"
symbol out  "out"

# Base unprefixed string_ref machine
mod string_ref {
    symbol length       "Query string length"
    symbol charat       "Query character at index"
    symbol length_resp  "Response for string length"
    symbol charat_resp  "Response for character at index"
    symbol none         "None option variant"
    symbol some         "Some option variant"
    symbol idle         "Idle state"

    # Initialize with a symbol representing string contents.
    # Expects sym on stack.
    # Returns (sym, idle) state.
    init {
        push idle
        tuple 2
    }
    
    # accept: takes state (sym, internal_state) and returns ValueSet of accepted events.
    # At rest (idle), accepts (length, ()) or (charat, N).
    accept {
        untuple 2 # Stack: [sym, internal_state]
        pick 0 # duplicate internal_state before comparison
        push idle
        equal
        branch {
            # Accept (length, ())
            drop 0 # drop internal_state
            drop 0 # drop sym
            push singleton((length, ()))
            
            # Accept (charat, N) for any N
            push set_tuple(singleton(charat), universal_set)
            set_union
        } {
            # In response state: accepts nothing (empty_set)
            pick 0
            untuple 2 # Stack: [sym, internal_state, resp_tag, resp_val]
            pick 1 # resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                drop 0
                drop 0
                push empty_set
            } {
                pick 1 # resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    drop 0
                    push empty_set
                } {
                    panic
                }
            }
        }
    }

    # emit: takes state (sym, internal_state) and returns ValueSet of emitted events.
    # In response state, emits internal_state which is (length_resp, len) or (charat_resp, ...).
    emit {
        untuple 2 # Stack: [sym, internal_state]
        pick 0 # duplicate internal_state before comparison
        push idle
        equal
        branch {
            # At rest: emits nothing
            drop 0 # drop internal_state
            drop 0 # drop sym
            push empty_set
        } {
            # In response state: internal_state is the response event
            drop 1 # drop sym. Stack: [internal_state]
            pick 0
            untuple 2 # Stack: [internal_state, resp_tag, resp_val]
            pick 1 # resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                set_singleton
            } {
                pick 1 # resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    set_singleton
                } {
                    panic
                }
            }
        }
    }

    # process: takes state and event, returns next_state
    process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 2 # Stack: [event, sym, internal_state]
        
        pick 0
        push idle
        equal
        branch {
            # Case 1: internal_state is idle. We processed a query event (length, ()) or (charat, N).
            drop 0 # drop internal_state. Stack: [event, sym]
            roll 1 # Stack: [sym, event]
            untuple 2 # Stack: [sym, query_type, query_payload]
            
            pick 1 # query_type
            push length
            equal
            branch {
                # length query: query_payload is ()
                drop 0 # drop query_payload (which is ())
                drop 0 # drop query_type. Stack: [sym]
                
                pick 0 # sym
                symbol_len # len
                
                push length_resp
                roll 1
                tuple 2 # (length_resp, len)
                
                tuple 2 # (sym, (length_resp, len))
            } {
                # charat query: query_payload is N
                drop 1 # drop query_type. Stack: [sym, N]
                
                # Check if N < len
                pick 1 # sym
                symbol_len # len
                
                pick 1 # N
                pick 1 # len
                less
                branch {
                    # N < len: return character
                    drop 0 # drop len
                    pick 1 # sym
                    pick 1 # N
                    symbol_char_at # ch
                    
                    push some
                    roll 1
                    tuple 2 # (some, ch)
                    
                    push charat_resp
                    roll 1
                    tuple 2 # (charat_resp, (some, ch))
                    
                    # Clean up N
                    drop 1 # Stack: [sym, (charat_resp, (some, ch))]
                    
                    tuple 2 # (sym, (charat_resp, (some, ch)))
                } {
                    # N >= len: return none
                    drop 0 # drop len
                    drop 0 # drop N. Stack: [sym]
                    
                    push none
                    tuple 0
                    tuple 2 # (none, ())
                    
                    push charat_resp
                    roll 1
                    tuple 2 # (charat_resp, (none, ()))
                    
                    tuple 2 # (sym, (charat_resp, (none, ())))
                }
            }
        } {
            # Case 2: internal_state is not idle. We processed the response event.
            # Transition back to idle.
            # Stack: [event, sym, internal_state]
            drop 0 # drop internal_state
            roll 1 # Stack: [sym, event]
            drop 0 # drop event. Stack: [sym]
            
            push idle
            tuple 2 # (sym, idle)
        }
    }
}



mod char_iterator {
    symbol fetch        "Fetch charat state"
    symbol await_charat "Await charat response state"
    symbol yield_next   "Yield next character state"
    symbol yield_done   "Yield done state"
    symbol done_state   "Finished iteration state"

    # Initialize char_iterator state.
    # Returns (fetch, 0) state.
    init {
        push fetch
        push 0
        tuple 2 # (fetch, 0)
    }
    
    # accept: takes state (tag, payload) and returns ValueSet of accepted events.
    # Accepts (in, (charat_resp, ...)) when internal_state is (await_charat, idx).
    accept {
        untuple 2 # Stack: [tag, payload]
        pick 1 # tag
        push await_charat
        equal
        branch {
            # In await_charat state: accepts charat_resp on channel "in"
            drop 0 # drop tag
            drop 0 # drop payload
            
            # Construct set of (in, (charat_resp, (some, ch)))
            push super::in
            set_singleton
            push set_tuple(singleton(super::string_ref::charat_resp), set_tuple(singleton(super::string_ref::some), universal_set))
            set_tuple 2 # set of (in, (charat_resp, (some, ch)))
            
            # Construct set of (in, (charat_resp, (none, ())))
            push super::in
            set_singleton
            push singleton((super::string_ref::charat_resp, (super::string_ref::none, ())))
            set_tuple 2 # set of (in, (charat_resp, (none, ())))
            
            set_union
        } {
            pick 1 # tag
            push fetch
            equal
            branch {
                drop 0
                drop 0
                push empty_set
            } {
                pick 1 # tag
                push yield_next
                equal
                branch {
                    drop 0
                    drop 0
                    push empty_set
                } {
                    pick 1 # tag
                    push yield_done
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        pick 1 # tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            push empty_set
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }

    # emit: takes state (tag, payload) and returns ValueSet of emitted events.
    emit {
        untuple 2 # Stack: [tag, payload]
        
        pick 1 # tag
        push fetch
        equal
        branch {
            # fetch state: emits (in, (charat, idx))
            drop 1 # drop tag
            push super::string_ref::charat
            roll 1 # payload is idx
            tuple 2 # (charat, idx)
            
            push super::in
            roll 1
            tuple 2 # (in, (charat, idx))
            set_singleton
        } {
            pick 1 # tag
            push yield_next
            equal
            branch {
                # yield_next state: payload is (idx, ch), emits (out, (next, ch))
                drop 1 # drop tag
                untuple 2 # Stack: [idx, ch]
                roll 1 # Stack: [ch, idx]
                drop 0 # drop idx
                
                push super::next
                roll 1 # ch
                tuple 2 # (next, ch)
                
                push super::out
                roll 1
                tuple 2 # (out, (next, ch))
                set_singleton
            } {
                pick 1 # tag
                push yield_done
                equal
                branch {
                    # yield_done state: emits (out, (done, ()))
                    drop 0 # drop payload
                    drop 0 # drop tag
                    
                    push super::done
                    tuple 0
                    tuple 2 # (done, ())
                    
                    push super::out
                    roll 1
                    tuple 2 # (out, (done, ()))
                    set_singleton
                } {
                    pick 1 # tag
                    push await_charat
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        pick 1 # tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            push empty_set
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }
    
    # process: takes state (tag, payload) and event, returns next_state
    process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 2 # Stack: [event, tag, payload]
        
        pick 1 # tag
        push fetch
        equal
        branch {
            # Transition from (fetch, idx) to (await_charat, idx)
            # Stack: [event, tag, payload]
            drop 1 # drop tag
            push await_charat
            roll 1 # payload (idx)
            tuple 2 # (await_charat, idx)
            
            # Stack: [event, (await_charat, idx)]
            roll 1 # moves event to top
            drop 0 # drop event. Stack: [(await_charat, idx)]
        } {
            pick 1 # tag
            push await_charat
            equal
            branch {
                # Transition from (await_charat, idx) to (yield_next, (idx, ch)) or (yield_done, idx)
                # Stack: [event, tag, payload] (payload is idx)
                drop 1 # drop tag. Stack: [event, idx]
                roll 1 # moves event to top. Stack: [idx, event]
                untuple 2 # Stack: [idx, port, resp_event]
                drop 1 # drop port. Stack: [idx, resp_event]
                untuple 2 # Stack: [idx, charat_resp, resp_payload]
                drop 1 # drop charat_resp. Stack: [idx, resp_payload]
                untuple 2 # Stack: [idx, variant, val]
                
                pick 1 # variant
                push super::string_ref::some
                equal
                branch {
                    # Variant is some (val is ch)
                    # Stack: [idx, variant, ch]
                    drop 1 # drop variant. Stack: [idx, ch]
                    tuple 2 # (idx, ch)
                    
                    push yield_next
                    roll 1
                    tuple 2 # (yield_next, (idx, ch))
                } {
                    # Variant is none
                    # Stack: [idx, variant, ()]
                    drop 0 # drop ()
                    drop 0 # drop variant. Stack: [idx]
                    
                    push yield_done
                    roll 1
                    tuple 2 # (yield_done, idx)
                }
            } {
                pick 1 # tag
                push yield_next
                equal
                branch {
                    # Transition from (yield_next, (idx, ch)) to (fetch, idx + 1)
                    # Stack: [event, tag, payload] (payload is (idx, ch))
                    drop 1 # drop tag
                    untuple 2 # Stack: [event, idx, ch]
                    drop 0 # drop ch. Stack: [event, idx]
                    roll 1 # moves event to top
                    drop 0 # drop event. Stack: [idx]
                    
                    push 1
                    add # idx + 1
                    
                    push fetch
                    roll 1
                    tuple 2 # (fetch, idx + 1)
                } {
                    # Transition from (yield_done, idx) to (done_state, idx)
                    # Stack: [event, tag, payload] (payload is idx)
                    drop 1 # drop tag. Stack: [event, idx]
                    roll 1 # moves event to top
                    drop 0 # drop event. Stack: [idx]
                    
                    push done_state
                    roll 1
                    tuple 2 # (done_state, idx)
                }
            }
        }
    }
}

symbol copy  "copy"
symbol value "value"
symbol ok    "ok"
symbol err   "err"

mod parseint {
    symbol idle         "Idle state"
    symbol parsing      "Parsing state"
    symbol yielding_ok  "Yielding ok result state"
    symbol yielding_err "Yielding err result state"

    # init: returns idle state
    init {
        push idle
    }

    # accept: takes [state] and returns ValueSet of accepted events.
    # Accepts out.copy when idle, or in.out.next / in.out.done when parsing.
    accept {
        pick 0
        push idle
        equal
        branch {
            # idle: accepts (out, (copy, ()))
            drop 0
            push super::out
            set_singleton
            push singleton((super::copy, ()))
            set_tuple 2
        } {
            untuple 2 # Stack: [tag, payload]
            pick 1 # tag
            push parsing
            equal
            branch {
                drop 0 # drop payload
                drop 0 # drop tag
                
                # Accepts (in, (out, (next, ch))) for any ch
                push super::in
                set_singleton
                push set_tuple(singleton(super::out), set_tuple(singleton(super::next), universal_set))
                set_tuple 2 # set of (in, (out, (next, ch)))
                
                # Accepts (in, (out, (done, ())))
                push super::in
                set_singleton
                push singleton((super::out, (super::done, ())))
                set_tuple 2 # set of (in, (out, (done, ())))
                
                set_union
            } {
                pick 1 # tag
                push yielding_ok
                equal
                branch {
                    drop 0
                    drop 0
                    push empty_set
                } {
                    pick 1 # tag
                    push yielding_err
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        panic
                    }
                }
            }
        }
    }

    # emit: takes [state] and returns ValueSet of emitted events.
    # Emits out.value.ok.N or out.value.err when in yielding state.
    emit {
        pick 0
        push idle
        equal
        branch {
            drop 0
            push empty_set
        } {
            untuple 2 # Stack: [tag, payload]
            pick 1 # tag
            push parsing
            equal
            branch {
                drop 0
                drop 0
                push empty_set
            } {
                pick 1 # tag
                push yielding_ok
                equal
                branch {
                    # payload is N (the parsed integer)
                    # Emits (out, (value, (ok, N)))
                    drop 1 # drop tag. Stack: [N]
                    push super::ok
                    roll 1 # N
                    tuple 2 # (ok, N)
                    
                    push super::value
                    roll 1
                    tuple 2 # (value, (ok, N))
                    
                    push super::out
                    roll 1
                    tuple 2 # (out, (value, (ok, N)))
                    
                    set_singleton
                } {
                    pick 1 # tag
                    push yielding_err
                    equal
                    branch {
                        # Emits (out, (value, (err, ())))
                        drop 0 # drop payload
                        drop 0 # drop tag
                        
                        push super::err
                        tuple 0
                        tuple 2 # (err, ())
                        
                        push super::value
                        roll 1
                        tuple 2 # (value, (err, ()))
                        
                        push super::out
                        roll 1
                        tuple 2 # (out, (value, (err, ())))
                        
                        set_singleton
                    } {
                        panic
                    }
                }
            }
        }
    }

    # process: takes [state, event] and returns next_state.
    process {
        # Stack: [state, event]
        pick 1 # state
        push idle
        equal
        branch {
            # State is idle: event is (out, (copy, ()))
            drop 0 # drop event
            drop 0 # drop state
            
            # Init parsing state: (parsing, (0, 0)) -> (acc = 0, count = 0)
            push parsing
            push 0
            push 0
            tuple 2 # (acc=0, count=0)
            tuple 2 # (parsing, (0, 0))
        } {
            # State is (tag, payload)
            roll 1 # Stack: [event, state]
            untuple 2 # Stack: [event, tag, payload]
            
            pick 1 # tag
            push yielding_ok
            equal
            branch {
                # Process emission of yielding_ok -> returns idle state
                drop 0 # drop payload
                drop 0 # drop tag
                drop 0 # drop event
                push idle
            } {
                pick 1 # tag
                push yielding_err
                equal
                branch {
                    # Process emission of yielding_err -> returns idle state
                    drop 0 # drop payload
                    drop 0 # drop tag
                    drop 0 # drop event
                    push idle
                } {
                    pick 1 # tag
                    push parsing
                    equal
                    branch {
                        # Stack: [event, tag, payload]
                        drop 1 # drop tag
                        roll 1 # Stack: [payload, event]
                        
                        untuple 2 # Stack: [payload, in_sym, inner_event]
                        drop 1 # drop in_sym. Stack: [payload, inner_event]
                        
                        # inner_event is (out, (item_tag, val))
                        untuple 2 # Stack: [payload, out_sym, (item_tag, val)]
                        drop 1 # drop out_sym
                        untuple 2 # Stack: [payload, item_tag, val]
                        
                        roll 2 # Stack: [item_tag, val, payload]
                        untuple 2 # Stack: [item_tag, val, acc, count]
                        
                        # Check item_tag
                        pick 3 # item_tag
                        push super::next
                        equal
                        branch {
                            # item_tag == next: val is character codepoint (ch)
                            roll 3 # Stack: [val, acc, count, item_tag]
                            drop 0 # drop item_tag. Stack: [ch, acc, count]
                            
                            # Check if ch >= 48 && ch <= 57
                            pick 2 # ch
                            push 48
                            less
                            branch {
                                # ch < 48: non-digit error!
                                drop 0
                                drop 0
                                drop 0
                                push yielding_err
                                tuple 0
                                tuple 2 # (yielding_err, ())
                            } {
                                pick 2 # ch
                                push 57
                                greater
                                branch {
                                    # ch > 57: non-digit error!
                                    drop 0
                                    drop 0
                                    drop 0
                                    push yielding_err
                                    tuple 0
                                    tuple 2 # (yielding_err, ())
                                } {
                                    # ch is a digit 0..9
                                    # digit = ch - 48
                                    roll 2 # Stack: [acc, count, ch]
                                    push 48
                                    sub # Stack: [acc, count, digit]
                                    
                                    # acc' = acc * 10 + digit
                                    roll 2 # Stack: [count, digit, acc]
                                    push 10
                                    mul
                                    add # acc' = acc * 10 + digit
                                    
                                    # count' = count + 1
                                    roll 1 # Stack: [acc', count]
                                    push 1
                                    add # count' = count + 1
                                    
                                    tuple 2 # (acc', count')
                                    push parsing
                                    roll 1
                                    tuple 2 # (parsing, (acc', count'))
                                }
                            }
                        } {
                            # Check if item_tag == done
                            pick 3 # item_tag
                            push super::done
                            equal
                            branch {
                                # Stack: [item_tag, val, acc, count]
                                roll 3 # Stack: [val, acc, count, item_tag]
                                drop 0 # Stack: [val, acc, count]
                                roll 2 # Stack: [acc, count, val]
                                drop 0 # Stack: [acc, count]
                                
                                # Check if count > 0
                                pick 0 # count
                                push 0
                                greater
                                branch {
                                    # count > 0: success! Return (yielding_ok, acc)
                                    drop 0 # drop count. Stack: [acc]
                                    push yielding_ok
                                    roll 1 # acc
                                    tuple 2 # (yielding_ok, acc)
                                } {
                                    # count == 0: empty input error! Return (yielding_err, ())
                                    drop 0 # drop count
                                    drop 0 # drop acc
                                    push yielding_err
                                    tuple 0
                                    tuple 2 # (yielding_err, ())
                                }
                            } {
                                panic
                            }
                        }
                    } {
                        panic
                    }
                }
            }
        }
    }
}

symbol my_str "abc"
symbol empty_str ""
symbol cafe_str "café"
symbol xyz_str "xyz"
symbol str_123 "123"
symbol str_45a "45a"

mod string_ref_base {
    init {
        push super::my_str
        jump super::string_ref::init
    }
    accept {
        jump super::string_ref::accept
    }
    emit {
        jump super::string_ref::emit
    }
    process {
        jump super::string_ref::process
    }
}

sync_in {
    push set_tuple(singleton(in), universal_set)
}

mod string_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(string_ref_base, in),
        char_iterator,
        sync_in
    ),
    sync_in
);

test iterate_string_ascii {
    # Initialize system -> [((my_str, idle), (fetch, 0))]
    jump string_hidden::init
    
    # Step 0: drive tau (charat request)
    push crate::prelude::event::tau
    jump string_hidden::process
    
    # drive tau (charat response)
    push crate::prelude::event::tau
    jump string_hidden::process
    
    # Check emitted iterator event: (out, (next, 97)) ('a')
    pick 0
    jump string_hidden::emit
    push (out, (next, 97))
    roll 1
    set_contains
    assert
    
    # Process iterator event
    push (out, (next, 97))
    jump string_hidden::process
    
    # Step 1: drive 2 taus for 'b' (98)
    push crate::prelude::event::tau
    jump string_hidden::process
    push crate::prelude::event::tau
    jump string_hidden::process
    
    pick 0
    jump string_hidden::emit
    push (out, (next, 98))
    roll 1
    set_contains
    assert
    
    push (out, (next, 98))
    jump string_hidden::process
    
    # Step 2: drive 2 taus for 'c' (99)
    push crate::prelude::event::tau
    jump string_hidden::process
    push crate::prelude::event::tau
    jump string_hidden::process
    
    pick 0
    jump string_hidden::emit
    push (out, (next, 99))
    roll 1
    set_contains
    assert
    
    push (out, (next, 99))
    jump string_hidden::process
    
    # Step 3: drive 2 taus for done
    push crate::prelude::event::tau
    jump string_hidden::process
    push crate::prelude::event::tau
    jump string_hidden::process
    
    pick 0
    jump string_hidden::emit
    push (out, (done, ()))
    roll 1
    set_contains
    assert
    
    push (out, (done, ()))
    jump string_hidden::process
    
    # Clean up state from stack
    drop 0
}

mod str_123_base {
    init {
        push super::str_123
        jump super::string_ref::init
    }
    accept { jump super::string_ref::accept }
    emit { jump super::string_ref::emit }
    process { jump super::string_ref::process }
}

mod str_123_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(str_123_base, in),
        char_iterator,
        sync_in
    ),
    sync_in
);

mod parseint_123_system compose_hidden(
    compose_concurrent(
        parseint,
        compose_prefix(str_123_hidden, in),
        sync_in
    ),
    sync_in
);

test parseint_valid_number {
    jump parseint_123_system::init
    
    # 1. Verify idle parseint accepts (out, (copy, ()))
    pick 0
    jump parseint_123_system::accept
    push (out, (copy, ()))
    roll 1
    set_contains
    assert
    
    # 2. Trigger (out, (copy, ())) -> transitions parseint to parsing
    push (out, (copy, ()))
    jump parseint_123_system::process
    
    # 3. Drive 12 tau steps
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    push crate::prelude::event::tau
    jump parseint_123_system::process
    
    # 4. Check emitted result: (out, (value, (ok, 123)))
    pick 0
    jump parseint_123_system::emit
    push (out, (value, (ok, 123)))
    roll 1
    set_contains
    assert
    
    # Process emission event -> transitions back to idle
    push (out, (value, (ok, 123)))
    jump parseint_123_system::process
    
    drop 0
}

mod str_45a_base {
    init {
        push super::str_45a
        jump super::string_ref::init
    }
    accept { jump super::string_ref::accept }
    emit { jump super::string_ref::emit }
    process { jump super::string_ref::process }
}

mod str_45a_hidden compose_hidden(
