// String manipulation machines and tests using the new (args, tag) tuple convention.

symbol next "Next character event"
symbol done "Iteration finished event"

mod string_ref {
    symbol idle "idle state"
    symbol length "length query"
    symbol charat "charat query"
    symbol length_resp "length response"
    symbol charat_resp "charat response"
    symbol some "some option variant"
    symbol none "none option variant"

    // init: returns idle state of string_ref
    // State is (sym, idle)
    function init {
        push idle
        tuple 2
    }
    
    // accept: takes state (sym, internal_state) and returns ValueSet of accepted events.
    function accept {
        untuple 2 // Stack: [sym, internal_state]
        pick 0 // duplicate internal_state
        push idle
        equal
        branch {
            drop 0 // drop internal_state
            drop 0 // drop sym
            tuple 0
            push length
            tuple 2 // ((), length)
            set_singleton
            
            // Accept (N, charat) for any N
            push universal_set
            push charat
            set_singleton
            set_tuple 2
            set_union
        } {
            // In response state: accepts nothing (empty_set)
            pick 0
            untuple 2 // Stack: [sym, internal_state, resp_val, resp_tag]
            pick 0 // resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                drop 0
                drop 0
                push empty_set
            } {
                pick 0 // resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    drop 0
                    push empty_set
                } {
                    panic
                }
            }
        }
    }

    function tau_reduce {
        push false
        tuple 2
    }

    // emit: takes state (sym, internal_state) and returns ValueSet of emitted events.
    function emit {
        untuple 2 // Stack: [sym, internal_state]
        pick 0 // duplicate internal_state
        push idle
        equal
        branch {
            drop 0 // drop internal_state
            drop 0 // drop sym
            tuple 0
            push false
            tuple 2
        } {
            drop 1 // drop sym. Stack: [internal_state]
            pick 0
            untuple 2 // Stack: [internal_state, resp_val, resp_tag]
            pick 0 // resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                push true
                tuple 2
            } {
                pick 0 // resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    push true
                    tuple 2
                } {
                    panic
                }
            }
        }
    }
    
    // process: takes state and event, returns next_state
    function process {
        untuple 2
        // Stack: [state, event]
        roll 1 // Stack: [event, state]
        untuple 2 // Stack: [event, sym, internal_state]
        
        pick 0
        push idle
        equal
        branch {
            // Case 1: internal_state is idle. We processed a query event ((), length) or (N, charat).
            drop 0 // drop internal_state. Stack: [event, sym]
            roll 1 // Stack: [sym, event]
            untuple 2 // Stack: [sym, query_payload, query_type]
            
            pick 0 // query_type
            push length
            equal
            branch {
                drop 0 // drop query_type
                drop 0 // drop query_payload (which is ())
                pick 0 // sym
                symbol_len // len
                
                push length_resp
                tuple 2 // (len, length_resp)
                
                tuple 2 // (sym, (len, length_resp))
            } {
                drop 0 // drop query_type. Stack: [sym, N]
                
                // Check if N < len
                pick 1 // sym
                symbol_len // len
                
                pick 1 // N
                pick 1 // len
                less
                branch {
                    // N < len: return character
                    drop 0 // drop len
                    pick 1 // sym
                    pick 1 // N
                    symbol_char_at // ch
                    
                    push some
                    tuple 2 // (ch, some)
                    
                    push charat_resp
                    tuple 2 // ((ch, some), charat_resp)
                    
                    drop 1 // drop N
                    tuple 2 // (sym, ((ch, some), charat_resp))
                } {
                    // N >= len: return none
                    drop 0 // drop len
                    drop 0 // drop N. Stack: [sym]
                    
                    tuple 0
                    push none
                    tuple 2 // ((), none)
                    
                    push charat_resp
                    tuple 2 // (((), none), charat_resp)
                    
                    tuple 2 // (sym, (((), none), charat_resp))
                }
            }
        } {
            // Case 2: internal_state is not idle. We processed the response event.
            // Transition back to idle.
            drop 0 // drop internal_state
            roll 1 // Stack: [sym, event]
            drop 0 // drop event. Stack: [sym]
            
            push idle
            tuple 2 // (sym, idle)
        }
    }

    function is_done {
        drop 0
        push false
    }

    function is_ready_to_finish {
        untuple 2
        push idle
        equal
        roll 1
        drop 0
    }
}

mod char_iterator {
    symbol in           "char_iterator::in"
    symbol out          "char_iterator::out"
    symbol fetch        "Fetch charat state"
    symbol await_charat "Await charat response state"
    symbol yield_next   "Yield next character state"
    symbol yield_done   "Yield done state"
    symbol done_state   "Finished iteration state"

    // Initialize char_iterator state.
    // Returns (0, fetch) state.
    function init {
        untuple 0
        push 0
        push fetch
        tuple 2
    }
    
    // accept: takes state (payload, tag) and returns ValueSet of accepted events.
    function accept {
        untuple 2 // Stack: [payload, tag]
        pick 0 // tag
        push await_charat
        equal
        branch {
            drop 0 // drop tag
            drop 0 // drop payload
            
            // Construct set of (((ch, some), charat_resp), in)
            push universal_set
            push super::string_ref::some
            set_singleton
            set_tuple 2 // {(ch, some)}
            
            push super::string_ref::charat_resp
            set_singleton
            set_tuple 2 // {((ch, some), charat_resp)}
            
            push in
            set_singleton
            set_tuple 2 // {(((ch, some), charat_resp), in)}
            
            // Construct set of ((((), none), charat_resp), in)
            tuple 0
            push super::string_ref::none
            tuple 2 // ((), none)
            push super::string_ref::charat_resp
            tuple 2 // (((), none), charat_resp)
            push in
            tuple 2 // ((((), none), charat_resp), in)
            set_singleton
            
            set_union
        } {
            pick 0 // tag
            push fetch
            equal
            branch {
                drop 0
                drop 0
                push empty_set
            } {
                pick 0 // tag
                push yield_next
                equal
                branch {
                    drop 0
                    drop 0
                    push empty_set
                } {
                    pick 0 // tag
                    push yield_done
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        pick 0 // tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            push empty_set
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }

    function tau_reduce {
        push false
        tuple 2
    }

    // emit: takes state (payload, tag) and returns ValueSet of emitted events.
    function emit {
        untuple 2 // Stack: [payload, tag]
        
        pick 0 // tag
        push fetch
        equal
        branch {
            // fetch state: emits (((idx, charat), in), true)
            drop 0 // drop tag. Stack: [idx]
            push super::string_ref::charat
            tuple 2 // (idx, charat)
            
            push in
            tuple 2 // ((idx, charat), in)
            push true
            tuple 2
        } {
            pick 0 // tag
            push yield_next
            equal
            branch {
                // yield_next state: payload is (idx, ch), emits (((ch, next), out), true)
                drop 0 // drop tag. Stack: [(idx, ch)]
                untuple 2 // Stack: [idx, ch]
                roll 1 // Stack: [ch, idx]
                drop 0 // drop idx. Stack: [ch]
                
                push super::next
                tuple 2 // (ch, next)
                
                push out
                tuple 2 // ((ch, next), out)
                push true
                tuple 2
            } {
                pick 0 // tag
                push yield_done
                equal
                branch {
                    // yield_done state: emits ((((), done), out), true)
                    drop 0 // drop payload
                    drop 0 // drop tag
                    
                    tuple 0
                    push super::done
                    tuple 2 // ((), done)
                    
                    push out
                    tuple 2 // (((), done), out)
                    push true
                    tuple 2
                } {
                    pick 0 // tag
                    push await_charat
                    equal
                    branch {
                        drop 0
                        drop 0
                        tuple 0
                        push false
                        tuple 2
                    } {
                        pick 0 // tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            tuple 0
                            push false
                            tuple 2
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }
    
    // process: takes state (payload, tag) and event, returns next_state
    function process {
        untuple 2
        // Stack: [state, event]
        roll 1 // Stack: [event, state]
        untuple 2 // Stack: [event, payload, tag]
        
        pick 0 // tag
        push fetch
        equal
        branch {
            // Transition from (idx, fetch) to (idx, await_charat)
            drop 0 // drop tag
            push await_charat
            tuple 2 // (payload, await_charat)
            
            roll 1
            drop 0
        } {
            pick 0 // tag
            push await_charat
            equal
            branch {
                // Transition from (idx, await_charat) to ((idx, ch), yield_next) or (idx, yield_done)
                drop 0 // drop tag. Stack: [event, idx]
                roll 1 // Stack: [idx, event]
                
                // Destructure event: (((resp_event, charat_resp), in)
                untuple 2
                push in
                assert_eq
                
                untuple 2
                push super::string_ref::charat_resp
                assert_eq
                
                untuple 2 // Stack: [idx, val, variant]
                
                pick 0 // variant
                push super::string_ref::some
                equal
                branch {
                    drop 0 // drop variant
                    tuple 2 // (idx, ch)
                    push yield_next
                    tuple 2
                } {
                    drop 0 // drop variant
                    drop 0 // drop val (())
                    push yield_done
                    tuple 2
                }
            } {
                pick 0 // tag
                push yield_next
                equal
                branch {
                    // Transition from ((idx, ch), yield_next) to (idx + 1, fetch)
                    drop 0 // drop tag
                    untuple 2 // Stack: [event, idx, ch]
                    drop 0 // drop ch
                    roll 1
                    drop 0 // drop event
                    
                    push 1
                    add
                    
                    push fetch
                    tuple 2 // (idx + 1, fetch)
                } {
                    // Transition from (idx, yield_done) to (idx, done_state)
                    drop 0 // drop tag. Stack: [event, idx]
                    roll 1
                    drop 0 // drop event
                    
                    push done_state
                    tuple 2 // (idx, done_state)
                }
            }
        }
    }

    function is_done {
        untuple 2
        pick 0
        push done_state
        equal
        roll 2
        drop 0
        roll 1
        drop 0
    }

    function is_ready_to_finish {
        untuple 2
        pick 0
        push done_state
        equal
        roll 2
        drop 0
        roll 1
        drop 0
    }
}

symbol copy  "copy"
symbol value "value"
symbol ok    "ok"
symbol err   "err"

mod parseint {
    symbol in           "parseint::in"
    symbol out          "parseint::out"
    symbol idle         "Idle state"
    symbol parsing      "Parsing state"
    symbol yielding_ok  "Yielding ok result state"
    symbol yielding_err "Yielding err result state"

    // init: returns idle state
    function init {
        untuple 0
        push idle
    }

    // accept: takes [state] and returns ValueSet of accepted events.
    function accept {
        pick 0
        push idle
        equal
        branch {
            drop 0
            tuple 0
            push super::copy
            tuple 2 // ((), copy)
            push out
            tuple 2 // (((), copy), out)
            set_singleton
        } {
            untuple 2 // Stack: [payload, tag]
            pick 0 // tag
            push parsing
            equal
            branch {
                drop 0 // drop tag
                drop 0 // drop payload
                
                // Accepts ((ch, next), in) for any ch
                push universal_set
                push super::next
                set_singleton
                set_tuple 2 // {(ch, next)}
                push in
                set_singleton
                set_tuple 2 // {((ch, next), in)}
                
                // Accepts (((), done), in)
                tuple 0
                push super::done
                tuple 2 // ((), done)
                push in
                tuple 2 // (((), done), in)
                set_singleton
                
                set_union
            } {
                pick 0 // tag
                push yielding_ok
                equal
                branch {
                    drop 0
                    drop 0
                    push empty_set
                } {
                    pick 0 // tag
                    push yielding_err
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        panic
                    }
                }
            }
        }
    }

    function tau_reduce {
        push false
        tuple 2
    }

    // emit: takes [state] and returns ValueSet of emitted events.
    function emit {
        pick 0
        push idle
        equal
        branch {
            drop 0
            tuple 0
            push false
            tuple 2
        } {
            untuple 2 // Stack: [payload, tag]
            pick 0 // tag
            push parsing
            equal
            branch {
                drop 0
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                pick 0 // tag
                push yielding_ok
                equal
                branch {
                    // payload is N (the parsed integer)
                    // Emits ((((N, ok), value), out), true)
                    drop 0 // drop tag. Stack: [N]
                    push super::ok
                    tuple 2 // (N, ok)
                    
                    push super::value
                    tuple 2 // ((N, ok), value)
                    
                    push out
                    tuple 2 // (((N, ok), value), out)
                    
                    push true
                    tuple 2
                } {
                    pick 0 // tag
                    push yielding_err
                    equal
                    branch {
                        // Emits (((((), err), value), out), true)
                        drop 0 // drop tag
                        drop 0 // drop payload
                        
                        tuple 0
                        push super::err
                        tuple 2 // ((), err)
                        
                        push super::value
                        tuple 2 // (((), err), value)
                        
                        push out
                        tuple 2 // ((((), err), value), out)
                        
                        push true
                        tuple 2
                    } {
                        panic
                    }
                }
            }
        }
    }

    // process: takes [state, event] and returns next_state.
    function process {
        untuple 2
        // Stack: [state, event]
        pick 1 // state
        push idle
        equal
        branch {
            // State is idle: event is (((), copy), out)
            tuple 0
            push super::copy
            tuple 2
            push out
            tuple 2
            assert_eq
            push idle
            assert_eq
            
            // Init parsing state: ((0, 0), parsing)
            push 0
            push 0
            tuple 2 // (acc=0, count=0)
            push parsing
            tuple 2
        } {
            // State is (payload, tag)
            roll 1 // Stack: [event, state]
            untuple 2 // Stack: [event, payload, tag]
            
            pick 0 // tag
            push yielding_ok
            equal
            branch {
                // Process emission of yielding_ok -> returns idle state
                drop 0 // tag
                drop 0 // payload
                drop 0 // event
                push idle
            } {
                pick 0 // tag
                push yielding_err
                equal
                branch {
                    // Process emission of yielding_err -> returns idle state
                    drop 0 // tag
                    drop 0 // payload
                    drop 0 // event
                    push idle
                } {
                    pick 0 // tag
                    push parsing
                    equal
                    branch {
                        drop 0 // drop tag
                        roll 1 // Stack: [payload, event]
                        
                        untuple 2 // Stack: [payload, inner_event, in]
                        push in
                        assert_eq
                        
                        untuple 2 // Stack: [payload, val, item_tag]
                        roll 2 // Stack: [val, item_tag, payload]
                        untuple 2 // Stack: [val, item_tag, acc, count]
                        
                        pick 2 // item_tag
                        push super::next
                        equal
                        branch {
                            // item_tag == next: val is ch
                            pick 2 // item_tag
                            push super::next
                            assert_eq
                            
                            // Check if ch >= 48 && ch <= 57
                            pick 3 // ch
                            push 48
                            less
                            branch {
                                // ch < 48: non-digit error!
                                drop 0 // count
                                drop 0 // acc
                                drop 0 // item_tag
                                drop 0 // ch
                                tuple 0 // ()
                                push yielding_err
                                tuple 2
                            } {
                                pick 3 // ch
                                push 57
                                greater
                                branch {
                                    // ch > 57: non-digit error!
                                    drop 0
                                    drop 0
                                    drop 0
                                    drop 0
                                    tuple 0
                                    push yielding_err
                                    tuple 2
                                } {
                                    // ch is a digit 0..9
                                    roll 2 // pull item_tag
                                    drop 0 // drop item_tag. Stack: [val, acc, count]
                                    roll 2 // pull ch. Stack: [acc, count, ch]
                                    push 48
                                    sub // digit
                                    
                                    roll 2 // acc
                                    push 10
                                    mul
                                    add // acc' = acc * 10 + digit
                                    
                                    roll 1 // acc', count
                                    push 1
                                    add // count'
                                    
                                    tuple 2 // (acc', count')
                                    push parsing
                                    tuple 2
                                }
                            }
                        } {
                            // Check if item_tag == done
                            pick 2 // item_tag
                            push super::done
                            equal
                            branch {
                                // Stack: [val, item_tag, acc, count]
                                roll 2 // pull item_tag
                                push super::done
                                assert_eq
                                roll 2 // pull val
                                push ()
                                assert_eq
                                
                                // Check if count > 0
                                pick 0 // count
                                push 0
                                greater
                                branch {
                                    drop 0 // count. Stack: [acc]
                                    push yielding_ok
                                    tuple 2 // (acc, yielding_ok)
                                } {
                                    drop 0 // count
                                    drop 0 // acc
                                    tuple 0
                                    push yielding_err
                                    tuple 2 // ((), yielding_err)
                                }
                            } {
                                panic
                            }
                        }
                    } {
                        panic
                    }
                }
            }
        }
    }

    function is_done {
        drop 0
        push false
    }

    function is_ready_to_finish {
        push idle
        equal
    }
}

mod split {
    symbol in                   "split::in"
    symbol out                  "split::out"
    symbol next                 "next"
    symbol start                "start"
    symbol item                 "item"
    symbol end                  "end"
    symbol done                 "done"

    symbol state_idle           "idle"
    symbol state_await_start    "await_start"
    symbol state_yield_start    "yield_start"
    symbol state_yield_item     "yield_item"
    symbol state_await_field    "await_field"
    symbol state_yield_end      "yield_end"
    symbol state_yield_end_done "yield_end_done"
    symbol state_idle_done      "idle_done"
    symbol state_yield_done     "yield_done"
    symbol state_done           "done"

    // init: accepts delim on stack. Returns (delim, state_idle).
    function init {
        push state_idle
        tuple 2
    }

    // accept: takes [state] and returns ValueSet of accepted events.
    function accept {
        untuple 2 // Stack: [payload, tag]
        
        pick 0 // tag
        push state_idle
        equal
        branch {
            drop 0 // drop tag
            drop 0 // drop payload
            
            tuple 0
            push next
            tuple 2
            set_singleton
            push out
            set_singleton
            set_tuple 2
        } {
            pick 0 // tag
            push state_idle_done
            equal
            branch {
                drop 0
                drop 0
                
                tuple 0
                push next
                tuple 2
                set_singleton
                push out
                set_singleton
                set_tuple 2
            } {
                pick 0 // tag
                push state_await_start
                equal
                branch {
                    drop 0
                    drop 0
                    
                    push universal_set
                    push super::next
                    set_singleton
                    set_tuple 2
                    push in
                    set_singleton
                    set_tuple 2
                    
                    tuple 0
                    push super::done
                    tuple 2
                    set_singleton
                    push in
                    set_singleton
                    set_tuple 2
                    
                    set_union
                } {
                    pick 0 // tag
                    push state_await_field
                    equal
                    branch {
                        drop 0
                        drop 0
                        
                        push universal_set
                        push super::next
                        set_singleton
                        set_tuple 2
                        push in
                        set_singleton
                        set_tuple 2
                        
                        tuple 0
                        push super::done
                        tuple 2
                        set_singleton
                        push in
                        set_singleton
                        set_tuple 2
                        
                        set_union
                    } {
                        drop 0
                        drop 0
                        push empty_set
                    }
                }
            }
        }
    }

    function tau_reduce {
        push false
        tuple 2
    }

    // emit: takes [state] and returns ValueSet of emitted events.
    function emit {
        untuple 2 // Stack: [payload, tag]
        
        pick 0 // tag
        push state_yield_start
        equal
        branch {
            // yield_start: emits ((((), start), out), true)
            drop 0
            drop 0
            
            tuple 0
            push start
            tuple 2 // ((), start)
            push out
            tuple 2
            push true
            tuple 2
        } {
            pick 0 // tag
            push state_yield_item
            equal
            branch {
                // yield_item: payload is (delim, ch). Emits ((((ch, next), item), out), true)
                drop 0 // tag. Stack: [(delim, ch)]
                untuple 2 // Stack: [delim, ch]
                roll 1 // Stack: [ch, delim]
                drop 0 // drop delim. Stack: [ch]
                
                push super::next
                tuple 2 // (ch, next)
                push item
                tuple 2
                push out
                tuple 2
                push true
                tuple 2
            } {
                pick 0 // tag
                push state_yield_end
                equal
                branch {
                    // yield_end: emits ((((), end), out), true)
                    drop 0
                    drop 0
                    
                    tuple 0
                    push end
                    tuple 2
                    push out
                    tuple 2
                    push true
                    tuple 2
                } {
                    pick 0 // tag
                    push state_yield_end_done
                    equal
                    branch {
                        // yield_end_done: emits ((((), end), out), true)
                        drop 0
                        drop 0
                        
                        tuple 0
                        push end
                        tuple 2
                        push out
                        tuple 2
                        push true
                        tuple 2
                    } {
                        pick 0 // tag
                        push state_yield_done
                        equal
                        branch {
                            // yield_done: emits ((((), done), out), true)
                            drop 0
                            drop 0
                            
                            tuple 0
                            push done
                            tuple 2
                            push out
                            tuple 2
                            push true
                            tuple 2
                        } {
                            drop 0
                            drop 0
                            tuple 0
                            push false
                            tuple 2
                        }
                    }
                }
            }
        }
    }

    // process: takes [state, event] and returns next_state.
    function process {
        untuple 2
        // Stack: [state, event]
        roll 1 // Stack: [event, state]
        untuple 2 // Stack: [event, payload, tag]
        
        pick 0 // tag
        push state_idle
        equal
        branch {
            // Transition from idle to await_start
            drop 0 // tag. Stack: [event, delim]
            roll 1 // Stack: [delim, event]
            tuple 0
            push next
            tuple 2
            push out
            tuple 2
            assert_eq
            
            push state_await_start
            tuple 2
        } {
            pick 0 // tag
            push state_idle_done
            equal
            branch {
                // Transition from idle_done to yield_done
                drop 0 // tag
                roll 1
                tuple 0
                push next
                tuple 2
                push out
                tuple 2
                assert_eq
                
                push state_yield_done
                tuple 2
            } {
                pick 0 // tag
                push state_await_start
                equal
                branch {
                    drop 0 // tag
                    roll 1 // Stack: [delim, event]
                    
                    untuple 2
                    push in
                    assert_eq
                    
                    untuple 2 // Stack: [delim, val, iter_tag]
                    
                    pick 0 // iter_tag
                    push super::next
                    equal
                    branch {
                        push super::next
                        assert_eq
                        tuple 2 // (delim, ch)
                        push state_yield_start
                        tuple 2
                    } {
                        push super::done
                        assert_eq
                        push ()
                        assert_eq
                        push state_yield_done
                        tuple 2
                    }
                } {
                    pick 0 // tag
                    push state_yield_start
                    equal
                    branch {
                        drop 0 // tag
                        roll 1 // Stack: [payload, event]
                        tuple 0
                        push start
                        tuple 2
                        push out
                        tuple 2
                        assert_eq
                        
                        pick 0 // payload: (delim, ch)
                        untuple 2 // Stack: [(delim, ch), delim, ch]
                        pick 0 // ch
                        pick 2 // delim
                        equal
                        branch {
                            // ch == delim: empty field! Transition to yield_end
                            drop 0
                            drop 0
                            untuple 2
                            drop 0 // drop ch
                            push state_yield_end
                            tuple 2
                        } {
                            // ch != delim: transition to yield_item
                            drop 0
                            drop 0 // leaves (delim, ch)
                            push state_yield_item
                            tuple 2
                        }
                    } {
                        pick 0 // tag
                        push state_yield_item
                        equal
                        branch {
                            drop 0
                            roll 1
                            drop 0 // drop event. Stack: [(delim, ch)]
                            untuple 2
                            drop 0 // drop ch
                            push state_await_field
                            tuple 2
                        } {
                            pick 0 // tag
                            push state_await_field
                            equal
                            branch {
                                drop 0
                                roll 1
                                
                                untuple 2
                                push in
                                assert_eq
                                
                                untuple 2 // Stack: [delim, val, iter_tag]
                                
                                pick 0
                                push super::next
                                equal
                                branch {
                                    push super::next
                                    assert_eq
                                    
                                    pick 0 // ch
                                    pick 2 // delim
                                    equal
                                    branch {
                                        drop 0 // drop ch
                                        push state_yield_end
                                        tuple 2
                                    } {
                                        tuple 2
                                        push state_yield_item
                                        tuple 2
                                    }
                                } {
                                    push super::done
                                    assert_eq
                                    push ()
                                    assert_eq
                                    push state_yield_end_done
                                    tuple 2
                                }
                            } {
                                pick 0
                                push state_yield_end
                                equal
                                branch {
                                    drop 0
                                    roll 1
                                    tuple 0
                                    push end
                                    tuple 2
                                    push out
                                    tuple 2
                                    assert_eq
                                    
                                    push state_idle
                                    tuple 2
                                } {
                                    pick 0
                                    push state_yield_end_done
                                    equal
                                    branch {
                                        drop 0
                                        roll 1
                                        tuple 0
                                        push end
                                        tuple 2
                                        push out
                                        tuple 2
                                        assert_eq
                                        
                                        push state_idle_done
                                        tuple 2
                                    } {
                                        pick 0
                                        push state_yield_done
                                        equal
                                        branch {
                                            drop 0
                                            roll 1
                                            tuple 0
                                            push done
                                            tuple 2
                                            push out
                                            tuple 2
                                            assert_eq
                                            
                                            push state_done
                                            tuple 2
                                        } {
                                            // state_done
                                            drop 0
                                            roll 1
                                            drop 0
                                            push state_done
                                            tuple 2
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    function is_done {
        untuple 2
        pick 0
        push state_done
        equal
        roll 2
        drop 0
        roll 1
        drop 0
    }

    function is_ready_to_finish {
        untuple 2
        pick 0
        push state_idle
        equal
        pick 1
        push state_idle_done
        equal
        or
        pick 1
        push state_done
        equal
        or
        roll 2
        drop 0
        roll 1
        drop 0
    }
}

