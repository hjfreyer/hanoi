    jump string_hidden::emit
    untuple 2
    assert
    push (char_iterator::out, (next, 98))
    assert_eq
    
    push (char_iterator::out, (next, 98))
    jump string_hidden::process
    
    # Step 2: drive 2 taus for 'c' (99)
    jump string_hidden::tau_reduce
    untuple 2
    assert
    jump string_hidden::tau_reduce
    untuple 2
    assert
    
    pick 0
    jump string_hidden::emit
    untuple 2
    assert
    push (char_iterator::out, (next, 99))
    assert_eq
    
    push (char_iterator::out, (next, 99))
    jump string_hidden::process
    
    # Step 3: drive 2 taus for done
    jump string_hidden::tau_reduce
    untuple 2
    assert
    jump string_hidden::tau_reduce
    untuple 2
    assert
    
    pick 0
    jump string_hidden::emit
    untuple 2
    assert
    push (char_iterator::out, (done, ()))
    assert_eq
    
    push (char_iterator::out, (done, ()))
    jump string_hidden::process
    
    # Clean up state from stack
    drop 0
}

