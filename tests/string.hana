mod string_ref_base {
    function init {
        untuple 0
        push super::my_str
        jump super::string_ref::init
    }
    function accept {
        jump super::string_ref::accept
    }
    function tau_reduce {
        jump super::string_ref::tau_reduce
    }
    function emit {
        jump super::string_ref::emit
    }
    function process {
        untuple 2
        tuple 2
        jump super::string_ref::process
    }

    function is_done {
        jump super::string_ref::is_done
    }

    function is_ready_to_finish {
        jump super::string_ref::is_ready_to_finish
    }
}

