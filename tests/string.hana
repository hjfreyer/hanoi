test sentence verify_string_ref {
    // Initialize base unprefixed string_ref with string xyz_str
    push xyz_str
    jump string_ref::init // Stack: [state]
    
    // 1. Test accept set at rest
    pick 0
    jump string_ref::accept // Stack: [state, accept_set]
    
    // Check that it accepts (length, ())
    push (string_ref::length, ())
    pick 1
    set_contains
    assert
    
    // Check that it accepts (charat, 0)
    push (string_ref::charat, 0)
    pick 1
    set_contains
    assert
    
    // Check that it accepts (charat, 5)
    push (string_ref::charat, 5)
    pick 1
    set_contains
    assert
    
    drop 0 // drop accept_set
    
    // 2. Test emit set at rest
    pick 0
    jump string_ref::emit
    untuple 2
    not
    assert
    drop 0
        // 3. Query length -> [state] -> [next_state]
    push (string_ref::length, ())
    tuple 2
    jump string_ref::process
    
    // Now state should be ("xyz", (length_resp, 3))
    // It should emit (length_resp, 3)
    pick 0
    jump string_ref::emit
    untuple 2
    assert
    push (string_ref::length_resp, 3)
    assert_eq
    
    // Process emission event -> transitions back to idle
    push (string_ref::length_resp, 3)
    tuple 2
    jump string_ref::process
    
    // 4. Query charat 1 (in-bounds)
    push (string_ref::charat, 1)
    tuple 2
    jump string_ref::process
    
    // Now state should emit (charat_resp, (some, 121))
    pick 0
    jump string_ref::emit
    untuple 2
    assert
    push (string_ref::charat_resp, (string_ref::some, 121))
    assert_eq
    
    // Process emission event
    push (string_ref::charat_resp, (string_ref::some, 121))
    tuple 2
    jump string_ref::process
    
    // 5. Query charat 5 (out-of-bounds)
    push (string_ref::charat, 5)
    tuple 2
    jump string_ref::process
    
    // Now state should emit (charat_resp, (none, ()))
    pick 0
    jump string_ref::emit
    untuple 2
    assert
    push (string_ref::charat_resp, (string_ref::none, ()))
    assert_eq
    
    // Process emission event
    push (string_ref::charat_resp, (string_ref::none, ()))
    tuple 2
    jump string_ref::process
    
    // Verify final state is ("xyz", idle)
    untuple 2
    push string_ref::idle
    assert_eq
    push xyz_str
    assert_eq
}

