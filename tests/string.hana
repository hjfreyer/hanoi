# String character iterator machine and tests
# Unprefixed string_ref state machine, prefixed_string_ref decorator & CSP char_iterator (hard-coded ports)

symbol next "Next character event"
symbol done "Iteration finished event"

# Base unprefixed string_ref machine
mod string_ref {
    symbol length       "Query string length"
    symbol charat       "Query character at index"
    symbol length_resp  "Response for string length"
    symbol charat_resp  "Response for character at index"
    symbol none         "None option variant"
    symbol some         "Some option variant"
    symbol idle         "Idle state"

    # Initialize with a symbol representing string contents.
    # Expects sym on stack.
    # Returns (sym, idle) state.
    sentence init {
        push idle
        tuple 2
    }
    
    # accept: takes state (sym, internal_state) and returns ValueSet of accepted events.
    # At rest (idle), accepts (length, ()) or (charat, N).
    sentence accept {
        untuple 2 # Stack: [sym, internal_state]
        pick 0 # duplicate internal_state before comparison
        push idle
        equal
        branch {
            # Accept (length, ())
            drop 0 # drop internal_state
            drop 0 # drop sym
            push singleton((length, ()))
            
            # Accept (charat, N) for any N
            push set_tuple(singleton(charat), universal_set)
            set_union
        } {
            # In response state: accepts nothing (empty_set)
            pick 0
            untuple 2 # Stack: [sym, internal_state, resp_tag, resp_val]
            pick 1 # resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                drop 0
                drop 0
                push empty_set
            } {
                pick 1 # resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    drop 0
                    push empty_set
                } {
                    panic
                }
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit: takes state (sym, internal_state) and returns ValueSet of emitted events.
    # In response state, emits internal_state which is (length_resp, len) or (charat_resp, ...).
    sentence emit {
        untuple 2 # Stack: [sym, internal_state]
        pick 0 # duplicate internal_state before comparison
        push idle
        equal
        branch {
            # At rest: emits nothing
            drop 0 # drop internal_state
            drop 0 # drop sym
            tuple 0
            push false
            tuple 2
        } {
            # In response state: internal_state is the response event
            drop 1 # drop sym. Stack: [internal_state]
            pick 0
            untuple 2 # Stack: [internal_state, resp_tag, resp_val]
            pick 1 # resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                push true
                tuple 2
            } {
                pick 1 # resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    push true
                    tuple 2
                } {
                    panic
                }
            }
        }
    }

    # process: takes state and event, returns next_state
    sentence process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 2 # Stack: [event, sym, internal_state]
        
        pick 0
        push idle
        equal
        branch {
            # Case 1: internal_state is idle. We processed a query event (length, ()) or (charat, N).
            drop 0 # drop internal_state. Stack: [event, sym]
            roll 1 # Stack: [sym, event]
            untuple 2 # Stack: [sym, query_type, query_payload]
            
            pick 1 # query_type
            push length
            equal
            branch {
                # length query: query_payload is ()
                drop 0 # drop query_payload (which is ())
                drop 0 # drop query_type. Stack: [sym]
                
                pick 0 # sym
                symbol_len # len
                
                push length_resp
                roll 1
                tuple 2 # (length_resp, len)
                
                tuple 2 # (sym, (length_resp, len))
            } {
                # charat query: query_payload is N
                drop 1 # drop query_type. Stack: [sym, N]
                
                # Check if N < len
                pick 1 # sym
                symbol_len # len
                
                pick 1 # N
                pick 1 # len
                less
                branch {
                    # N < len: return character
                    drop 0 # drop len
                    pick 1 # sym
                    pick 1 # N
                    symbol_char_at # ch
                    
                    push some
                    roll 1
                    tuple 2 # (some, ch)
                    
                    push charat_resp
                    roll 1
                    tuple 2 # (charat_resp, (some, ch))
                    
                    # Clean up N
                    drop 1 # Stack: [sym, (charat_resp, (some, ch))]
                    
                    tuple 2 # (sym, (charat_resp, (some, ch)))
                } {
                    # N >= len: return none
                    drop 0 # drop len
                    drop 0 # drop N. Stack: [sym]
                    
                    push none
                    tuple 0
                    tuple 2 # (none, ())
                    
                    push charat_resp
                    roll 1
                    tuple 2 # (charat_resp, (none, ()))
                    
                    tuple 2 # (sym, (charat_resp, (none, ())))
                }
            }
        } {
            # Case 2: internal_state is not idle. We processed the response event.
            # Transition back to idle.
            # Stack: [event, sym, internal_state]
            drop 0 # drop internal_state
            roll 1 # Stack: [sym, event]
            drop 0 # drop event. Stack: [sym]
            
            push idle
            tuple 2 # (sym, idle)
        }
    }

    sentence is_done {
        drop 0
        push false
    }

    sentence is_ready_to_finish {
        untuple 2
        drop 0
        push idle
        equal
    }
}



mod char_iterator {
    symbol in           "char_iterator::in"
    symbol out          "char_iterator::out"
    symbol fetch        "Fetch charat state"
    symbol await_charat "Await charat response state"
    symbol yield_next   "Yield next character state"
    symbol yield_done   "Yield done state"
    symbol done_state   "Finished iteration state"

    # Initialize char_iterator state.
    # Returns (fetch, 0) state.
    sentence init {
        push fetch
        push 0
        tuple 2 # (fetch, 0)
    }
    
    # accept: takes state (tag, payload) and returns ValueSet of accepted events.
    # Accepts (in, (charat_resp, ...)) when internal_state is (await_charat, idx).
    sentence accept {
        untuple 2 # Stack: [tag, payload]
        pick 1 # tag
        push await_charat
        equal
        branch {
            # In await_charat state: accepts charat_resp on channel "in"
            drop 0 # drop tag
            drop 0 # drop payload
            
            # Construct set of (in, (charat_resp, (some, ch)))
            push in
            set_singleton
            push set_tuple(singleton(super::string_ref::charat_resp), set_tuple(singleton(super::string_ref::some), universal_set))
            set_tuple 2 # set of (in, (charat_resp, (some, ch)))
            
            # Construct set of (in, (charat_resp, (none, ())))
            push in
            set_singleton
            push singleton((super::string_ref::charat_resp, (super::string_ref::none, ())))
            set_tuple 2 # set of (in, (charat_resp, (none, ())))
            
            set_union
        } {
            pick 1 # tag
            push fetch
            equal
            branch {
                drop 0
                drop 0
                push empty_set
            } {
                pick 1 # tag
                push yield_next
                equal
                branch {
                    drop 0
                    drop 0
                    push empty_set
                } {
                    pick 1 # tag
                    push yield_done
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        pick 1 # tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            push empty_set
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit: takes state (tag, payload) and returns ValueSet of emitted events.
    sentence emit {
        untuple 2 # Stack: [tag, payload]
        
        pick 1 # tag
        push fetch
        equal
        branch {
            # fetch state: emits (in, (charat, idx))
            drop 1 # drop tag
            push super::string_ref::charat
            roll 1 # payload is idx
            tuple 2 # (charat, idx)
            
            push in
            roll 1
            tuple 2 # (in, (charat, idx))
            push true
            tuple 2
        } {
            pick 1 # tag
            push yield_next
            equal
            branch {
                # yield_next state: payload is (idx, ch), emits (out, (next, ch))
                drop 1 # drop tag
                untuple 2 # Stack: [idx, ch]
                roll 1 # Stack: [ch, idx]
                drop 0 # drop idx
                
                push super::next
                roll 1 # ch
                tuple 2 # (next, ch)
                
                push out
                roll 1
                tuple 2 # (out, (next, ch))
                push true
                tuple 2
            } {
                pick 1 # tag
                push yield_done
                equal
                branch {
                    # yield_done state: emits (out, (done, ()))
                    drop 0 # drop payload
                    drop 0 # drop tag
                    
                    push super::done
                    tuple 0
                    tuple 2 # (done, ())
                    
                    push out
                    roll 1
                    tuple 2 # (out, (done, ()))
                    push true
                    tuple 2
                } {
                    pick 1 # tag
                    push await_charat
                    equal
                    branch {
                        drop 0
                        drop 0
                        tuple 0
                        push false
                        tuple 2
                    } {
                        pick 1 # tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            tuple 0
                            push false
                            tuple 2
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }
    
    # process: takes state (tag, payload) and event, returns next_state
    sentence process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 2 # Stack: [event, tag, payload]
        
        pick 1 # tag
        push fetch
        equal
        branch {
            # Transition from (fetch, idx) to (await_charat, idx)
            # Stack: [event, tag, payload]
            drop 1 # drop tag
            push await_charat
            roll 1 # payload (idx)
            tuple 2 # (await_charat, idx)
            
            # Stack: [event, (await_charat, idx)]
            roll 1 # moves event to top
            drop 0 # drop event. Stack: [(await_charat, idx)]
        } {
            pick 1 # tag
            push await_charat
            equal
            branch {
                # Transition from (await_charat, idx) to (yield_next, (idx, ch)) or (yield_done, idx)
                # Stack: [event, tag, payload] (payload is idx)
                drop 1 # drop tag. Stack: [event, idx]
                roll 1 # moves event to top. Stack: [idx, event]
                untuple 2 # Stack: [idx, port, resp_event]
                drop 1 # drop port. Stack: [idx, resp_event]
                untuple 2 # Stack: [idx, charat_resp, resp_payload]
                drop 1 # drop charat_resp. Stack: [idx, resp_payload]
                untuple 2 # Stack: [idx, variant, val]
                
                pick 1 # variant
                push super::string_ref::some
                equal
                branch {
                    # Variant is some (val is ch)
                    # Stack: [idx, variant, ch]
                    drop 1 # drop variant. Stack: [idx, ch]
                    tuple 2 # (idx, ch)
                    
                    push yield_next
                    roll 1
                    tuple 2 # (yield_next, (idx, ch))
                } {
                    # Variant is none
                    # Stack: [idx, variant, ()]
                    drop 0 # drop ()
                    drop 0 # drop variant. Stack: [idx]
                    
                    push yield_done
                    roll 1
                    tuple 2 # (yield_done, idx)
                }
            } {
                pick 1 # tag
                push yield_next
                equal
                branch {
                    # Transition from (yield_next, (idx, ch)) to (fetch, idx + 1)
                    # Stack: [event, tag, payload] (payload is (idx, ch))
                    drop 1 # drop tag
                    untuple 2 # Stack: [event, idx, ch]
                    drop 0 # drop ch. Stack: [event, idx]
                    roll 1 # moves event to top
                    drop 0 # drop event. Stack: [idx]
                    
                    push 1
                    add # idx + 1
                    
                    push fetch
                    roll 1
                    tuple 2 # (fetch, idx + 1)
                } {
                    # Transition from (yield_done, idx) to (done_state, idx)
                    # Stack: [event, tag, payload] (payload is idx)
                    drop 1 # drop tag. Stack: [event, idx]
                    roll 1 # moves event to top
                    drop 0 # drop event. Stack: [idx]
                    
                    push done_state
                    roll 1
                    tuple 2 # (done_state, idx)
                }
            }
        }
    }

    sentence is_done {
        untuple 2
        drop 0
        push done_state
        equal
    }

    sentence is_ready_to_finish {
        untuple 2
        drop 0
        push done_state
        equal
    }
}

symbol copy  "copy"
symbol value "value"
symbol ok    "ok"
symbol err   "err"

mod parseint {
    symbol in           "parseint::in"
    symbol out          "parseint::out"
    symbol idle         "Idle state"
    symbol parsing      "Parsing state"
    symbol yielding_ok  "Yielding ok result state"
    symbol yielding_err "Yielding err result state"

    # init: returns idle state
    sentence init {
        push idle
    }

    # accept: takes [state] and returns ValueSet of accepted events.
    # Accepts out.copy when idle, or in.out.next / in.out.done when parsing.
    sentence accept {
        pick 0
        push idle
        equal
        branch {
            # idle: accepts (out, (copy, ()))
            push idle
            assert_eq
            push out
            set_singleton
            push singleton((super::copy, ()))
            set_tuple 2
        } {
            untuple 2 # Stack: [tag, payload]
            pick 1 # tag
            push parsing
            equal
            branch {
                drop 0 # drop payload
                push parsing
                assert_eq
                
                # Accepts (in, (next, ch)) for any ch
                push in
                set_singleton
                push set_tuple(singleton(super::next), universal_set)
                set_tuple 2 # set of (in, (next, ch))
                
                # Accepts (in, (done, ()))
                push in
                set_singleton
                push singleton((super::done, ()))
                set_tuple 2 # set of (in, (done, ()))
                
                set_union
            } {
                pick 1 # tag
                push yielding_ok
                equal
                branch {
                    drop 0
                    push yielding_ok
                    assert_eq
                    push empty_set
                } {
                    pick 1 # tag
                    push yielding_err
                    equal
                    branch {
                        drop 0
                        push yielding_err
                        assert_eq
                        push empty_set
                    } {
                        panic
                    }
                }
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit: takes [state] and returns ValueSet of emitted events.
    # Emits out.value.ok.N or out.value.err when in yielding state.
    sentence emit {
        pick 0
        push idle
        equal
        branch {
            push idle
            assert_eq
            tuple 0
            push false
            tuple 2
        } {
            untuple 2 # Stack: [tag, payload]
            pick 1 # tag
            push parsing
            equal
            branch {
                drop 0
                push parsing
                assert_eq
                tuple 0
                push false
                tuple 2
            } {
                pick 1 # tag
                push yielding_ok
                equal
                branch {
                    # payload is N (the parsed integer)
                    # Emits (out, (value, (ok, N)))
                    drop 1 # drop tag. Stack: [N]
                    push super::ok
                    roll 1 # N
                    tuple 2 # (ok, N)
                    
                    push super::value
                    roll 1
                    tuple 2 # (value, (ok, N))
                    
                    push out
                    roll 1
                    tuple 2 # (out, (value, (ok, N)))
                    
                    push true
                    tuple 2
                } {
                    pick 1 # tag
                    push yielding_err
                    equal
                    branch {
                        # Emits (out, (value, (err, ())))
                        drop 0 # drop payload
                        push yielding_err
                        assert_eq
                        
                        push super::err
                        tuple 0
                        tuple 2 # (err, ())
                        
                        push super::value
                        roll 1
                        tuple 2 # (value, (err, ()))
                        
                        push out
                        roll 1
                        tuple 2 # (out, (value, (err, ())))
                        
                        push true
                        tuple 2
                    } {
                        panic
                    }
                }
            }
        }
    }

    # process: takes [state, event] and returns next_state.
    sentence process {
        # Stack: [state, event]
        pick 1 # state
        push idle
        equal
        branch {
            # State is idle: event is (out, (copy, ()))
            push (out, (super::copy, ()))
            assert_eq
            push idle
            assert_eq
            
            # Init parsing state: (parsing, (0, 0)) -> (acc = 0, count = 0)
            push parsing
            push 0
            push 0
            tuple 2 # (acc=0, count=0)
            tuple 2 # (parsing, (0, 0))
        } {
            # State is (tag, payload)
            roll 1 # Stack: [event, state]
            untuple 2 # Stack: [event, tag, payload]
            
            pick 1 # tag
            push yielding_ok
            equal
            branch {
                # Process emission of yielding_ok -> returns idle state
                drop 0
                push yielding_ok
                assert_eq
                drop 0
                push idle
            } {
                pick 1 # tag
                push yielding_err
                equal
                branch {
                    # Process emission of yielding_err -> returns idle state
                    push ()
                    assert_eq
                    push yielding_err
                    assert_eq
                    push (out, (super::value, (super::err, ())))
                    assert_eq
                    push idle
                } {
                    pick 1 # tag
                    push parsing
                    equal
                    branch {
                        # Stack: [event, tag, payload]
                        drop 1 # drop tag
                        roll 1 # Stack: [payload, event]
                        
                        untuple 2 # Stack: [payload, in_sym, inner_event]
                        drop 1 # drop in_sym. Stack: [payload, inner_event]
                        
                        # inner_event is (item_tag, val)
                        untuple 2 # Stack: [payload, item_tag, val]
                        
                        roll 2 # Stack: [item_tag, val, payload]
                        untuple 2 # Stack: [item_tag, val, acc, count]
                        
                        # Check item_tag
                        pick 3 # item_tag
                        push super::next
                        equal
                        branch {
                            # item_tag == next: val is character codepoint (ch)
                            roll 3 # Stack: [val, acc, count, item_tag]
                            push super::next
                            assert_eq
                            
                            # Check if ch >= 48 && ch <= 57
                            pick 2 # ch
                            push 48
                            less
                            branch {
                                # ch < 48: non-digit error!
                                drop 0
                                drop 0
                                drop 0
                                push yielding_err
                                tuple 0
                                tuple 2 # (yielding_err, ())
                            } {
                                pick 2 # ch
                                push 57
                                greater
                                branch {
                                    # ch > 57: non-digit error!
                                    drop 0
                                    drop 0
                                    drop 0
                                    push yielding_err
                                    tuple 0
                                    tuple 2 # (yielding_err, ())
                                } {
                                    # ch is a digit 0..9
                                    # digit = ch - 48
                                    roll 2 # Stack: [acc, count, ch]
                                    push 48
                                    sub # Stack: [acc, count, digit]
                                    
                                    # acc' = acc * 10 + digit
                                    roll 2 # Stack: [count, digit, acc]
                                    push 10
                                    mul
                                    add # acc' = acc * 10 + digit
                                    
                                    # count' = count + 1
                                    roll 1 # Stack: [acc', count]
                                    push 1
                                    add # count' = count + 1
                                    
                                    tuple 2 # (acc', count')
                                    push parsing
                                    roll 1
                                    tuple 2 # (parsing, (acc', count'))
                                }
                            }
                        } {
                            # Check if item_tag == done
                            pick 3 # item_tag
                            push super::done
                            equal
                            branch {
                                # Stack: [item_tag, val, acc, count]
                                roll 3 # Stack: [val, acc, count, item_tag]
                                push super::done
                                assert_eq
                                roll 2 # Stack: [acc, count, val]
                                push ()
                                assert_eq
                                
                                # Check if count > 0
                                pick 0 # count
                                push 0
                                greater
                                branch {
                                    # count > 0: success! Return (yielding_ok, acc)
                                    drop 0 # drop count. Stack: [acc]
                                    push yielding_ok
                                    roll 1 # acc
                                    tuple 2 # (yielding_ok, acc)
                                } {
                                    # count == 0: empty input error! Return (yielding_err, ())
                                    push 0
                                    assert_eq
                                    drop 0 # drop acc
                                    push yielding_err
                                    tuple 0
                                    tuple 2 # (yielding_err, ())
                                }
                            } {
                                panic
                            }
                        }
                    } {
                        panic
                    }
                }
            }
        }
    }

    sentence is_done {
        drop 0
        push false
    }

    sentence is_ready_to_finish {
        push idle
        equal
    }
}

mod split {
    symbol in                   "split::in"
    symbol out                  "split::out"
    symbol next                 "next"
    symbol start                "start"
    symbol item                 "item"
    symbol end                  "end"
    symbol done                 "done"

    symbol state_idle           "idle"
    symbol state_await_start    "await_start"
    symbol state_yield_start    "yield_start"
    symbol state_yield_item     "yield_item"
    symbol state_await_field    "await_field"
    symbol state_yield_end      "yield_end"
    symbol state_yield_end_done "yield_end_done"
    symbol state_idle_done      "idle_done"
    symbol state_yield_done     "yield_done"
    symbol state_done           "done"

    # init: accepts delim on stack. Returns (state_idle, delim).
    sentence init {
        push state_idle
        roll 1
        tuple 2
    }

    # accept: takes [state] and returns ValueSet of accepted events.
    sentence accept {
        untuple 2 # Stack: [tag, payload]
        
        pick 1 # tag
        push state_idle
        equal
        branch {
            # idle: accepts (out, (next, ()))
            drop 0 # drop payload
            push state_idle
            assert_eq
            
            push out
            set_singleton
            push singleton((next, ()))
            set_tuple 2
        } {
            pick 1 # tag
            push state_idle_done
            equal
            branch {
                # idle_done: accepts (out, (next, ()))
                drop 0
                push state_idle_done
                assert_eq
                
                push out
                set_singleton
                push singleton((next, ()))
                set_tuple 2
            } {
                pick 1 # tag
                push state_await_start
                equal
                branch {
                    # await_start: accepts (in, (next, ch)) or (in, (done, ()))
                    drop 0
                    push state_await_start
                    assert_eq
                    
                    push in
                    set_singleton
                    push set_tuple(singleton(super::next), universal_set)
                    set_tuple 2
                    
                    push in
                    set_singleton
                    push singleton((super::done, ()))
                    set_tuple 2
                    
                    set_union
                } {
                    pick 1 # tag
                    push state_await_field
                    equal
                    branch {
                        # await_field: accepts (in, (next, ch)) or (in, (done, ()))
                        drop 0
                        push state_await_field
                        assert_eq
                        
                        push in
                        set_singleton
                        push set_tuple(singleton(super::next), universal_set)
                        set_tuple 2
                        
                        push in
                        set_singleton
                        push singleton((super::done, ()))
                        set_tuple 2
                        
                        set_union
                    } {
                        drop 0
                        drop 0
                        push empty_set
                    }
                }
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit: takes [state] and returns ValueSet of emitted events.
    sentence emit {
        untuple 2 # Stack: [tag, payload]
        
        pick 1 # tag
        push state_yield_start
        equal
        branch {
            # yield_start: emits (out, (start, ()))
            drop 0 # drop payload
            push state_yield_start
            assert_eq
            
            push start
            tuple 0
            tuple 2 # (start, ())
            
            push out
            roll 1
            tuple 2 # (out, (start, ()))
            push true
            tuple 2
        } {
            pick 1 # tag
            push state_yield_item
            equal
            branch {
                # yield_item: payload is (delim, ch). Emits (out, (item, (next, ch)))
                drop 1 # drop tag. Stack: [(delim, ch)]
                untuple 2 # Stack: [delim, ch]
                roll 1
                drop 0 # drop delim. Stack: [ch]
                
                push super::next
                roll 1 # ch
                tuple 2 # (next, ch)
                
                push item
                roll 1
                tuple 2 # (item, (next, ch))
                
                push out
                roll 1
                tuple 2 # (out, (item, (next, ch)))
                push true
                tuple 2
            } {
                pick 1 # tag
                push state_yield_end
                equal
                branch {
                    # yield_end: emits (out, (end, ()))
                    drop 0
                    push state_yield_end
                    assert_eq
                    
                    push end
                    tuple 0
                    tuple 2 # (end, ())
                    
                    push out
                    roll 1
                    tuple 2 # (out, (end, ()))
                    push true
                    tuple 2
                } {
                    pick 1 # tag
                    push state_yield_end_done
                    equal
                    branch {
                        # yield_end_done: emits (out, (end, ()))
                        drop 0
                        push state_yield_end_done
                        assert_eq
                        
                        push end
                        tuple 0
                        tuple 2 # (end, ())
                        
                        push out
                        roll 1
                        tuple 2 # (out, (end, ()))
                        push true
                        tuple 2
                    } {
                        pick 1 # tag
                        push state_yield_done
                        equal
                        branch {
                            # yield_done: emits (out, (done, ()))
                            drop 0
                            push state_yield_done
                            assert_eq
                            
                            push done
                            tuple 0
                            tuple 2 # (done, ())
                            
                            push out
                            roll 1
                            tuple 2 # (out, (done, ()))
                            push true
                            tuple 2
                        } {
                            drop 0
                            drop 0
                            tuple 0
                            push false
                            tuple 2
                        }
                    }
                }
            }
        }
    }

    # process: takes [state, event] and returns next_state.
    sentence process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 2 # Stack: [event, tag, payload]
        
        pick 1 # tag
        push state_idle
        equal
        branch {
            # Transition from idle to await_start
            drop 1 # drop tag
            roll 1 # Stack: [delim, event]
            push (out, (next, ()))
            assert_eq
            
            push state_await_start
            roll 1 # delim
            tuple 2 # (state_await_start, delim)
        } {
            pick 1 # tag
            push state_idle_done
            equal
            branch {
                # Transition from idle_done to yield_done
                drop 1 # drop tag
                roll 1 # Stack: [delim, event]
                push (out, (next, ()))
                assert_eq
                
                push state_yield_done
                roll 1 # delim
                tuple 2 # (state_yield_done, delim)
            } {
                pick 1 # tag
                push state_await_start
                equal
                branch {
                    # Process event on in in state_await_start
                    drop 1 # drop tag
                    roll 1 # Stack: [delim, event]
                    
                    untuple 2 # Stack: [delim, in_sym, inner_event]
                    drop 1 # drop in_sym. Stack: [delim, inner_event]
                    
                    untuple 2 # Stack: [delim, iter_tag, val]
                    
                    pick 1 # iter_tag
                    push super::next
                    equal
                    branch {
                        # iter_tag == next: val is ch
                        # Stack: [delim, iter_tag, ch]
                        roll 1 # Stack: [delim, ch, iter_tag]
                        push super::next
                        assert_eq
                        tuple 2 # (delim, ch)
                        
                        push state_yield_start
                        roll 1
                        tuple 2 # (state_yield_start, (delim, ch))
                    } {
                        # iter_tag == done: val is ()
                        # Stack: [delim, iter_tag, ()]
                        push ()
                        assert_eq
                        push super::done
                        assert_eq
                        
                        push state_yield_done
                        roll 1
                        tuple 2 # (state_yield_done, delim)
                    }
                } {
                    pick 1 # tag
                    push state_yield_start
                    equal
                    branch {
                        # Process emission of start
                        drop 1 # drop tag
                        roll 1 # Stack: [payload, event]
                        push (out, (start, ()))
                        assert_eq
                        
                        pick 0
                        untuple 2 # Stack: [(delim, ch), delim, ch]
                        pick 0 # ch
                        pick 2 # delim
                        equal
                        branch {
                            # ch == delim: empty field! Transition to yield_end
                            drop 0 # drop ch
                            drop 0 # drop delim
                            untuple 2 # Stack: [delim, ch]
                            drop 0 # drop ch. Stack: [delim]
                            
                            push state_yield_end
                            roll 1
                            tuple 2 # (state_yield_end, delim)
                        } {
                            # ch != delim: transition to yield_item
                            drop 0 # drop ch
                            drop 0 # drop delim. Stack: [(delim, ch)]
                            
                            push state_yield_item
                            roll 1
                            tuple 2 # (state_yield_item, (delim, ch))
                        }
                    } {
                        pick 1 # tag
                        push state_yield_item
                        equal
                        branch {
                            # Process emission of item
                            drop 1 # drop tag
                            roll 1 # Stack: [payload, event]
                            drop 0 # drop event. Stack: [(delim, ch)]
                            untuple 2 # Stack: [delim, ch]
                            drop 0 # drop ch. Stack: [delim]
                            
                            push state_await_field
                            roll 1
                            tuple 2 # (state_await_field, delim)
                        } {
                            pick 1 # tag
                            push state_await_field
                            equal
                            branch {
                                # Process event on in in state_await_field
                                drop 1 # drop tag
                                roll 1 # Stack: [delim, event]
                                
                                untuple 2 # Stack: [delim, in_sym, inner_event]
                                drop 1 # drop in_sym. Stack: [delim, inner_event]
                                
                                untuple 2 # Stack: [delim, iter_tag, val]
                                
                                pick 1 # iter_tag
                                push super::next
                                equal
                                branch {
                                    # iter_tag == next: val is ch
                                    # Stack: [delim, iter_tag, ch]
                                    roll 1 # Stack: [delim, ch, iter_tag]
                                    push super::next
                                    assert_eq
                                    
                                    # Check if ch == delim
                                    pick 0 # ch
                                    pick 2 # delim
                                    equal
                                    branch {
                                        # ch == delim: end of field!
                                        drop 0 # drop ch
                                        
                                        push state_yield_end
                                        roll 1 # delim
                                        tuple 2 # (state_yield_end, delim)
                                    } {
                                        # ch != delim: another item!
                                        tuple 2 # (delim, ch)
                                        
                                        push state_yield_item
                                        roll 1
                                        tuple 2 # (state_yield_item, (delim, ch))
                                    }
                                } {
                                    # iter_tag == done: end of field (and stream)!
                                    # Stack: [delim, iter_tag, ()]
                                    push ()
                                    assert_eq
                                    push super::done
                                    assert_eq
                                    
                                    push state_yield_end_done
                                    roll 1
                                    tuple 2 # (state_yield_end_done, delim)
                                }
                            } {
                                pick 1 # tag
                                push state_yield_end
                                equal
                                branch {
                                    # Process emission of end -> transition to idle
                                    drop 1 # drop tag
                                    roll 1 # Stack: [delim, event]
                                    push (out, (end, ()))
                                    assert_eq
                                    
                                    push state_idle
                                    roll 1
                                    tuple 2 # (state_idle, delim)
                                } {
                                    pick 1 # tag
                                    push state_yield_end_done
                                    equal
                                    branch {
                                        # Process emission of end -> transition to idle_done
                                        drop 1 # drop tag
                                        roll 1 # Stack: [delim, event]
                                        push (out, (end, ()))
                                        assert_eq
                                        
                                        push state_idle_done
                                        roll 1
                                        tuple 2 # (state_idle_done, delim)
                                    } {
                                        pick 1 # tag
                                        push state_yield_done
                                        equal
                                        branch {
                                            # Process emission of done -> transition to done
                                            drop 1 # drop tag
                                            roll 1 # Stack: [delim, event]
                                            push (out, (done, ()))
                                            assert_eq
                                            
                                            push state_done
                                            roll 1
                                            tuple 2 # (state_done, delim)
                                        } {
                                            # state_done or error
                                            drop 1 # drop tag
                                            roll 1 # Stack: [delim, event]
                                            drop 0 # drop event
                                            
                                            push state_done
                                            roll 1
                                            tuple 2 # (state_done, delim)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    sentence is_done {
        untuple 2
        drop 0
        push state_done
        equal
    }

    sentence is_ready_to_finish {
        untuple 2
        drop 0
        pick 0
        push state_idle
        equal
        pick 1
        push state_idle_done
        equal
        or
        roll 1
        push state_done
        equal
        or
    }
}

symbol my_str "abc"
symbol empty_str ""
symbol cafe_str "café"
symbol xyz_str "xyz"
symbol str_123 "123"
symbol str_45a "45a"

mod string_ref_base {
    sentence init {
        push super::my_str
        jump super::string_ref::init
    }
    sentence accept {
        jump super::string_ref::accept
    }
    sentence tau_reduce {
        jump super::string_ref::tau_reduce
    }
    sentence emit {
        jump super::string_ref::emit
    }
    sentence process {
        jump super::string_ref::process
    }

    sentence is_done {
        jump super::string_ref::is_done
    }

    sentence is_ready_to_finish {
        jump super::string_ref::is_ready_to_finish
    }
}

sentence sync_char_iterator_in {
    push set_tuple(singleton(char_iterator::in), universal_set)
}

mod string_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(string_ref_base, char_iterator::in),
        char_iterator,
        sync_char_iterator_in
    ),
    sync_char_iterator_in
);

