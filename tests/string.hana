# String character iterator machine and tests
# Unprefixed string_ref state machine, prefixed_string_ref decorator & CSP char_iterator (hard-coded ports)

symbol next "Next character event"
symbol done "Iteration finished event"

symbol in   "in"
symbol out  "out"

# Base unprefixed string_ref machine
mod string_ref {
    symbol length       "Query string length"
    symbol charat       "Query character at index"
    symbol length_resp  "Response for string length"
    symbol charat_resp  "Response for character at index"
    symbol none         "None option variant"
    symbol some         "Some option variant"
    symbol idle         "Idle state"

    # Initialize with a symbol representing string contents.
    # Expects sym on stack.
    # Returns (sym, idle) state.
    init {
        push idle
        tuple 2
    }
    
    # accept: takes state (sym, internal_state) and returns ValueSet of accepted events.
    # At rest (idle), accepts (length, ()) or (charat, N).
    accept {
        untuple 2 # Stack: [sym, internal_state]
        pick 0 # duplicate internal_state before comparison
        push idle
        equal
        branch {
            # Accept (length, ())
            drop 0 # drop internal_state
            drop 0 # drop sym
            push singleton((length, ()))
            
            # Accept (charat, N) for any N
            push set_tuple(singleton(charat), universal_set)
            set_union
        } {
            # In response state: accepts nothing (empty_set)
            pick 0
            untuple 2 # Stack: [sym, internal_state, resp_tag, resp_val]
            pick 1 # resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                drop 0
                drop 0
                push empty_set
            } {
                pick 1 # resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    drop 0
                    push empty_set
                } {
                    panic
                }
            }
        }
    }

    # emit: takes state (sym, internal_state) and returns ValueSet of emitted events.
    # In response state, emits internal_state which is (length_resp, len) or (charat_resp, ...).
    emit {
        untuple 2 # Stack: [sym, internal_state]
        pick 0 # duplicate internal_state before comparison
        push idle
        equal
        branch {
            # At rest: emits nothing
            drop 0 # drop internal_state
            drop 0 # drop sym
            push empty_set
        } {
            # In response state: internal_state is the response event
            drop 1 # drop sym. Stack: [internal_state]
            pick 0
            untuple 2 # Stack: [internal_state, resp_tag, resp_val]
            pick 1 # resp_tag
            push length_resp
            equal
            branch {
                drop 0
                drop 0
                set_singleton
            } {
                pick 1 # resp_tag
                push charat_resp
                equal
                branch {
                    drop 0
                    drop 0
                    set_singleton
                } {
                    panic
                }
            }
        }
    }

    # process: takes state and event, returns next_state
    process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 2 # Stack: [event, sym, internal_state]
        
        pick 0
        push idle
        equal
        branch {
            # Case 1: internal_state is idle. We processed a query event (length, ()) or (charat, N).
            drop 0 # drop internal_state. Stack: [event, sym]
            roll 1 # Stack: [sym, event]
            untuple 2 # Stack: [sym, query_type, query_payload]
            
            pick 1 # query_type
            push length
            equal
            branch {
                # length query: query_payload is ()
                drop 0 # drop query_payload (which is ())
                drop 0 # drop query_type. Stack: [sym]
                
                pick 0 # sym
                symbol_len # len
                
                push length_resp
                roll 1
                tuple 2 # (length_resp, len)
                
                tuple 2 # (sym, (length_resp, len))
            } {
                # charat query: query_payload is N
                drop 1 # drop query_type. Stack: [sym, N]
                
                # Check if N < len
                pick 1 # sym
                symbol_len # len
                
                pick 1 # N
                pick 1 # len
                less
                branch {
                    # N < len: return character
                    drop 0 # drop len
                    pick 1 # sym
                    pick 1 # N
                    symbol_char_at # ch
                    
                    push some
                    roll 1
                    tuple 2 # (some, ch)
                    
                    push charat_resp
                    roll 1
                    tuple 2 # (charat_resp, (some, ch))
                    
                    # Clean up N
                    drop 1 # Stack: [sym, (charat_resp, (some, ch))]
                    
                    tuple 2 # (sym, (charat_resp, (some, ch)))
                } {
                    # N >= len: return none
                    drop 0 # drop len
                    drop 0 # drop N. Stack: [sym]
                    
                    push none
                    tuple 0
                    tuple 2 # (none, ())
                    
                    push charat_resp
                    roll 1
                    tuple 2 # (charat_resp, (none, ()))
                    
                    tuple 2 # (sym, (charat_resp, (none, ())))
                }
            }
        } {
            # Case 2: internal_state is not idle. We processed the response event.
            # Transition back to idle.
            # Stack: [event, sym, internal_state]
            drop 0 # drop internal_state
            roll 1 # Stack: [sym, event]
            drop 0 # drop event. Stack: [sym]
            
            push idle
            tuple 2 # (sym, idle)
        }
    }
}



mod char_iterator {
    symbol fetch        "Fetch charat state"
    symbol await_charat "Await charat response state"
    symbol yield_next   "Yield next character state"
    symbol yield_done   "Yield done state"
    symbol done_state   "Finished iteration state"

    # Initialize char_iterator state.
    # Returns (fetch, 0) state.
    init {
        push fetch
        push 0
        tuple 2 # (fetch, 0)
    }
    
    # accept: takes state (tag, payload) and returns ValueSet of accepted events.
    # Accepts (in, (charat_resp, ...)) when internal_state is (await_charat, idx).
    accept {
        untuple 2 # Stack: [tag, payload]
        pick 1 # tag
        push await_charat
        equal
        branch {
            # In await_charat state: accepts charat_resp on channel "in"
            drop 0 # drop tag
            drop 0 # drop payload
            
            # Construct set of (in, (charat_resp, (some, ch)))
            push super::in
            set_singleton
            push set_tuple(singleton(super::string_ref::charat_resp), set_tuple(singleton(super::string_ref::some), universal_set))
            set_tuple 2 # set of (in, (charat_resp, (some, ch)))
            
            # Construct set of (in, (charat_resp, (none, ())))
            push super::in
            set_singleton
            push singleton((super::string_ref::charat_resp, (super::string_ref::none, ())))
            set_tuple 2 # set of (in, (charat_resp, (none, ())))
            
            set_union
        } {
            pick 1 # tag
            push fetch
            equal
            branch {
                drop 0
                drop 0
                push empty_set
            } {
                pick 1 # tag
                push yield_next
                equal
                branch {
                    drop 0
                    drop 0
                    push empty_set
                } {
                    pick 1 # tag
                    push yield_done
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        pick 1 # tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            push empty_set
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }

    # emit: takes state (tag, payload) and returns ValueSet of emitted events.
    emit {
        untuple 2 # Stack: [tag, payload]
        
        pick 1 # tag
        push fetch
        equal
        branch {
            # fetch state: emits (in, (charat, idx))
            drop 1 # drop tag
            push super::string_ref::charat
            roll 1 # payload is idx
            tuple 2 # (charat, idx)
            
            push super::in
            roll 1
            tuple 2 # (in, (charat, idx))
            set_singleton
        } {
            pick 1 # tag
            push yield_next
            equal
            branch {
                # yield_next state: payload is (idx, ch), emits (out, (next, ch))
                drop 1 # drop tag
                untuple 2 # Stack: [idx, ch]
                roll 1 # Stack: [ch, idx]
                drop 0 # drop idx
                
                push super::next
                roll 1 # ch
                tuple 2 # (next, ch)
                
                push super::out
                roll 1
                tuple 2 # (out, (next, ch))
                set_singleton
            } {
                pick 1 # tag
                push yield_done
                equal
                branch {
                    # yield_done state: emits (out, (done, ()))
                    drop 0 # drop payload
                    drop 0 # drop tag
                    
                    push super::done
                    tuple 0
                    tuple 2 # (done, ())
                    
                    push super::out
                    roll 1
                    tuple 2 # (out, (done, ()))
                    set_singleton
                } {
                    pick 1 # tag
                    push await_charat
                    equal
                    branch {
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        pick 1 # tag
                        push done_state
                        equal
                        branch {
                            drop 0
                            drop 0
                            push empty_set
                        } {
                            panic
                        }
                    }
                }
            }
        }
    }
    
    # process: takes state (tag, payload) and event, returns next_state
    process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 2 # Stack: [event, tag, payload]
        
        pick 1 # tag
        push fetch
        equal
        branch {
            # Transition from (fetch, idx) to (await_charat, idx)
            # Stack: [event, tag, payload]
            drop 1 # drop tag
            push await_charat
            roll 1 # payload (idx)
            tuple 2 # (await_charat, idx)
            
            # Stack: [event, (await_charat, idx)]
            roll 1 # moves event to top
            drop 0 # drop event. Stack: [(await_charat, idx)]
        } {
            pick 1 # tag
            push await_charat
            equal
            branch {
                # Transition from (await_charat, idx) to (yield_next, (idx, ch)) or (yield_done, idx)
                # Stack: [event, tag, payload] (payload is idx)
                drop 1 # drop tag. Stack: [event, idx]
                roll 1 # moves event to top. Stack: [idx, event]
                untuple 2 # Stack: [idx, port, resp_event]
                drop 1 # drop port. Stack: [idx, resp_event]
                untuple 2 # Stack: [idx, charat_resp, resp_payload]
                drop 1 # drop charat_resp. Stack: [idx, resp_payload]
                untuple 2 # Stack: [idx, variant, val]
                
                pick 1 # variant
                push super::string_ref::some
                equal
                branch {
                    # Variant is some (val is ch)
                    # Stack: [idx, variant, ch]
                    drop 1 # drop variant. Stack: [idx, ch]
                    tuple 2 # (idx, ch)
                    
                    push yield_next
                    roll 1
                    tuple 2 # (yield_next, (idx, ch))
                } {
                    # Variant is none
                    # Stack: [idx, variant, ()]
                    drop 0 # drop ()
                    drop 0 # drop variant. Stack: [idx]
                    
                    push yield_done
                    roll 1
                    tuple 2 # (yield_done, idx)
                }
            } {
                pick 1 # tag
                push yield_next
                equal
                branch {
                    # Transition from (yield_next, (idx, ch)) to (fetch, idx + 1)
                    # Stack: [event, tag, payload] (payload is (idx, ch))
                    drop 1 # drop tag
                    untuple 2 # Stack: [event, idx, ch]
                    drop 0 # drop ch. Stack: [event, idx]
                    roll 1 # moves event to top
                    drop 0 # drop event. Stack: [idx]
                    
                    push 1
                    add # idx + 1
                    
                    push fetch
                    roll 1
                    tuple 2 # (fetch, idx + 1)
                } {
                    # Transition from (yield_done, idx) to (done_state, idx)
                    # Stack: [event, tag, payload] (payload is idx)
                    drop 1 # drop tag. Stack: [event, idx]
                    roll 1 # moves event to top
                    drop 0 # drop event. Stack: [idx]
                    
                    push done_state
                    roll 1
                    tuple 2 # (done_state, idx)
                }
            }
        }
    }
}

symbol my_str "abc"
symbol empty_str ""
symbol cafe_str "café"
symbol xyz_str "xyz"

mod string_ref_base {
    init {
        push super::my_str
        jump super::string_ref::init
    }
    accept {
        jump super::string_ref::accept
    }
    emit {
        jump super::string_ref::emit
    }
    process {
        jump super::string_ref::process
    }
}

sync_in {
    push set_tuple(singleton(in), universal_set)
}

mod string_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(string_ref_base, in),
        char_iterator,
        sync_in
    ),
    sync_in
);

test iterate_string_ascii {
    # Initialize system -> [((my_str, idle), (fetch, 0))]
    jump string_hidden::init
    
    # Step 0: drive tau (charat request)
    push crate::prelude::event::tau
    jump string_hidden::process
    
    # drive tau (charat response)
    push crate::prelude::event::tau
    jump string_hidden::process
    
    # Check emitted iterator event: (out, (next, 97)) ('a')
    pick 0
    jump string_hidden::emit
    push (out, (next, 97))
    roll 1
    set_contains
    assert
    
    # Process iterator event
    push (out, (next, 97))
    jump string_hidden::process
    
    # Step 1: drive 2 taus for 'b' (98)
    push crate::prelude::event::tau
    jump string_hidden::process
    push crate::prelude::event::tau
    jump string_hidden::process
    
    pick 0
    jump string_hidden::emit
    push (out, (next, 98))
    roll 1
    set_contains
    assert
    
    push (out, (next, 98))
    jump string_hidden::process
    
    # Step 2: drive 2 taus for 'c' (99)
    push crate::prelude::event::tau
    jump string_hidden::process
    push crate::prelude::event::tau
    jump string_hidden::process
    
    pick 0
    jump string_hidden::emit
    push (out, (next, 99))
    roll 1
    set_contains
    assert
    
    push (out, (next, 99))
    jump string_hidden::process
    
    # Step 3: drive 2 taus for done
    push crate::prelude::event::tau
    jump string_hidden::process
    push crate::prelude::event::tau
    jump string_hidden::process
    
    pick 0
    jump string_hidden::emit
    push (out, (done, ()))
    roll 1
    set_contains
    assert
    
    push (out, (done, ()))
    jump string_hidden::process
    
    # Clean up state from stack
    drop 0
}

test verify_string_ref {
    # Initialize base unprefixed string_ref with string xyz_str
    push xyz_str
    jump string_ref::init # Stack: [state]
    
    # 1. Test accept set at rest
    pick 0
    jump string_ref::accept # Stack: [state, accept_set]
    
    # Check that it accepts (length, ())
    push (string_ref::length, ())
    pick 1
    set_contains
    assert
    
    # Check that it accepts (charat, 0)
    push (string_ref::charat, 0)
    pick 1
    set_contains
    assert
    
    # Check that it accepts (charat, 5)
    push (string_ref::charat, 5)
    pick 1
    set_contains
    assert
    
    drop 0 # drop accept_set
    
    # 2. Test emit set at rest
    pick 0
    jump string_ref::emit # Stack: [state, emit_set]
    push empty_set
    assert_eq
    
    # 3. Query length -> [state] -> [next_state]
    push (string_ref::length, ())
    jump string_ref::process
    
    # Now state should be ("xyz", (length_resp, 3))
    # It should emit (length_resp, 3)
    pick 0
    jump string_ref::emit # Stack: [state, emit_set]
    push (string_ref::length_resp, 3)
    roll 1
    set_contains
    assert
    
    # Process emission event -> transitions back to idle
    push (string_ref::length_resp, 3)
    jump string_ref::process
    
    # 4. Query charat 1 (in-bounds)
    push (string_ref::charat, 1)
    jump string_ref::process
    
    # Now state should emit (charat_resp, (some, 121))
    pick 0
    jump string_ref::emit
    push (string_ref::charat_resp, (string_ref::some, 121))
    roll 1
    set_contains
    assert
    
    push (string_ref::charat_resp, (string_ref::some, 121))
    jump string_ref::process
    
    # 5. Query charat 5 (out-of-bounds)
    push (string_ref::charat, 5)
    jump string_ref::process
    
    # Now state should emit (charat_resp, (none, ()))
    pick 0
    jump string_ref::emit
    push (string_ref::charat_resp, (string_ref::none, ()))
    roll 1
    set_contains
    assert
    
    push (string_ref::charat_resp, (string_ref::none, ()))
    jump string_ref::process
    
    # Verify final state is ("xyz", idle)
    untuple 2
    push string_ref::idle
    assert_eq
    push xyz_str
    assert_eq
}

mod xyz_string_ref_base {
    init {
        push super::xyz_str
        jump super::string_ref::init
    }
    accept {
        jump super::string_ref::accept
    }
    emit {
        jump super::string_ref::emit
    }
    process {
        jump super::string_ref::process
    }
}

mod xyz_string_ref_instance compose_prefix(xyz_string_ref_base, in);

test verify_prefixed_string_ref {
    # Initialize xyz_string_ref_instance
    jump xyz_string_ref_instance::init # Stack: [state]
    
    # 1. Test accept set at rest on channel in
    pick 0
    jump xyz_string_ref_instance::accept # Stack: [state, accept_set]
    
    push (in, (string_ref::length, ()))
    pick 1
    set_contains
    assert
    
    push (in, (string_ref::charat, 0))
    pick 1
    set_contains
    assert
    
    drop 0 # drop accept_set
    
    # 2. Query charat 1
    push (in, (string_ref::charat, 1))
    jump xyz_string_ref_instance::process
    
    # Verify emission of (in, (charat_resp, (some, 121)))
    pick 0
    jump xyz_string_ref_instance::emit
    push (in, (string_ref::charat_resp, (string_ref::some, 121)))
    roll 1
    set_contains
    assert
    
    # Process emission back to idle
    push (in, (string_ref::charat_resp, (string_ref::some, 121)))
    jump xyz_string_ref_instance::process
    
    # Verify state is (xyz_str, idle)
    untuple 2
    push string_ref::idle
    assert_eq
    push xyz_str
    assert_eq
}

mod empty_string_ref_base {
    init {
        push super::empty_str
        jump super::string_ref::init
    }
    accept {
        jump super::string_ref::accept
    }
    emit {
        jump super::string_ref::emit
    }
    process {
        jump super::string_ref::process
    }
}

mod empty_string_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(empty_string_ref_base, in),
        char_iterator,
        sync_in
    ),
    sync_in
);

test iterate_empty {
    jump empty_string_hidden::init
    
    # Drive 2 taus (charat query + charat_resp)
    push crate::prelude::event::tau
    jump empty_string_hidden::process
    push crate::prelude::event::tau
    jump empty_string_hidden::process
    
    # Check emitted iterator event: (out, (done, ()))
    pick 0
    jump empty_string_hidden::emit
    push (out, (done, ()))
    roll 1
    set_contains
    assert
    
    push (out, (done, ()))
    jump empty_string_hidden::process
    
    drop 0
}

mod cafe_string_ref_base {
    init {
        push super::cafe_str
        jump super::string_ref::init
    }
    accept {
        jump super::string_ref::accept
    }
    emit {
        jump super::string_ref::emit
    }
    process {
        jump super::string_ref::process
    }
}

mod cafe_string_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(cafe_string_ref_base, in),
