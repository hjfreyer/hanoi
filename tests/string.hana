    // Process emission event
    push ((121, string_ref::some), string_ref::charat_resp)
    roll 1
    tuple 2
    jump string_ref::process
    
    // 5. Query charat 5 (out-of-bounds)
    push (5, string_ref::charat)
    roll 1
    tuple 2
    jump string_ref::process
    
    // Now state should emit (((), none), charat_resp)
    pick 0
    jump string_ref::emit
    untuple 2
    assert
    assert
    push (((), string_ref::none), string_ref::charat_resp)
    test_assert_eq
    
    // Process emission event
    push (((), string_ref::none), string_ref::charat_resp)
