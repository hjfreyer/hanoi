symbol input0 "39472"

sentence sync_char_iterator_in {
    push set_tuple(singleton(crate::string::char_iterator::in), universal_set)
}

sentence sync_parseint_in {
    push set_tuple(singleton(crate::string::parseint::in), universal_set)
}

mod input0_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(compose_static_closure(crate::string::string_ref, input0), crate::string::char_iterator::in),
        crate::string::char_iterator,
        sync_char_iterator_in
    ),
    sync_char_iterator_in
);

test mod test0 compose_hidden(
    compose_concurrent(
        crate::string::parseint,
        compose_rename_prefix(crate::string::char_iterator::out, crate::string::parseint::in, input0_hidden),
        sync_parseint_in
    ),
    sync_parseint_in
);

sentence run_tau_reductions {
    # Stack: [state]
    pick 0
    jump test0::tau_reduce
    untuple 2 # Stack: [state, next_state, did_change]
    branch {
        # did_change is true: drop the old state and loop with next_state
        roll 1
        drop 0
        jump run_tau_reductions
    } {
        # did_change is false: drop the next_state, keep old state and return
        drop 0
    }
}

test sentence verify_day1_manually {
    jump test0::init
    
    # Trigger start: process copy event
    push (crate::string::parseint::out, (crate::string::copy, ()))
    jump test0::process
    
    # Run all tau reductions recursively
    jump run_tau_reductions
    
    # Assert that it emitted the correct result
    pick 0
    jump test0::emit
    untuple 2
    assert # assert has_event is true
    push (crate::string::parseint::out, (crate::string::value, (crate::string::ok, 39472)))
    assert_eq
    
    # Process the emitted event to transition to final state
    push (crate::string::parseint::out, (crate::string::value, (crate::string::ok, 39472)))
    jump test0::process
    
    # Check is_done
    pick 0
    jump test0::is_done
    assert
    
    drop 0
}
