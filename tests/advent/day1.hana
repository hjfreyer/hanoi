        } {
            pick 1
            push 3
            equal
            branch {
                # Phase is 3. Emit fail.
                drop 0
                drop 0
                push crate::prelude::fail
                push true
                tuple 2
            } {
                # Other phase, no emit.
                drop 0
                drop 0
                tuple 0
                push false
                tuple 2
            }
        }
    }

    export sentence process {
        # Stack: [state, event]
        roll 1
        untuple 2
        # Stack: [event, phase, sut_state] (sut_state is index 0)
        pick 1
        push 0
        equal
        branch {
            # Phase 0: expect start event. Initialize SUT.
            roll 2 # event
            push crate::prelude::start
            assert_eq
            drop 0 # drop sut_state
            drop 0 # drop phase
            
            # sut_state = sut::init
            jump super::sut::init
            
            # Transition SUT with start event: (crate::string::parseint::out, (crate::string::copy, ()))
            push crate::string::parseint::out
            push crate::string::copy
            push ()
            tuple 2
            tuple 2
            jump super::sut::process
            
            # Now we have [new_sut_state]
            push 1 # phase
            roll 1 # new_sut_state
            tuple 2
        } {
            pick 1
            push 2
            equal
            branch {
                # Phase 2: expect pass event.
                roll 2 # event
                push crate::prelude::pass
                assert_eq
                drop 0 # drop sut_state
                drop 0 # drop phase
                push 4
                push ()
                tuple 2
            } {
                pick 1
                push 3
                equal
                branch {
                    # Phase 3: expect fail event.
                    roll 2 # event
                    push crate::prelude::fail
                    assert_eq
                    drop 0 # drop sut_state
                    drop 0 # drop phase
                    push 4
                    push ()
                    tuple 2
                } {
                    # Other phase, do nothing.
                    roll 2
