symbol input0 "39472"

sentence sync_char_iterator_in {
    push set_tuple(singleton(crate::string::char_iterator::in), universal_set)
}

sentence sync_parseint_in {
    push set_tuple(singleton(crate::string::parseint::in), universal_set)
}

mod input0_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(compose_static_closure(crate::string::string_ref, input0), crate::string::char_iterator::in),
        crate::string::char_iterator,
        sync_char_iterator_in
    ),
    sync_char_iterator_in
);

mod sut compose_hidden(
    compose_concurrent(
        crate::string::parseint,
        compose_rename_prefix(crate::string::char_iterator::out, crate::string::parseint::in, input0_hidden),
        sync_parseint_in
    ),
    sync_parseint_in
);

# Parameterized validator machine that receives SUT output event
mod verify_payload {
    export sentence init {
        # Stack: [event_value]
        # Event is (parseint::out, (value, payload))
        untuple 2
        roll 1
        drop 0 # drop out channel
        untuple 2
        roll 1
        drop 0 # drop value tag
        # Stack: [payload]
        
        # Check if payload is (ok, 39472)
        push crate::string::ok
        push 39472
        tuple 2
        equal
        branch {
            push 0 # state 0: correct payload
        } {
            push 1 # state 1: incorrect payload
        }
    }

    export sentence accept {
        drop 0
        push empty_set
    }

    export sentence tau_reduce {
        push false
        tuple 2
    }

    export sentence emit {
        # Stack: [state]
        pick 0
        push 0
        equal
        branch {
            drop 0
            push crate::prelude::pass
            push true
            tuple 2
        } {
            pick 0
            push 1
            equal
            branch {
                drop 0
                push crate::prelude::fail
                push true
                tuple 2
            } {
                drop 0
                tuple 0
                push false
                tuple 2
            }
        }
    }

    export sentence process {
        # Stack: [state, event] (event top)
        drop 0 # drop event
        drop 0 # drop state
        push 2 # done state
    }

    export sentence is_done {
        push 2
        equal
    }

    export sentence is_ready_to_finish {
        drop 0
        push false
    }
}

sentence SUT_outputs {
    push set_tuple(singleton(crate::string::parseint::out), universal_set)
}

mod verify_sut compose_accept(SUT_outputs, verify_payload);

mod harness_body compose_emit_static(
    (crate::string::parseint::out, (crate::string::copy, ())),
    verify_sut
);

mod harness compose_accept_static(
    crate::prelude::start,
    harness_body
);

sentence sync_set {
    push union(
        singleton((crate::string::parseint::out, (crate::string::copy, ()))),
        set_tuple(singleton(crate::string::parseint::out), universal_set)
    )
}

mod sut_and_harness compose_concurrent(sut, harness, sync_set);

test mod test0 compose_hidden(sut_and_harness, sync_set);

sentence run_tau_reductions {
    # Stack: [state]
    pick 0
    jump test0::tau_reduce
    untuple 2 # Stack: [state, next_state, did_change]
    branch {
        # did_change is true: drop the old state and loop with next_state
        roll 1
        drop 0
        jump run_tau_reductions
    } {
        # did_change is false: drop the next_state, keep old state and return
        drop 0
    }
}

test sentence verify_day1_manually {
    jump test0::init
    
    # Trigger start: process start event
    push crate::prelude::start
    jump test0::process
    
    # Run all tau reductions recursively
    jump run_tau_reductions
    
    # Assert that it emitted the pass event
    pick 0
    jump test0::emit
    untuple 2
    assert # assert has_event is true
    push crate::prelude::pass
    assert_eq
    
    # Process the emitted event to transition to final state
    push crate::prelude::pass
    jump test0::process
    
    # Check is_done
    pick 0
    jump test0::is_done
    assert
    
    drop 0
}
