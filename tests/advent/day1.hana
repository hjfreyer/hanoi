sentence run_tau_reductions {
    # Stack: [state]
    pick 0
    jump test0::tau_reduce
    untuple 2 # Stack: [state, next_state, did_change]
    branch {
        # did_change is true: drop the old state and loop with next_state
        roll 1
        drop 0
        jump run_tau_reductions
    } {
        # did_change is false: drop the next_state, keep old state and return
        drop 0
    }
}

test sentence verify_day1_manually {
    jump test0::init
    
    # Trigger start: process start event
    push crate::prelude::start
    jump test0::process
    
    # Run all tau reductions recursively
    jump run_tau_reductions
    
    # Assert that it emitted the pass event
    pick 0
    jump test0::emit
    untuple 2
    assert # assert has_event is true
    push crate::prelude::pass
    assert_eq
    
    # Process the emitted event to transition to final state
    push crate::prelude::pass
    jump test0::process
    
    # Check is_done
    pick 0
    jump test0::is_done
    assert
    
    drop 0
}
