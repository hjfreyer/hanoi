// Sample sentences for the safety checker described in docs/typecheck.md.
// Nothing runs them; they are here to be compiled and, one day, proved about.
//
// The fallible instructions below drop the flag they leave rather than
// asserting on it: each sentence's answer is whatever the instruction
// computed, junk or not, and a checker's job would be to prove the junk case
// unreachable. See docs/totality.md.

symbol latte
symbol espresso

#[arity(2, 2)]
sentence test_swap {
    pick 1
    drop 2
}

#[arity(2, 1)]
sentence test_arith {
    add
    drop 0
    push 10
    multiply
    drop 0
}

function test_branch {
    push true
    branch {
        push 100
    } {
        push 200
    }
    add
    drop 0
}

#[arity(2, 1)]
sentence test_symbol {
    const_string_char_at
    drop 0
}

#[arity(2, 1)]
sentence test_tuples {
    tuple 2
    untuple 2
    drop 0
    subtract
    drop 0
}

function swap_pair {
    untuple 2
    branch {
        roll 1
        tuple 2
    } {
        // Not a pair: there is nothing to swap, so hand back what came in.
        drop 0
    }
}

function test_double_swap {
    jump swap_pair
    jump swap_pair
}

function test_is_int {
    is_int
}

function test_is_bool {
    is_bool
}

function test_is_symbol {
    is_symbol
}

function test_is_tuple {
    is_tuple
}

function test_tuple_length {
    tuple_length
    drop 0
}
