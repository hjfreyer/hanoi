sentence test_tuples {
    tuple 2
    untuple 2
    assert
    subtract
    assert
}

function swap_pair {
    untuple 2
    assert
    roll 1
    tuple 2
}

function test_double_swap {
    jump swap_pair
    jump swap_pair
}

