# Queue CSP State Machine driven by tau reductions

symbol push_back            "Push element event"
symbol pop_front            "Pop element event"
symbol pop_front_resp       "Pop response event"
symbol await_front          "Await element event"

symbol idle                 "Idle state"
symbol descending           "Descending stage"
symbol rebuilding           "Rebuilding stage"
symbol awaiting_push        "Awaiting push stage"
symbol awaiting_front_resp  "Awaiting front response state"
symbol pop_front_resp_await "Pop response state while awaiting"
symbol done                 "Done stage"

mod queue {
    # init: takes no arguments and returns state [(idle, (), (), ())]
    sentence init {
        push super::idle
        push ()
        push ()
        push ()
        tuple 4
    }

    # accept: takes [state] and returns ValueSet of accepted events
    sentence accept {
        # Stack: [state]
        untuple 4
        # Stack: [tag, current, accumulator, new_el]
        
        pick 3 # tag
        push super::idle
        equal
        branch {
            # Idle: accept push, pop, and await requests
            drop 0
            drop 0
            drop 0
            drop 0 # Clean up
            
            # push_back set: (push_back, val)
            push super::push_back
            set_singleton
            push universal_set
            set_tuple 2
            
            # pop_front.req set: (pop_front, (req, ()))
            push super::pop_front
            set_singleton
            push super::super::prelude::req
            tuple 0
            tuple 2
            set_singleton
            set_tuple 2
            set_union
            
            # await_front.req set: (await_front, (req, ()))
            push super::await_front
            set_singleton
            push super::super::prelude::req
            tuple 0
            tuple 2
            set_singleton
            set_tuple 2
            set_union
        } {
            pick 3 # tag
            push super::awaiting_push
            equal
            branch {
                drop 0
                drop 0
                drop 0
                drop 0 # Clean up
                
                # push_back set: (push_back, val)
                push super::push_back
                set_singleton
                push universal_set
                set_tuple 2
                
                # pop_front.req set: (pop_front, (req, ()))
                push super::pop_front
                set_singleton
                push super::super::prelude::req
                tuple 0
                tuple 2
                set_singleton
                set_tuple 2
                set_union
            } {
                # Check if tag is pop_front_resp, pop_front_resp_await, or awaiting_front_resp
                pick 3 # tag
                push super::pop_front_resp
                equal
                pick 4 # tag
                push super::pop_front_resp_await
                equal
                or
                pick 4 # tag
                push super::awaiting_front_resp
                equal
                or
                branch {
                    # In response states, we accept the exact response we emit
                    tuple 4 # [state]
                    jump super::queue::emit
                    untuple 2
                    branch {
                        set_singleton
                    } {
                        drop 0
                        push empty_set
                    }
                } {
                    drop 0
                    drop 0
                    drop 0
                    drop 0
                    push empty_set
                }
            }
        }
    }

    # emit: takes [state] and returns (event, has_event)
    sentence emit {
        # Stack: [state]
        untuple 4
        # Stack: [tag, current, accumulator, new_el]
        
        pick 3 # tag
        push super::pop_front_resp
        equal
        pick 4 # tag
        push super::pop_front_resp_await
        equal
        or
        branch {
            # Emit (pop_front, (resp, payload)) where payload is stored in accumulator
            # Stack: [tag, current, accumulator, new_el]
            pick 1 # accumulator
            push super::super::prelude::resp
            roll 1
            tuple 2 # (resp, payload)
            
            push super::pop_front
            roll 1
            tuple 2 # (pop_front, (resp, payload))
            push true
            tuple 2
            
            drop 1
            drop 1
            drop 1
            drop 1 # Clean up
        } {
            pick 3 # tag
            push super::awaiting_front_resp
            equal
            branch {
                # Emit (await_front, (resp, payload)) where payload is stored in accumulator
                # Stack: [tag, current, accumulator, new_el]
                pick 1 # accumulator
                push super::super::prelude::resp
                roll 1
                tuple 2 # (resp, payload)
                
                push super::await_front
                roll 1
                tuple 2 # (await_front, (resp, payload))
                push true
                tuple 2
                
                drop 1
                drop 1
                drop 1
                drop 1 # Clean up
            } {
                drop 0
                drop 0
                drop 0
                drop 0
                tuple 0
                push false
                tuple 2
            }
        }
    }

    # process: takes [state, event] and returns next_state
    sentence process {
        # Stack: [state, event]
        roll 1 # Stack: [event, state]
        untuple 4
        # Stack: [event, tag, current, accumulator, new_el]
        
        pick 3 # tag
        push super::idle
        equal
        branch {
            # Processing in idle state: event is (push, val), (pop, ()), or (await, ())
            drop 3 # drop tag. Stack: [event, current, accumulator, new_el]
            roll 3 # Stack: [current, accumulator, new_el, event]
            untuple 2
            # Stack: [current, accumulator, new_el, type, payload]
            
            pick 1 # type
            push super::push_back
            equal
            branch {
                # PUSH: payload is val
                drop 1 # drop type. Stack: [current, accumulator, new_el, val]
                drop 1 # drop new_el (which is ()). Stack: [current, accumulator, val]
                drop 1 # drop accumulator (which is ()). Stack: [current, val]
                
                # We transition to descending stage
                # State should be: (descending, current, (), val)
                push super::descending
                roll 2  # Stack: [val, descending, current]
                roll 2  # Stack: [descending, current, val]
                push () # Stack: [descending, current, val, ()]
                roll 1  # Stack: [descending, current, (), val]
                tuple 4 # [next_state]
            } {
                pick 1 # type
                push super::pop_front
                equal
                branch {
                    # POP: payload is ()
                    drop 1 # drop type
                    drop 0 # drop payload (()). Stack: [current, accumulator, new_el]
                    
                    # Check if current (queue) is ()
                    pick 2 # current. Stack: [current, accumulator, new_el, current]
                    push ()
                    equal
                    branch {
                        # Queue is empty: transition to pop_front_resp with none option
                        # State: (pop_front_resp, (), (none, ()), ())
                        drop 0
                        drop 0
                        drop 0 # drop current, accumulator, new_el
                        push super::pop_front_resp
                        push ()
                        
                        # Construct (none, ())
                        push super::super::prelude::none
                        tuple 0
                        tuple 2
                        
                        push ()
                        tuple 4 # [next_state]
                    } {
                        # Queue is NOT empty: current is (head, rest)
                        pick 2 # current. Stack: [current, accumulator, new_el, current]
                        untuple 2 # Stack: [current, accumulator, new_el, head, rest]
                        
                        # Next state is (pop_front_resp, rest, (some, (head, ())), ())
                        roll 1 # Stack: [..., rest, head]
                        
                        # Construct (some, (head, ()))
                        push super::super::prelude::some
                        roll 1
                        tuple 0
                        tuple 2
                        tuple 2
                        
                        push ()
                        push super::pop_front_resp
                        roll 3
                        roll 3
                        roll 3
                        tuple 4 # [next_state]
                        
                        # Clean up
                        drop 1
                        drop 1
                        drop 1
                    }
                } {
                    # AWAIT: payload is ()
                    drop 1 # drop type
                    drop 0 # drop payload (()). Stack: [current, accumulator, new_el]
                    
                    # Check if current (queue) is ()
                    pick 2 # current. Stack: [current, accumulator, new_el, current]
                    push ()
                    equal
                    branch {
                        # Queue is empty: transition to awaiting_push
                        drop 0
                        drop 0
                        drop 0
                        push super::awaiting_push
                        push ()
                        push ()
                        push ()
                        tuple 4
                    } {
                        # Queue is NOT empty: current is (head, rest)
                        pick 2 # current. Stack: [current, accumulator, new_el, current]
                        untuple 2 # Stack: [current, accumulator, new_el, head, rest]
                        
                        # Next state is (awaiting_front_resp, rest, (some, (head, ())), ())
                        roll 1 # Stack: [..., rest, head]
                        
                        # Construct (some, (head, ()))
                        push super::super::prelude::some
                        roll 1
                        tuple 0
                        tuple 2
                        tuple 2
                        
                        push ()
                        push super::awaiting_front_resp
                        roll 3
                        roll 3
                        roll 3
                        tuple 4 # [next_state]
                        
                        # Clean up
                        drop 1
                        drop 1
                        drop 1
                    }
                }
            }
        } {
            pick 3 # tag
            push super::awaiting_push
            equal
            branch {
                # Processing in awaiting_push state: event is (push_back, val) or (pop_front, ())
                drop 3 # drop tag. Stack: [event, current, accumulator, new_el]
                roll 3 # Stack: [current, accumulator, new_el, event]
                untuple 2
                # Stack: [current, accumulator, new_el, type, payload]
                
                pick 1 # type
                push super::pop_front
                equal
                branch {
                    # POP: payload is ()
                    drop 1
                    drop 0 # drop type and payload. Stack: [current, accumulator, new_el]
                    drop 0
                    drop 0
                    drop 0 # drop current, accumulator, new_el
                    
                    push super::pop_front_resp_await
                    push ()
                    
                    # Construct (none, ())
                    push super::super::prelude::none
                    tuple 0
                    tuple 2
                    
                    push ()
                    tuple 4 # [next_state]
                } {
                    # PUSH: payload is val
                    drop 1 # drop type. Stack: [current, accumulator, new_el, val]
                    drop 1 # drop new_el (which is ()). Stack: [current, accumulator, val]
                    drop 1 # drop accumulator (which is ()). Stack: [current, val]
                    drop 1 # drop current (which is ()). Stack: [val]
                    
                    # Transition directly to awaiting_front_resp
                    push super::awaiting_front_resp
                    roll 1
                    push ()
                    push super::super::prelude::some
                    roll 2 # Stack: [awaiting_front_resp, (), some, val]
                    push ()
                    tuple 2
                    tuple 2
                    push ()
                    tuple 4 # [next_state]
                }
            } {
                # Check if it is a response state
                pick 3 # tag
                push super::pop_front_resp
                equal
                pick 4 # tag
                push super::awaiting_front_resp
                equal
                or
                branch {
                    # Return to idle state: next state is (idle, current, (), ())
                    push super::idle
                    pick 3 # current
                    push ()
                    push ()
                    tuple 4 # next_state
                    
                    # Clean up
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                } {
                    pick 3 # tag
                    push super::pop_front_resp_await
                    equal
                    branch {
                        # Return to awaiting_push state: next state is (awaiting_push, (), (), ())
                        push super::awaiting_push
                        push ()
                        push ()
                        push ()
                        tuple 4 # next_state
                        
                        # Clean up
                        drop 1
                        drop 1
                        drop 1
                        drop 1
                        drop 1
                    } {
                        # No transition
                        drop 0
                        drop 0
                        drop 0
                        drop 0
                        drop 0
                        push ()
                    }
                }
            }
        }
    }

    # tau_reduce: takes [state] and returns (new_state, changed)
    sentence tau_reduce {
        # Stack: [state]
        pick 0 # duplicate state. Stack: [state, state]
        untuple 4
        # Stack: [state, tag, current, accumulator, new_el]
        
        # Check if tag is descending
        pick 3 # tag
        push super::descending
        equal
        branch {
            # Stage is descending:
            pick 2 # current. Stack: [state, tag, current, accumulator, new_el, current]
            push ()
            equal
            branch {
                # current is ()
                pick 0  # Stack: [state, tag, current, accumulator, new_el, new_el]
                push () # Stack: [state, tag, current, accumulator, new_el, new_el, ()]
                tuple 2 # Stack: [state, tag, current, accumulator, new_el, new_current]
                push super::rebuilding
                roll 1  # Stack: [state, tag, current, accumulator, new_el, rebuilding, new_current]
                pick 3  # Stack: [state, tag, current, accumulator, new_el, rebuilding, new_current, accumulator]
                pick 3  # Stack: [state, tag, current, accumulator, new_el, rebuilding, new_current, accumulator, new_el]
                tuple 4 # Stack: [state, tag, current, accumulator, new_el, new_state]
                push true
                tuple 2 # Stack: [state, tag, current, accumulator, new_el, (new_state, true)]
                drop 1
                drop 1
                drop 1
                drop 1
                drop 1
            } {
                # current is NOT ()
                pick 2  # Stack: [state, tag, current, accumulator, new_el, current]
                untuple 2 # Stack: [state, tag, current, accumulator, new_el, head, rest]
                roll 1  # Stack: [state, tag, current, accumulator, new_el, rest, head]
                pick 3  # Stack: [state, tag, current, accumulator, new_el, rest, head, accumulator]
                tuple 2 # Stack: [state, tag, current, accumulator, new_el, rest, new_accumulator]
                push super::descending
                roll 2  # Stack: [state, tag, current, accumulator, new_el, new_accumulator, descending, rest]
                roll 2  # Stack: [state, tag, current, accumulator, new_el, descending, rest, new_accumulator]
                pick 3  # Stack: [state, tag, current, accumulator, new_el, descending, rest, new_accumulator, new_el]
                tuple 4 # Stack: [state, tag, current, accumulator, new_el, new_state]
                push true
                tuple 2 # Stack: [state, tag, current, accumulator, new_el, (new_state, true)]
                drop 1
                drop 1
                drop 1
                drop 1
                drop 1
            }
        } {
            # Check if tag is rebuilding
            pick 3 # tag
            push super::rebuilding
            equal
            branch {
                # Stage is rebuilding:
                pick 1 # accumulator. Stack: [state, tag, current, accumulator, new_el, accumulator]
                push ()
                equal
                branch {
                    # accumulator is () -> Transition to idle
                    push super::idle
                    pick 3  # Stack: [state, tag, current, accumulator, new_el, idle, current]
                    push () # Stack: [state, tag, current, accumulator, new_el, idle, current, ()]
                    push () # Stack: [state, tag, current, accumulator, new_el, idle, current, (), ()]
                    tuple 4 # Stack: [state, tag, current, accumulator, new_el, new_state]
                    push true
                    tuple 2 # Stack: [state, tag, current, accumulator, new_el, (new_state, true)]
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                } {
                    # accumulator is NOT ()
                    pick 1  # Stack: [state, tag, current, accumulator, new_el, accumulator]
                    untuple 2 # Stack: [state, tag, current, accumulator, new_el, head, rest_acc]
                    pick 4  # Stack: [state, tag, current, accumulator, new_el, head, rest_acc, current]
                    roll 2  # Stack: [state, tag, current, accumulator, new_el, rest_acc, current, head]
                    roll 1  # Stack: [state, tag, current, accumulator, new_el, rest_acc, head, current]
                    tuple 2 # Stack: [state, tag, current, accumulator, new_el, rest_acc, new_current]
                    push super::rebuilding
                    roll 2
                    roll 2
                    roll 1
                    pick 3
                    tuple 4 # [new_state]
                    push true
                    tuple 2 # Stack: [state, tag, current, accumulator, new_el, (new_state, true)]
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                }
            } {
                # Stage is idle / done / response (no transition):
                pick 4 # get original state. Stack: [state, tag, current, accumulator, new_el, state]
                push false
                tuple 2 # Stack: [state, tag, current, accumulator, new_el, (state, false)]
                drop 1
                drop 1
                drop 1
                drop 1
                drop 1
            }
        }
    }

    sentence is_done {
        drop 0
        push false
    }

    sentence is_ready_to_finish {
        untuple 4
        pick 3
        push super::idle
        equal
        roll 4
        drop 0
        roll 3
        drop 0
        roll 2
        drop 0
        roll 1
        drop 0
    }
}

# Helper to drive the queue's tau reductions in tests
sentence drive_reductions {
    # Stack: [state]
    pick 0
    jump queue::tau_reduce
    # Stack: [state, (new_state, changed)]
    untuple 2
    # Stack: [state, new_state, changed]
    branch {
        drop 1 # drop old state. Stack: [new_state]
        jump drive_reductions
    } {
        drop 0 # drop new_state. Stack: [state]
    }
}

test sentence verify_queue_machine {
    jump queue::init
    
    # 2. Push 10
    push (push_back, 10)
    jump queue::process
    jump drive_reductions
    
    # 3. Push 20
    push (push_back, 20)
    jump queue::process
    jump drive_reductions
    
    # 4. Pop (should yield 10)
    push (pop_front, (super::prelude::req, ()))
    jump queue::process
    jump drive_reductions
    
    # Check emitted event: (pop_front, (resp, (some, (10, ()))))
    pick 0
    jump queue::emit
    untuple 2
    assert
    push (pop_front, (super::prelude::resp, (super::prelude::some, (10, ()))))
    assert_eq
    
    # Process emitted event to return to idle
    push (pop_front, (super::prelude::resp, (super::prelude::some, (10, ()))))
    jump queue::process
    
    # 5. Pop (should yield 20)
    push (pop_front, (super::prelude::req, ()))
    jump queue::process
    jump drive_reductions
    
    pick 0
    jump queue::emit
    untuple 2
    assert
    push (pop_front, (super::prelude::resp, (super::prelude::some, (20, ()))))
    assert_eq
    
    push (pop_front, (super::prelude::resp, (super::prelude::some, (20, ()))))
    jump queue::process
    
    # 6. Pop on empty queue (should yield pop_front.resp.none)
    push (pop_front, (super::prelude::req, ()))
    jump queue::process
    jump drive_reductions
    
    pick 0
    jump queue::emit
    untuple 2
    assert
    push (pop_front, (super::prelude::resp, (super::prelude::none, ())))
    assert_eq
    
    push (pop_front, (super::prelude::resp, (super::prelude::none, ())))
    jump queue::process
    
    # 7. Await front on empty queue (yields awaiting_push state)
    push (await_front, (super::prelude::req, ()))
    jump queue::process
    
    # Check that we can pop even when awaiting!
    # Awaiting queue should accept pop_front.req
    pick 0
    jump queue::accept
    push (pop_front, (super::prelude::req, ()))
    roll 1
    set_contains
    assert
    
    # Process pop_front.req on awaiting queue (transitions to pop_front_resp_await)
    push (pop_front, (super::prelude::req, ()))
    jump queue::process
    
    # Check emitted event: (pop_front, (resp, (none, ())))
    pick 0
    jump queue::emit
    untuple 2
    assert
    push (pop_front, (super::prelude::resp, (super::prelude::none, ())))
    assert_eq
    
    # Process emitted event to return to awaiting_push state
    push (pop_front, (super::prelude::resp, (super::prelude::none, ())))
    jump queue::process
    
    # Push 100 on the awaiting queue
    push (push_back, 100)
    jump queue::process
    jump drive_reductions
    
    # Check that queue is in awaiting_front_resp state and emits await_front.resp
    pick 0
    jump queue::emit
    untuple 2
    assert
    push (await_front, (super::prelude::resp, (super::prelude::some, (100, ()))))
    assert_eq
    
    # Process await_front.resp to return to idle
    push (await_front, (super::prelude::resp, (super::prelude::some, (100, ()))))
    jump queue::process
    
    drop 0 # clean up state
}
