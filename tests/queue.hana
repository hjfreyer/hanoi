symbol idle      "Queue is idle"
symbol descending "Element is descending in queue"
symbol rebuilding "Queue is rebuilding after pop"
symbol awaiting_push "Queue is empty and awaiting a push"
symbol pop_front_resp "Popped element is ready to be emitted"
symbol pop_front_resp_await "Popped element from await is ready"
symbol awaiting_front_resp "Front element is ready for waiting listener"

symbol push_back "Push element to back of queue"
symbol pop_front "Pop element from front of queue"
symbol await_front "Wait for front element of queue"

mod queue {
    // State represents a queue of elements.
    // It is a 4-tuple: (current, accumulator, new_el, tag)

    // init: returns initial state
    function init {
        untuple 0
        push ()
        push ()
        push ()
        push super::idle
        tuple 4
    }

    // accept: takes [state] and returns ValueSet of accepted events
    function accept {
        // Stack: [state]
        untuple 4
        // Stack: [current, accumulator, new_el, tag]
        
        pick 0
        push super::idle
        equal
        branch {
            drop 0
            drop 0
            drop 0
            drop 0
            
            // push_back set: (val, push_back)
            push universal_set
            push super::push_back
            set_singleton
            set_tuple 2
            
            // pop_front.req set: (((), req), pop_front)
            tuple 0
            push super::super::prelude::req
            tuple 2
            set_singleton
            push super::pop_front
            set_singleton
            set_tuple 2
            set_union
            
            // await_front.req set: (((), req), await_front)
            tuple 0
            push super::super::prelude::req
            tuple 2
            set_singleton
            push super::await_front
            set_singleton
            set_tuple 2
            set_union
        } {
            pick 0 // tag
            push super::awaiting_push
            equal
            branch {
                drop 0
                drop 0
                drop 0
                drop 0
                
                // push_back set: (val, push_back)
                push universal_set
                push super::push_back
                set_singleton
                set_tuple 2
                
                // pop_front.req set: (((), req), pop_front)
                tuple 0
                push super::super::prelude::req
                tuple 2
                set_singleton
                push super::pop_front
                set_singleton
                set_tuple 2
                set_union
            } {
                pick 0 // tag
                push super::pop_front_resp
                equal
                pick 1 // tag
                push super::pop_front_resp_await
                equal
                or
                pick 1 // tag
                push super::awaiting_front_resp
                equal
                or
                branch {
                    // Stack: [current, accumulator, new_el, tag]
                    tuple 4 // [state]
                    jump super::queue::emit
                    untuple 2
                    branch {
                        set_singleton
                    } {
                        drop 0
                        push empty_set
                    }
                } {
                    drop 0
                    drop 0
                    drop 0
                    drop 0
                    push empty_set
                }
            }
        }
    }

    // emit: takes [state] and returns (event, has_event)
    function emit {
        // Stack: [state]
        untuple 4
        // Stack: [current, accumulator, new_el, tag]
        
        pick 0 // tag
        push super::pop_front_resp
        equal
        pick 1 // tag
        push super::pop_front_resp_await
        equal
        or
        branch {
            // Emit ((accumulator, resp), pop_front)
            pick 2 // accumulator
            push super::super::prelude::resp
            tuple 2 // (accumulator, resp)
            push super::pop_front
            tuple 2 // ((accumulator, resp), pop_front)
            push true
            tuple 2
            
            // Clean up stack below top
            drop 1
            drop 1
            drop 1
            drop 1
        } {
            pick 0 // tag
            push super::awaiting_front_resp
            equal
            branch {
                // Emit ((accumulator, resp), await_front)
                pick 2 // accumulator
                push super::super::prelude::resp
                tuple 2 // (accumulator, resp)
                push super::await_front
                tuple 2 // ((accumulator, resp), await_front)
                push true
                tuple 2
                
                // Clean up stack below top
                drop 1
                drop 1
                drop 1
                drop 1
            } {
                // Emit nothing
                tuple 0
                push false
                tuple 2
                
                // Clean up stack below top
                drop 1
                drop 1
                drop 1
                drop 1
            }
        }
    }

    // process: takes [state, event] and returns next_state
    sentence process {
        // Stack: [state, event]
        roll 1 // Stack: [event, state]
        untuple 4
        // Stack: [event, current, accumulator, new_el, tag]
        
        pick 0 // tag
        push super::idle
        equal
        branch {
            // Processing in idle state
            drop 0 // drop tag. Stack: [event, current, accumulator, new_el]
            drop 0 // drop new_el. Stack: [event, current, accumulator]
            drop 0 // drop accumulator. Stack: [event, current]
            
            roll 1 // Stack: [current, event]
            untuple 2 // Stack: [current, payload, type]
            
            pick 0 // type
            push super::push_back
            equal
            branch {
                // PUSH: payload is val
                drop 0 // drop type. Stack: [current, val]
                push ()
                roll 1 // Stack: [val, (), current]
                push super::descending
                tuple 4
            } {
                pick 0 // type
                push super::pop_front
                equal
                branch {
                    // POP: payload is ((), req)
                    drop 0 // drop type
                    tuple 0
                    push super::super::prelude::req
                    tuple 2
                    assert_eq
                    
                    pick 0 // current
                    push ()
                    equal
                    branch {
                        drop 0 // drop current
                        push () // rest
                        tuple 0
                        push super::super::prelude::none
                        tuple 2 // ((), none)
                        push () // new_el
                        push super::pop_front_resp
                        tuple 4
                    } {
                        untuple 2 // Stack: [head, rest]
                        roll 1 // Stack: [rest, head]
                        push ()
                        tuple 2 // (head, ())
                        push super::super::prelude::some
                        tuple 2 // ((head, ()), some)
                        push ()
                        push super::pop_front_resp
                        tuple 4
                    }
                } {
                    // AWAIT: payload is ((), req)
                    drop 0 // drop type
                    tuple 0
                    push super::super::prelude::req
                    tuple 2
                    assert_eq
                    
                    pick 0 // current
                    push ()
                    equal
                    branch {
                        drop 0
                        push ()
                        push ()
                        push ()
                        push super::awaiting_push
                        tuple 4
                    } {
                        untuple 2 // Stack: [head, rest]
                        roll 1 // Stack: [rest, head]
                        push ()
                        tuple 2 // (head, ())
                        push super::super::prelude::some
                        tuple 2 // ((head, ()), some)
                        push ()
                        push super::awaiting_front_resp
                        tuple 4
                    }
                }
            }
        } {
            pick 0 // tag
            push super::awaiting_push
            equal
            branch {
                // Processing in awaiting_push state
                drop 0 // drop tag. Stack: [event, current, accumulator, new_el]
                drop 0 // drop new_el
                drop 0 // drop accumulator
                
                roll 1 // Stack: [current, event]
                untuple 2 // Stack: [current, payload, type]
                
                pick 0 // type
                push super::pop_front
                equal
                branch {
                    drop 0 // type
                    tuple 0
                    push super::super::prelude::req
                    tuple 2
                    assert_eq
                    drop 0 // current (which is ())
                    
                    push ()
                    tuple 0
                    push super::super::prelude::none
                    tuple 2
                    push ()
                    push super::pop_front_resp_await
                    tuple 4
                } {
                    drop 0 // type. Stack: [current, val]
                    drop 1 // current (which is ()). Stack: [val]
                    
                    push ()
                    tuple 2 // (val, ())
                    push super::super::prelude::some
                    tuple 2 // ((val, ()), some)
                    
                    push ()
                    roll 1 // Stack: [((val, ()), some), ()]
                    push ()
                    push super::awaiting_front_resp
                    tuple 4
                }
            } {
                // Return to idle / awaiting_push state from response state
                pick 0 // tag
                push super::pop_front_resp
                equal
                pick 1 // tag
                push super::awaiting_front_resp
                equal
                or
                branch {
                    pick 3 // current
                    push ()
                    push ()
                    push super::idle
                    tuple 4
                    
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                } {
                    pick 0 // tag
                    push super::pop_front_resp_await
                    equal
                    branch {
                        push ()
                        push ()
                        push ()
                        push super::awaiting_push
                        tuple 4
                        
                        drop 1
                        drop 1
                        drop 1
                        drop 1
                        drop 1
                    } {
                        drop 0
                        drop 0
                        drop 0
                        drop 0
                        drop 0
                        push ()
                    }
                }
            }
        }
    }

    // tau_reduce: takes [state] and returns (new_state, changed)
    function tau_reduce {
        // Stack: [state]
        pick 0 // duplicate state. Stack: [state, state]
        untuple 4
        // Stack: [state, current, accumulator, new_el, tag]
        
        // Check if tag is descending
        pick 0 // tag
        push super::descending
        equal
        branch {
            // Stage is descending:
            pick 3 // current. Stack: [state, current, accumulator, new_el, current]
            push ()
            equal
            branch {
                // current is ()
                pick 1 // Stack: [state, current, accumulator, new_el, new_el]
                push ()
                tuple 2 // Stack: [state, current, accumulator, new_el, (new_el, ())] (new_current)
                pick 3 // Stack: [state, current, accumulator, new_el, new_current, accumulator]
                push ()
                push super::rebuilding
                tuple 4 // Stack: [state, current, accumulator, new_el, new_state]
                push true
                tuple 2
                drop 1
                drop 1
                drop 1
                drop 1
                drop 1
            } {
                // current is NOT ()
                pick 3  // Stack: [state, current, accumulator, new_el, current]
                untuple 2 // Stack: [state, current, accumulator, new_el, head, rest]
                roll 1  // Stack: [state, current, accumulator, new_el, rest, head]
                pick 4  // Stack: [state, current, accumulator, new_el, rest, head, accumulator]
                tuple 2 // Stack: [state, current, accumulator, new_el, rest, new_accumulator]
                pick 3  // Stack: [state, current, accumulator, new_el, rest, new_accumulator, new_el]
                push super::descending
                tuple 4 // Stack: [state, current, accumulator, new_el, new_state]
                push true
                tuple 2
                drop 1
                drop 1
                drop 1
                drop 1
                drop 1
            }
        } {
            // Check if tag is rebuilding
            pick 0 // tag
            push super::rebuilding
            equal
            branch {
                // Stage is rebuilding:
                pick 2 // accumulator
                push ()
                equal
                branch {
                    // accumulator is () -> Transition to idle
                    pick 3 // current
                    push ()
                    push ()
                    push super::idle
                    tuple 4 // Stack: [state, current, accumulator, new_el, new_state]
                    push true
                    tuple 2
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                } {
                    // accumulator is NOT ()
                    pick 2 // accumulator
                    untuple 2 // Stack: [state, current, accumulator, new_el, head, rest_acc]
                    pick 5 // current
                    roll 2 // Stack: [state, current, accumulator, new_el, rest_acc, current, head]
                    roll 1 // Stack: [state, current, accumulator, new_el, rest_acc, head, current]
                    tuple 2 // Stack: [state, current, accumulator, new_el, rest_acc, new_current]
                    roll 1 // Stack: [state, current, accumulator, new_el, new_current, rest_acc]
                    pick 3 // new_el
                    push super::rebuilding
                    tuple 4 // [new_state]
                    push true
                    tuple 2
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                    drop 1
                }
            } {
                // Stage is idle / done / response (no transition):
                pick 4 // get original state
                push false
                tuple 2
                drop 1
                drop 1
                drop 1
                drop 1
                drop 1
            }
        }
    }

    function is_done {
        drop 0
        push false
    }

    function is_ready_to_finish {
        untuple 4
        pick 0
        push super::idle
        equal
        roll 4
        drop 0
        roll 3
        drop 0
        roll 2
        drop 0
        roll 1
        drop 0
    }
}

// Helper to drive the queue's tau reductions in tests
sentence drive_reductions {
    // Stack: [state]
    pick 0
    jump queue::tau_reduce
    // Stack: [state, (new_state, changed)]
    untuple 2
    // Stack: [state, new_state, changed]
    branch {
        drop 1 // drop old state. Stack: [new_state]
        jump drive_reductions
    } {
        drop 0 // drop new_state. Stack: [state]
    }
}

test sentence verify_queue_machine {
    tuple 0
    jump queue::init
    
    // 2. Push 10
    push 10
    push push_back
    tuple 2
    jump queue::process
    jump drive_reductions
    
    // 3. Push 20
    push 20
    push push_back
    tuple 2
    jump queue::process
    jump drive_reductions
    
    // 4. Pop (should yield 10)
    tuple 0
    push super::prelude::req
    tuple 2 // ((), req)
    push pop_front
    tuple 2 // (((), req), pop_front)
    jump queue::process
    jump drive_reductions
    
    // Check emitted event: (pop_front, (resp, (some, (10, ())))) -> ((((10, ()), some), resp), pop_front)
    pick 0
    jump queue::emit
    untuple 2
    assert
    
    push (10, ())
    push super::prelude::some
    tuple 2 // ((10, ()), some)
    push super::prelude::resp
    tuple 2 // (((10, ()), some), resp)
    push pop_front
    tuple 2 // ((((10, ()), some), resp), pop_front)
    assert_eq
    
    // Process emitted event to return to idle
    push (10, ())
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push pop_front
    tuple 2
    jump queue::process
    
    // 5. Pop (should yield 20)
    tuple 0
    push super::prelude::req
    tuple 2
    push pop_front
    tuple 2
    jump queue::process
    jump drive_reductions
    
    pick 0
    jump queue::emit
    untuple 2
    assert
    push (20, ())
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push pop_front
    tuple 2
    assert_eq
    
    push (20, ())
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push pop_front
    tuple 2
    jump queue::process
    
    // 6. Pop on empty queue (should yield pop_front.resp.none)
    tuple 0
    push super::prelude::req
    tuple 2
    push pop_front
    tuple 2
    jump queue::process
    jump drive_reductions
    
    pick 0
    jump queue::emit
    untuple 2
    assert
    tuple 0
    push super::prelude::none
    tuple 2
    push super::prelude::resp
    tuple 2
    push pop_front
    tuple 2
    assert_eq
    
    tuple 0
    push super::prelude::none
    tuple 2
    push super::prelude::resp
    tuple 2
    push pop_front
    tuple 2
    jump queue::process
    
    // 7. Await front on empty queue (yields awaiting_push state)
    tuple 0
    push super::prelude::req
    tuple 2
    push await_front
    tuple 2
    jump queue::process
    
    // Check that we can pop even when awaiting!
    // Awaiting queue should accept pop_front.req
    pick 0
    jump queue::accept
    tuple 0
    push super::prelude::req
    tuple 2
    push pop_front
    tuple 2
    roll 1
    set_contains
    assert
    
    // Process pop_front.req on awaiting queue (transitions to pop_front_resp_await)
    tuple 0
    push super::prelude::req
    tuple 2
    push pop_front
    tuple 2
    jump queue::process
    
    // Check emitted event: (pop_front, (resp, (none, ()))) -> ((((), none), resp), pop_front)
    pick 0
    jump queue::emit
    untuple 2
    assert
    tuple 0
    push super::prelude::none
    tuple 2
    push super::prelude::resp
    tuple 2
    push pop_front
    tuple 2
    assert_eq
    
    // Process emitted event to return to awaiting_push state
    tuple 0
    push super::prelude::none
    tuple 2
    push super::prelude::resp
    tuple 2
    push pop_front
    tuple 2
    jump queue::process
    
    // Push 100 on the awaiting queue
    push 100
    push push_back
    tuple 2
    jump queue::process
    jump drive_reductions
    
    // Check that queue is in awaiting_front_resp state and emits await_front.resp
    pick 0
    jump queue::emit
    untuple 2
    assert
    push (100, ())
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push await_front
    tuple 2
    assert_eq
    
    // Process await_front.resp to return to idle
    push (100, ())
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push await_front
    tuple 2
    jump queue::process
    
    drop 0 // clean up state
}
