// Customer-Queue-Barista Coffee Shop CSP System

mod customer_id {
    symbol c1 "Customer 1 ID"
    symbol c2 "Customer 2 ID"
}

mod event {
    symbol want_coffee  "Customer wants coffee"
    symbol coffee       "Barista serves coffee"
    symbol enjoy        "Customer enjoys coffee"
    symbol latte        "Latte coffee type"
    symbol espresso     "Espresso coffee type"
}

mod customer_impl {
    mod state {
        symbol idle       "Customer is idle"
        symbol thirsty    "Customer is thirsty"
        symbol ordered    "Customer has ordered"
        symbol has_coffee "Customer has coffee"
    }

    // Initializes customer state: (id, preferred_drink, internal_state)
    #[arity(1, 1)]
    #[safety("true")]
    #[behavior("out[0] == in[0]")]
    function init {
    }


    #[arity(1, 1)]
    function accept {
        untuple 2
        untuple 3 // Stack: [event, id, preferred_drink, internal_state]
        pick 0
        push state::idle
        equal
        branch {
            drop 0 // drop internal_state
            drop 0 // drop preferred_drink
            tuple 0
            roll 1
            tuple 2
            push super::event::want_coffee
            tuple 2
            set_singleton
        } {
            pick 0
            push state::ordered
            equal
            branch {
                drop 0 // drop internal_state
                tuple 2
                push super::event::coffee
                tuple 2
                set_singleton
            } {
                pick 0
                push state::has_coffee
                equal
                branch {
                    drop 0 // drop internal_state
                    drop 0 // drop preferred_drink
                    tuple 0
                    roll 1
                    tuple 2
                    push super::event::enjoy
                    tuple 2
                    set_singleton
                } {
                    pick 0
                    push state::thirsty
                    equal
                    branch {
                        drop 0
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        panic
                    }
                }
            }
        }
        set_contains
    }

    #[arity(1, 1)]
    #[safety("true")]
    function tau_reduce {
        push false
        tuple 2
    }

    // emit takes state: (id, preferred_drink, internal_state) and returns ValueSet of emitted events.
    #[arity(1, 1)]
    #[safety("is_tuple(in[0], 3) && (in[0].0 == state::idle || in[0].0 == state::thirsty || in[0].0 == state::ordered || in[0].0 == state::has_coffee)")]
    function emit {
        untuple 3 // Stack: [id, preferred_drink, internal_state]
        pick 0
        push state::thirsty
        equal
        branch {
            // Customer emits order request to queue (push_back event)
            drop 0 // drop internal_state. Stack: [id, preferred_drink]
            tuple 2 // (id, preferred_drink)
            push super::super::queue::push_back
            tuple 2
            push true
            tuple 2
        } {
            pick 0
            push state::idle
            equal
            branch {
                drop 0
                drop 0
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    tuple 0
                    push false
                    tuple 2
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        drop 0
                        drop 0
                        drop 0
                        tuple 0
                        push false
                        tuple 2
                    } {
                        panic
                    }
                }
            }
        }
    }

    // process takes [state, event] and returns next_state.
    #[arity(1, 1)]
    #[safety("is_tuple(in[0], 2) && is_tuple(in[0].0, 3) && (in[0].0.0 == state::idle || in[0].0.0 == state::thirsty || in[0].0.0 == state::ordered || in[0].0.0 == state::has_coffee) && is_tuple(in[0].1, 2) && is_tuple(in[0].1.1, 2) && (in[0].0.0 == state::idle ==> in[0].1.0 == event::want_coffee) && (in[0].0.0 == state::thirsty ==> in[0].1.0 == super::super::queue::push_back) && (in[0].0.0 == state::ordered ==> in[0].1.0 == event::coffee) && (in[0].0.0 == state::has_coffee ==> in[0].1.0 == event::enjoy)")]
    function process {
        untuple 2
        // Stack: [event, state]
        untuple 3 // Stack: [event, id, preferred_drink, internal_state]
        
        // Check internal_state
        pick 0
        push state::idle
        equal
        branch {
            push state::idle
            assert_eq
            roll 2
            untuple 2
            push super::event::want_coffee
            assert_eq
            untuple 2
            drop 0
            drop 0
            push state::thirsty
            tuple 3
        } {
            pick 0
            push state::thirsty
            equal
            branch {
                push state::thirsty
                assert_eq
                roll 2
                untuple 2
                push super::super::queue::push_back
                assert_eq
                drop 0
                push state::ordered
                tuple 3
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    push state::ordered
                    assert_eq
                    roll 2
                    untuple 2
                    push super::event::coffee
                    assert_eq
                    untuple 2
                    drop 0
                    drop 0
                    push state::has_coffee
                    tuple 3
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        push state::has_coffee
                        assert_eq
                        roll 2
                        untuple 2
                        push super::event::enjoy
                        assert_eq
                        untuple 2
                        drop 0
                        drop 0
                        push state::idle
                        tuple 3
                    } {
                        panic
                    }
                }
            }
        }
    }

    #[arity(1, 1)]
    #[safety("true")]
    #[behavior("out[0] == false")]
    function is_done {
        drop 0
        push false
    }

    #[arity(1, 1)]
    #[safety("is_tuple(in[0], 3)")]
    #[behavior("out[0] == (in[0].0 == state::idle)")]
    function is_ready_to_finish {
        untuple 3
        pick 0
        push state::idle
        equal
        roll 3
        drop 0
        roll 2
        drop 0
        roll 1
        drop 0
    }
}

test sentence verify_customer_logic {
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    // Idle state accepts want_coffee
    push (event::want_coffee, (customer_id::c1, ()))
    pick 1
    tuple 2
    jump customer_impl::accept
    assert
    
    // Process want_coffee -> thirsty
    push (event::want_coffee, (customer_id::c1, ()))
    roll 1
    tuple 2
    jump customer_impl::process
    
    // Thirsty state emits push_back
    pick 0
    jump customer_impl::emit
    untuple 2
    assert
    push (super::queue::push_back, (event::latte, customer_id::c1))
    assert_eq
    
    // Process push_back -> ordered
    push (super::queue::push_back, (event::latte, customer_id::c1))
    roll 1
    tuple 2
    jump customer_impl::process
    
    // Ordered state accepts coffee
    push (event::coffee, (event::latte, customer_id::c1))
    pick 1
    tuple 2
    jump customer_impl::accept
    assert
    
    // Process coffee -> has_coffee
    push (event::coffee, (event::latte, customer_id::c1))
    roll 1
    tuple 2
    jump customer_impl::process
    
    // Has coffee accepts enjoy
    push (event::enjoy, (customer_id::c1, ()))
    pick 1
    tuple 2
    jump customer_impl::accept
    assert
    
    // Process enjoy -> idle
    push (event::enjoy, (customer_id::c1, ()))
    roll 1
    tuple 2
    jump customer_impl::process
    
    drop 0
}

mod customer1 compose_static_closure(customer_impl, (super::customer_impl::state::idle, super::event::latte, super::customer_id::c1));
mod customer2 compose_static_closure(customer_impl, (super::customer_impl::state::idle, super::event::espresso, super::customer_id::c2));

mod barista {
    mod state {
        symbol idle             "Barista is idle"
        symbol awaiting_order   "Barista is awaiting order from queue"
        symbol brewing          "Barista is brewing coffee"
    }

    // Initializes barista state
    #[arity(1, 1)]
    #[safety("is_tuple(in[0], 0)")]
    #[behavior("out[0] == barista::state::idle")]
    function init {
        untuple 0
        push state::idle
    }


    #[arity(1, 1)]
    function accept {
        untuple 2
        pick 0
        push state::idle
        equal
        branch {
            drop 0
            push empty_set
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0
                push ()
                set_singleton
                push universal_set
                set_tuple 2 // {(val, ())}
                
                push super::super::prelude::some
                set_singleton
                set_tuple 2 // {((val, ()), some)}
                
                push super::super::prelude::resp
                set_singleton
                set_tuple 2 // {(((val, ()), some), resp)}
                
                push super::super::queue::await_front
                set_singleton
                set_tuple 2 // {((((val, ()), some), resp), await_front)}
            } {
                drop 0
                push empty_set
            }
        }
        set_contains
    }

    #[arity(1, 1)]
    #[safety("true")]
    function tau_reduce {
        push false
        tuple 2
    }

    // emit takes [state] and returns ValueSet.
    #[arity(1, 1)]
    #[safety("in[0] == state::idle || in[0] == state::awaiting_order || (is_tuple(in[0], 2) && in[0].0 == state::brewing && is_tuple(in[0].1, 2))")]
    function emit {
        // Stack: [state]
        pick 0
        push state::idle
        equal
        branch {
            drop 0
            push ()
            push super::super::prelude::req
            tuple 2
            push super::super::queue::await_front
            tuple 2
            push true
            tuple 2
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                // Must be brewing
                untuple 2 // Stack: [(id, drink), state_status]
                push state::brewing
                equal
                branch {
                    // Stack: [(id, drink)]
                    untuple 2
                    tuple 2
                    push super::event::coffee
                    tuple 2
                    push true
                    tuple 2
                } {
                    panic
                }
            }
        }
    }

    // process takes [state, event] and returns next_state.
    #[arity(1, 1)]
    #[safety("is_tuple(in[0], 2) && (in[0].0 == state::idle || in[0].0 == state::awaiting_order || (is_tuple(in[0].0, 2) && in[0].0.0 == state::brewing && is_tuple(in[0].0.1, 2))) && (in[0].0 == state::idle ==> (is_tuple(in[0].1, 2) && in[0].1.0 == super::super::queue::await_front && is_tuple(in[0].1.1, 2) && in[0].1.1.0 == super::super::prelude::req && is_tuple(in[0].1.1.1, 0))) && (in[0].0 == state::awaiting_order ==> (is_tuple(in[0].1, 2) && in[0].1.0 == super::super::queue::await_front && is_tuple(in[0].1.1, 2) && in[0].1.1.0 == super::super::prelude::resp && is_tuple(in[0].1.1.1, 2) && in[0].1.1.1.0 == super::super::prelude::some && is_tuple(in[0].1.1.1.1, 2) && is_tuple(in[0].1.1.1.1.0, 2) && is_tuple(in[0].1.1.1.1.1, 0))) && (in[0].0 != state::idle && in[0].0 != state::awaiting_order ==> (is_tuple(in[0].1, 2) && in[0].1.0 == event::coffee && is_tuple(in[0].1.1, 2)))")]
    function process {
        untuple 2
        // Inputs: [event, state]
        pick 0 // state
        push state::idle
        equal
        branch {
            // Transition from idle to awaiting_order
            push state::idle
            assert_eq
            
            push ()
            push super::super::prelude::req
            tuple 2
            push super::super::queue::await_front
            tuple 2
            assert_eq
            push state::awaiting_order
        } {
            pick 0 // state
            push state::awaiting_order
            equal
            branch {
                // Transition from awaiting_order to brewing.
                push state::awaiting_order
                assert_eq
                
                // Destructure event: ((((val, ()), some), resp), await_front)
                untuple 2
                push super::super::queue::await_front
                assert_eq
                
                untuple 2
                push super::super::prelude::resp
                assert_eq
                
                untuple 2
                push super::super::prelude::some
                assert_eq
                
                untuple 2
                roll 1
                push ()
                assert_eq
                
                push state::brewing
                tuple 2 // (val, state::brewing)
            } {
                // Must be brewing. Transition to idle.
                untuple 2 // Stack: [event, state_status]
                push state::brewing
                assert_eq
                drop 0
                untuple 2 // Stack: [(drink, id), coffee]
                push super::event::coffee
                assert_eq
                untuple 2 // Stack: [id, drink]
                drop 0
                drop 0
                push state::idle
            }
        }
    }

    #[arity(1, 1)]
    #[safety("true")]
    #[behavior("out[0] == false")]
    function is_done {
        drop 0
        push false
    }

    #[arity(1, 1)]
    #[safety("true")]
    #[behavior("out[0] == (in[0] == barista::state::idle)")]
    function is_ready_to_finish {
        push state::idle
        equal
    }
}

sentence customers_sync {
    drop 0
    push false
}

mod customers compose_concurrent(customer1, customer2, customers_sync);

sentence customers_queue_sync {
    push set_tuple(singleton(super::queue::push_back), universal_set)
    set_contains
}

mod customers_and_queue compose_concurrent(customers, super::queue::queue, customers_queue_sync);

sentence joint_sync {
    // Sync barista and queue on await_front
    push set_tuple(singleton(super::queue::await_front), universal_set)
    
    // Sync customers and barista on coffee
    push universal_set
    push universal_set
    set_tuple 2
    push singleton(event::coffee)
    set_tuple 2
    set_union
    
    set_contains
}

mod concurrent compose_concurrent(customers_and_queue, barista, joint_sync);

sentence hidden_events {
    push set_tuple(singleton(super::queue::push_back), universal_set)
    
    push universal_set
    push universal_set
    set_tuple 2
    push singleton(event::coffee)
    set_tuple 2
    set_union
    
    push set_tuple(singleton(super::queue::await_front), universal_set)
    set_union
    
    set_contains
}

mod hidden compose_hidden(concurrent, hidden_events);

// Helpers to drive tau transitions in tests
sentence drive_tau {
    // Stack: [state]
    pick 0
    jump hidden::tau_reduce
    untuple 2
    branch {
        drop 1 // drop old state
        jump drive_tau
    } {
        drop 0
    }
}

sentence drive_concurrent_tau {
    pick 0
    jump concurrent::tau_reduce
    untuple 2
    branch {
        drop 1
        jump drive_concurrent_tau
    } {
        drop 0
    }
}

test sentence verify_hidden_system {
    // 1. Initialize joint state
    tuple 0
    jump hidden::init
    
    // 2. Trigger want_coffee for c1. Let's verify it is accepted.
    push (event::want_coffee, (customer_id::c1, ()))
    pick 1
    tuple 2
    jump hidden::accept
    assert
    
    // 2. Trigger event::want_coffee for c1
    push (event::want_coffee, (customer_id::c1, ()))
    roll 1
    tuple 2
    jump hidden::process
    
    // 3. Drive tau -> Barista serves Customer 1
    jump drive_tau
    
    // Verify state: Customer 1 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 // customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint state
    equal
    assert
    
    // customer 2 wants coffee. Let's verify it is accepted.
    push (event::want_coffee, (customer_id::c2, ()))
    pick 1
    tuple 2
    jump hidden::accept
    assert
    
    // 4. Trigger event::want_coffee for c2
    push (event::want_coffee, (customer_id::c2, ()))
    roll 1
    tuple 2
    jump hidden::process
    
    // 5. Drive tau -> Barista serves Customer 2
    jump drive_tau
    
    // Verify state: Customer 1 and Customer 2 both have coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 // customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint state
    equal
    assert
    
    // customer 1 enjoys coffee. Let's verify it is accepted.
    push (event::enjoy, (customer_id::c1, ()))
    pick 1
    tuple 2
    jump hidden::accept
    assert
    
    // 6. Trigger enjoy for c1
    push (event::enjoy, (customer_id::c1, ()))
    roll 1
    tuple 2
    jump hidden::process
    
    // Verify state: Customer 1 is idle, Customer 2 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 // customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint
    equal
    assert
    
    // customer 2 enjoys coffee. Let's verify it is accepted.
    push (event::enjoy, (customer_id::c2, ()))
    pick 1
    tuple 2
    jump hidden::accept
    assert
    
    // 7. Trigger enjoy for c2
    push (event::enjoy, (customer_id::c2, ()))
    roll 1
    tuple 2
    jump hidden::process
    
    // Verify state: both idle
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 // customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint
    equal
    assert
    
    drop 0 // clean up state
}

// Test the concurrent joint Customer-Queue-Barista system
test sentence verify_concurrent_system {
    // 1. Initialize joint state
    tuple 0
    jump concurrent::init
    
    // 2. Barista requests await_front
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    push ()
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    push ()
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    tuple 2
    jump concurrent::process
    
    // 3. Customer 1 wants coffee (accepted from environment)
    push (event::want_coffee, (customer_id::c1, ()))
    pick 1
    tuple 2
    jump concurrent::accept
    assert
    
    push (event::want_coffee, (customer_id::c1, ()))
    roll 1
    tuple 2
    jump concurrent::process
    
    // 4. Customer 2 wants coffee (accepted from environment)
    push (event::want_coffee, (customer_id::c2, ()))
    pick 1
    tuple 2
    jump concurrent::accept
    assert
    
    push (event::want_coffee, (customer_id::c2, ()))
    roll 1
    tuple 2
    jump concurrent::process
    
    // 5. Customer 1 orders coffee (emitted request from customer)
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (event::latte, customer_id::c1)
    push super::queue::push_back
    tuple 2
    assert_eq
    
    push (event::latte, customer_id::c1)
    push super::queue::push_back
    tuple 2
    roll 1
    tuple 2
    jump concurrent::process
    jump drive_concurrent_tau
    
    // 6. Queue responds to await_front request with the popped customer 1 value
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    push ()
    push (event::latte, customer_id::c1)
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    push ()
    push (event::latte, customer_id::c1)
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    tuple 2
    jump concurrent::process
    
    // 7. Customer 2 orders coffee (emitted request from customer)
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (event::espresso, customer_id::c2)
    push super::queue::push_back
    tuple 2
    assert_eq
    
    push (event::espresso, customer_id::c2)
    push super::queue::push_back
    tuple 2
    roll 1
    tuple 2
    jump concurrent::process
    jump drive_concurrent_tau
    
    // 8. Barista finishes brewing for Customer 1
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (event::coffee, (event::latte, customer_id::c1))
    assert_eq
    
    push (event::coffee, (event::latte, customer_id::c1))
    roll 1
    tuple 2
    jump concurrent::process
    
    // 9. Customer 1 enjoys coffee
    push (event::enjoy, (customer_id::c1, ()))
    pick 1
    tuple 2
    jump concurrent::accept
    assert
    
    push (event::enjoy, (customer_id::c1, ()))
    roll 1
    tuple 2
    jump concurrent::process
    
    // 10. Barista requests await_front
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    push ()
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    push ()
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    tuple 2
    jump concurrent::process
    
    // 11. Queue immediately responds to await_front request with the popped customer 2 value
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    push ()
    push (event::espresso, customer_id::c2)
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    push ()
    push (event::espresso, customer_id::c2)
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    tuple 2
    jump concurrent::process
    
    // 12. Barista finishes brewing for Customer 2
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (event::coffee, (event::espresso, customer_id::c2))
    assert_eq
    
    push (event::coffee, (event::espresso, customer_id::c2))
    roll 1
    tuple 2
    jump concurrent::process
    
    // 13. Customer 2 enjoys coffee
    push (event::enjoy, (customer_id::c2, ()))
    pick 1
    tuple 2
    jump concurrent::accept
    assert
    
    push (event::enjoy, (customer_id::c2, ()))
    roll 1
    tuple 2
    jump concurrent::process
    
    // Verify final states
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 // customers
    
    push ()
    push ()
    push ()
    push super::queue::idle
    tuple 4 // queue
    
    tuple 2 // customers and queue
    
    push barista::state::idle // barista
    
    tuple 2 // joint
    equal
    assert
    
    drop 0 // clean up state
}

// Test the rejection of invalid events for Barista
test sentence verify_barista_rejection {
    // 1. Trigger invalid coffee event on idle (coffee is emit, not accept)
    tuple 0
    jump barista::init
    
    push (event::coffee, (event::latte, customer_id::c1))
    roll 1
    tuple 2
    jump barista::accept
    push false
    assert_eq

    // 2. Test that barista in idle does NOT accept order directly (since orders are queued)
    tuple 0
    jump barista::init
    push (super::queue::push_back, (event::latte, customer_id::c1))
    roll 1
    tuple 2
    jump barista::accept
    push false
    assert_eq
    
    // 3. Test that barista in idle emits await_front.req
    tuple 0
    jump barista::init
    jump barista::emit
    untuple 2
    assert
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    // 4. Test that barista in awaiting_order accepts await_front.resp.some.val
    tuple 0
    jump barista::init
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    tuple 2
    jump barista::process // Transition to awaiting_order
    
    push ()
    push (event::latte, customer_id::c1)
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    tuple 2
    jump barista::accept
    assert
    
    // 5. Test that barista in awaiting_order does NOT emit coffee
    tuple 0
    jump barista::init
    push ()
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    tuple 2
    jump barista::process // Transition to awaiting_order
    
    jump barista::emit
    untuple 2
    not
    assert
    drop 0
}
