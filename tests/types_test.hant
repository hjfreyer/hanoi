proof number_does_pre_and_post_is_constant = 
    unfold_all; 
    once(distribute); 
    rhs(once(inv(counit(0)));
        at(1, inv(counit(0)));
        at(2, introduce{push types_test::t1 equal branch {}{}});
        distribution);
    normalize(once(copy_assoc);
        each(float);
        once(unfactor);
        bu(each(flatten)));
    once(specialize_equal);
    peel;
    rhs(then(once(counit)));
    normalize(cleanup);
    descend(
        then: cleanup, 
        else:
            once(specialize_equal);
            cleanup;
            repeat(once(inv(distribute)));
            once(annihilate_void);
            cleanup
    );
