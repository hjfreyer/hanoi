// Integration tests for is_done and is_ready_to_finish state machine sentences

test sentence verify_is_done_basic_machines {
    // 1. string_ref: state (sym, idle) -> is_done = false
    push ()
    push super::string::string_ref::idle
    tuple 2 // state
    jump super::string::string_ref::is_done
    push false
    assert_eq

    // 2. queue: state ((), (), (), idle) -> is_done = false
    push ((()), super::queue::State::Idle::tag) // state
    jump super::queue::queue::is_done
    push false
    assert_eq

    // 3. char_iterator: state (0, fetch) -> is_done = false
    push 0
    push super::string::char_iterator::fetch
    tuple 2 // state
    jump super::string::char_iterator::is_done
    push false
    assert_eq

    // 4. char_iterator: state (5, done_state) -> is_done = true
    push 5
    push super::string::char_iterator::done_state
    tuple 2 // state
    jump super::string::char_iterator::is_done
    push true
    assert_eq

    // 5. split: state (delim, state_done) -> is_done = true
    push ()
    push super::string::split::state_done
    tuple 2 // state
    jump super::string::split::is_done
    push true
    assert_eq
    push crate::prelude::pass
}

test sentence verify_is_ready_to_finish_basic_machines {
    // 1. string_ref: state (sym, idle) -> is_ready_to_finish = true
    push ()
    push super::string::string_ref::idle
    tuple 2 // state
    jump super::string::string_ref::is_ready_to_finish
    push true
    assert_eq

    // 2. queue: state ((), (), (), idle) -> is_ready_to_finish = true
    push ((()), super::queue::State::Idle::tag) // state
    jump super::queue::queue::is_ready_to_finish
    push true
    assert_eq

    // 3. char_iterator: state (0, fetch) -> is_ready_to_finish = false
    push 0
    push super::string::char_iterator::fetch
    tuple 2 // state
    jump super::string::char_iterator::is_ready_to_finish
    push false
    assert_eq

    // 4. char_iterator: state (5, done_state) -> is_ready_to_finish = true
    push 5
    push super::string::char_iterator::done_state
    tuple 2 // state
    jump super::string::char_iterator::is_ready_to_finish
    push true
    assert_eq

    // 5. split: state (delim, state_done) -> is_ready_to_finish = true
    push ()
    push super::string::split::state_done
    tuple 2 // state
    jump super::string::split::is_ready_to_finish
    push true
    assert_eq
    push crate::prelude::pass
}

test sentence verify_is_done_compositions {
    // 1. compose_static_closure (using customer1)
    tuple 0
    jump super::barista::customer1::init
    jump super::barista::customer1::is_done
    push false
    assert_eq

    // 2. compose_concurrent (using customers)
    tuple 0
    jump super::barista::customers::init
    jump super::barista::customers::is_done
    push false
    assert_eq

    // 3. compose_hidden (using hidden)
    tuple 0
    jump super::barista::hidden::init
    jump super::barista::hidden::is_done
    push false
    assert_eq
    push crate::prelude::pass
}

test sentence verify_is_ready_to_finish_compositions {
    // 1. compose_static_closure (using customer1)
    tuple 0
    jump super::barista::customer1::init
    jump super::barista::customer1::is_ready_to_finish
    push true
    assert_eq

    // 2. compose_concurrent (using customers)
    tuple 0
    jump super::barista::customers::init
    jump super::barista::customers::is_ready_to_finish
    push true
    assert_eq
    push crate::prelude::pass
}
