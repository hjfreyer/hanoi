symbol none
symbol some
symbol req
symbol resp

// The two tags a result carries, and the ones `?` reads. A result is the
// 2-tuple `(value, ok)` or `(value, err)`.
symbol ok
symbol err

// `((), ok)` when the top two values are equal, and `((a, b), err)` when they
// are not — the pair that did not match, in the order it sat on the stack.
//
// This is how a test states a check. Nothing in the language halts a run any
// more, so a check that does not hold hands back a value saying what it saw,
// which the test carries out with `?` and the runner prints.
#[arity(2, 1)]
sentence check_equals {
    pick 1
    pick 1
    equal
    branch {
        drop 0
        drop 0
        push ()
        push ok
        tuple 2
    } {
        tuple 2
        push err
        tuple 2
    }
}

// `((), ok)` when the top value is `true`, and `((v, true), err)` when it is
// anything else — `check_equals` against `true`, which is what most flags want.
#[arity(1, 1)]
sentence check_true {
    push true
    jump check_equals
}

symbol start
symbol pass
symbol fail

mod event {
}

