// Tests for control flow and subroutine call stack returns

test sentence unconditional_jump {
    push 100
    jump target_sentence
}

// The check the test is making lives here, so it answers with a result and the
// test hands that back.
sentence target_sentence {
    push 100
    jump crate::prelude::check_equals
}

test sentence conditional_branch {
    push true
    branch {
        // Inline true block
        push 10
    } {
        // Reached only if the branch took the wrong arm, and the check below
        // is what says so.
        push 0
    }
    push 10
    jump crate::prelude::check_equals
}

// A call returns to the instruction after the `jump`, however deep the calls
// are nested. This used to count down from ten by recursing; the ten levels
// are spelled out instead, each decrementing the counter, calling the level
// below it, and then checking that it really did resume once that call
// returned.
test sentence nesting_and_returns {
    push 10
    jump level_10
}

sentence level_10 {
    jump decrement
    jump level_9
    // Verification that we returned back up the stack, made past the result
    // the level below handed back.
    push true
    jump crate::prelude::check_true
    ?
    drop 0
}

sentence level_9 {
    jump decrement
    jump level_8
    // Verification that we returned back up the stack, made past the result
    // the level below handed back.
    push true
    jump crate::prelude::check_true
    ?
    drop 0
}

sentence level_8 {
    jump decrement
    jump level_7
    // Verification that we returned back up the stack, made past the result
    // the level below handed back.
    push true
    jump crate::prelude::check_true
    ?
    drop 0
}

