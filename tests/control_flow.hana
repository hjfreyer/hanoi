// Tests for control flow and subroutine call stack returns

test sentence unconditional_jump {
    push 100
    jump target_sentence
}

sentence target_sentence {
    push 100
    assert_eq
}

test sentence conditional_branch {
    push true
    branch {
        // Inline true block
        push 10
    } {
        panic
    }
    push 10
    assert_eq
}

// A call returns to the instruction after the `jump`, however deep the calls
// are nested. This used to count down from ten by recursing; the ten levels
// are spelled out instead, each decrementing the counter, calling the level
// below it, and then checking that it really did resume once that call
// returned.
test sentence nesting_and_returns {
    push 10
    jump level_10
}

sentence level_10 {
    jump decrement
    jump level_9
    push true
    assert
}

sentence level_9 {
    jump decrement
    jump level_8
    push true
    assert
}

sentence level_8 {
    jump decrement
    jump level_7
    push true
    assert
}

sentence level_7 {
    jump decrement
    jump level_6
    push true
    assert
}

sentence level_6 {
    jump decrement
    jump level_5
    push true
    assert
}

sentence level_5 {
    jump decrement
    jump level_4
    push true
    assert
}

sentence level_4 {
    jump decrement
    jump level_3
    push true
    assert
}

sentence level_3 {
    jump decrement
    jump level_2
    push true
    assert
}

sentence level_2 {
    jump decrement
    jump level_1
    push true
    assert
}

sentence level_1 {
    jump decrement
    jump level_0
    push true
    assert
}

// The bottom of the nest: ten decrements from ten leave zero.
sentence level_0 {
    push 0
    assert_eq
}

sentence decrement {
    push 1
    sub
    assert
}
