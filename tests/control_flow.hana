// Tests for control flow and subroutine call stack returns

#[flags]
test sentence unconditional_jump {
    push 100
    jump target_sentence
}

#[flags]
sentence target_sentence {
    push 100
    assert_eq
}

#[flags]
test sentence conditional_branch {
    push true
    branch {
        // Inline true block
        push 10
    } {
        panic
    }
    push 10
    assert_eq
}

#[flags]
#[recursive]
test sentence recursion_and_returns {
    push 10
    jump recursive_helper
}

#[flags]
#[recursive]
sentence recursive_helper {
    // top of stack is decrement counter
    pick 0
    push 0
    equal
    branch {
        push 0
        assert_eq
    } {
        // Recursive case: decrement and recurse
        push 1
        sub
        assert
        jump recursive_helper
        // Verification that we returned back up the stack
        push true
        assert
    }
}
