# CSP Customer and Barista interaction simulation with state machines
# Modified to support multiple concurrent customers with preferred drinks
# and a central queue to buffer customer orders for the barista.

mod customer_id {
    symbol c1 "Customer 1"
    symbol c2 "Customer 2"
}

mod event {
    # Declare events
    symbol order       "Order event"
    symbol coffee      "Prepared coffee drink event"
    symbol want_coffee "Customer wants coffee event"
    symbol enjoy       "Customer enjoys coffee event"
    symbol latte       "Latte drink"
    symbol espresso    "Espresso drink"
}

mod customer_impl {
    mod state {
        # Declare Customer states
        symbol idle        "Customer is idle"
        symbol thirsty     "Customer is thirsty"
        symbol ordered     "Customer ordered coffee"
        symbol has_coffee  "Customer received coffee and has coffee"
    }

    sentence init {
    }

    # accept takes state: (id, preferred_drink, internal_state) and returns ValueSet of accepted events.
    # The accepted events are:
    # - If internal_state is idle: {(want_coffee, id)} (from environment)
    # - If internal_state is ordered: {(coffee, id, preferred_drink)} (from barista)
    # - If internal_state is has_coffee: {(enjoy, id)} (from environment)
    sentence accept {
        untuple 3 # Stack: [id, preferred_drink, internal_state]
        pick 0
        push state::idle
        equal
        branch {
            # Customer accepts want_coffee from environment
            drop 0 # drop internal_state
            drop 0 # drop preferred_drink
            push super::event::want_coffee
            roll 1 # Stack: [want_coffee, id]
            tuple 2
            set_singleton
        } {
            pick 0
            push state::ordered
            equal
            branch {
                # Customer accepts coffee from barista
                drop 0 # drop internal_state
                push super::event::coffee
                roll 2 # Stack: [preferred_drink, coffee, id]
                roll 2 # Stack: [coffee, id, preferred_drink]
                tuple 3
                set_singleton
            } {
                pick 0
                push state::has_coffee
                equal
                branch {
                    # Customer accepts enjoy from environment
                    drop 0 # drop internal_state
                    drop 0 # drop preferred_drink
                    push super::event::enjoy
                    roll 1 # Stack: [enjoy, id]
                    tuple 2
                    set_singleton
                } {
                    pick 0
                    push state::thirsty
                    equal
                    branch {
                        # Thirsty state does not accept any inputs (empty_set)
                        drop 0
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        panic
                    }
                }
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit takes state: (id, preferred_drink, internal_state) and returns ValueSet of emitted events.
    # The emitted events are:
    # - If internal_state is thirsty: {(push_back, (id, preferred_drink))} (request to queue)
    sentence emit {
        untuple 3 # Stack: [id, preferred_drink, internal_state]
        pick 0
        push state::thirsty
        equal
        branch {
            # Customer emits order request to queue (push_back event)
            drop 0 # drop internal_state. Stack: [id, preferred_drink]
            tuple 2 # (id, preferred_drink)
            push super::super::queue::push_back
            roll 1
            tuple 2 # (push_back, (id, preferred_drink))
            push true
            tuple 2
        } {
            pick 0
            push state::idle
            equal
            branch {
                drop 0
                drop 0
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    tuple 0
                    push false
                    tuple 2
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        drop 0
                        drop 0
                        drop 0
                        tuple 0
                        push false
                        tuple 2
                    } {
                        panic
                    }
                }
            }
        }
    }

    # process takes [state, event] and returns next_state.
    # state is (id, preferred_drink, internal_state)
    sentence process {
        # Stack: [(id, preferred_drink, internal_state), event]
        roll 1 # Stack: [event, (id, preferred_drink, internal_state)]
        untuple 3 # Stack: [event, id, preferred_drink, internal_state]
        
        # Check internal_state
        pick 0
        push state::idle
        equal
        branch {
            # Transition from idle to thirsty
            drop 0
            roll 2
            drop 0
            push state::thirsty
            tuple 3
        } {
            pick 0
            push state::thirsty
            equal
            branch {
                # Transition from thirsty to ordered
                drop 0
                roll 2
                drop 0
                push state::ordered
                tuple 3
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    # Transition from ordered to has_coffee
                    drop 0
                    roll 2
                    drop 0
                    push state::has_coffee
                    tuple 3
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        # Transition from has_coffee to idle
                        drop 0
                        roll 2
                        drop 0
                        push state::idle
                        tuple 3
                    } {
                        panic
                    }
                }
            }
        }
    }
}

mod customer1 compose_static_closure(customer_impl, (super::customer_id::c1, super::event::latte, super::customer_impl::state::idle));

mod customer2 compose_static_closure(customer_impl, (super::customer_id::c2, super::event::espresso, super::customer_impl::state::idle));

mod barista {
    mod state {
        # Declare Barista states
        symbol idle             "Barista is idle"
        symbol awaiting_order   "Barista is awaiting order from queue"
        symbol brewing          "Barista is brewing coffee"
    }

    # Initializes barista state
    sentence init {
        push state::idle
    }

    # accept takes [state] and returns ValueSet.
    sentence accept {
        # Stack: [state]
        pick 0
        push state::idle
        equal
        branch {
            drop 0
            push empty_set
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0
                # Construct set of await_front.resp response (some.val)
                push super::super::queue::await_front
                set_singleton
                
                push super::super::prelude::resp
                set_singleton
                
                push super::super::prelude::some
                set_singleton
                
                push universal_set
                push ()
                set_singleton
                set_tuple 2 # (val, ())
                
                set_tuple 2 # (some, (val, ()))
                set_tuple 2 # (resp, (some, (val, ())))
                set_tuple 2 # (await_front, (resp, (some, (val, ()))))
            } {
                # Must be brewing
                drop 0
                push empty_set
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit takes [state] and returns ValueSet.
    # idle: emits await_front.req
    # brewing: emits (coffee, id, drink)
    sentence emit {
        # Stack: [state]
        pick 0
        push state::idle
        equal
        branch {
            drop 0
            push super::super::queue::await_front
            push super::super::prelude::req
            tuple 0
            tuple 2
            tuple 2
            push true
            tuple 2
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                # Must be brewing
                untuple 2 # Stack: [state_status, (id, drink)]
                roll 1 # Stack: [(id, drink), state_status]
                push state::brewing
                equal
                branch {
                    # Stack: [(id, drink)]
                    untuple 2 # Stack: [id, drink]
                    push super::event::coffee # Stack: [id, drink, coffee]
                    roll 2 # Stack: [drink, coffee, id]
                    roll 2 # Stack: [coffee, id, drink]
                    tuple 3 # Stack: [(coffee, id, drink)]
                    push true
                    tuple 2
                } {
                    panic
                }
            }
        }
    }

    # process takes [state, event] and returns next_state.
    sentence process {
        # Inputs: [state, event]
        pick 1 # state
        push state::idle
        equal
        branch {
            # Transition from idle to awaiting_order
            drop 0
            drop 0
            push state::awaiting_order
        } {
            pick 1 # state
            push state::awaiting_order
            equal
            branch {
                # Transition from awaiting_order to brewing.
                roll 1 # Stack: [event, state]
                drop 0 # drop state. Stack: [event]
                
                # Destructure event: (await_front, (resp, (some, (val, ()))))
                untuple 2
                drop 1 # drop await_front
                untuple 2 # Stack: [resp, option]
                drop 1 # drop resp. Stack: [option]
                untuple 2 # Stack: [variant, payload]
                drop 1 # drop variant (some)
                untuple 2 # Stack: [val, ()]
                drop 0 # drop ()
                
                push state::brewing
                roll 1
                tuple 2 # (state::brewing, val)
            } {
                # Must be brewing. Transition to idle.
                drop 0
                drop 0
                push state::idle
            }
        }
    }
}

sentence customers_sync {
    push empty_set
}

mod customers compose_concurrent(customer1, customer2, customers_sync);

sentence customers_queue_sync {
    push set_tuple(singleton(super::queue::push_back), universal_set)
}

mod customers_and_queue compose_concurrent(customers, super::queue::queue, customers_queue_sync);

sentence joint_sync {
    # Sync barista and queue on await_front
    push set_tuple(singleton(super::queue::await_front), universal_set)
    
    # Sync customers and barista on coffee
    push set_tuple(singleton(event::coffee), universal_set, universal_set)
    set_union
}

mod concurrent compose_concurrent(customers_and_queue, barista, joint_sync);

sentence hidden_events {
    push set_tuple(singleton(super::queue::push_back), universal_set)
    
    push set_tuple(singleton(event::coffee), universal_set, universal_set)
    set_union
    
    push set_tuple(singleton(super::queue::await_front), universal_set)
    set_union
}

mod hidden compose_hidden(concurrent, hidden_events);

# Helpers to drive tau transitions in tests
sentence drive_tau {
    # Stack: [state]
    pick 0
    jump hidden::tau_reduce
    untuple 2
    branch {
        roll 1
        drop 0
        jump drive_tau
    } {
        drop 0
    }
}

sentence drive_concurrent_tau {
    # Stack: [state]
    pick 0
    jump concurrent::tau_reduce
    untuple 2
    branch {
        roll 1
        drop 0
        jump drive_concurrent_tau
    } {
        drop 0
    }
}

# Test the hidden joint Customer-Queue-Barista system
test sentence verify_hidden_system {
    # 1. Initialize hidden joint state
    jump hidden::init
    
    # customer 1 wants coffee. Let's verify it is accepted (from environment).
    pick 0
    jump hidden::accept
    push (event::want_coffee, customer_id::c1)
    roll 1
    set_contains
    assert
    
    # 2. Trigger event::want_coffee for c1
    push (event::want_coffee, customer_id::c1)
    jump hidden::process
    
    # 3. Drive tau -> Barista serves Customer 1
    jump drive_tau
    
    # Verify state: Customer 1 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 # customers
    
    push super::queue::awaiting_push
    push ()
    push ()
    push ()
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint state
    equal
    assert
    
    # customer 2 wants coffee. Let's verify it is accepted.
    pick 0
    jump hidden::accept
    push (event::want_coffee, customer_id::c2)
    roll 1
    set_contains
    assert
    
    # 4. Trigger event::want_coffee for c2
    push (event::want_coffee, customer_id::c2)
    jump hidden::process
    
    # 5. Drive tau -> Barista serves Customer 2
    jump drive_tau
    
    # Verify state: Customer 1 and Customer 2 both have coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 # customers
    
    push super::queue::awaiting_push
    push ()
    push ()
    push ()
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint state
    equal
    assert
    
    # customer 1 enjoys coffee. Let's verify it is accepted.
    pick 0
    jump hidden::accept
    push (event::enjoy, customer_id::c1)
    roll 1
    set_contains
    assert
    
    # 6. Trigger enjoy for c1
    push (event::enjoy, customer_id::c1)
    jump hidden::process
    
    # Verify state: Customer 1 is idle, Customer 2 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 # customers
    
    push super::queue::awaiting_push
    push ()
    push ()
    push ()
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint
    equal
    assert
    
    # customer 2 enjoys coffee. Let's verify it is accepted.
    pick 0
    jump hidden::accept
    push (event::enjoy, customer_id::c2)
    roll 1
    set_contains
    assert
    
    # 7. Trigger enjoy for c2
    push (event::enjoy, customer_id::c2)
    jump hidden::process
    
    # Verify state: both idle
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 # customers
    
    push super::queue::awaiting_push
    push ()
    push ()
    push ()
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint
    equal
    assert
    
    drop 0 # clean up state
}

# Test the concurrent joint Customer-Queue-Barista system
test sentence verify_concurrent_system {
    # 1. Initialize joint state
    jump concurrent::init
    
    # 2. Barista requests await_front
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (super::queue::await_front, (super::prelude::req, ()))
    assert_eq
    
    push (super::queue::await_front, (super::prelude::req, ()))
    jump concurrent::process
    
    # 3. Customer 1 wants coffee (accepted from environment)
    pick 0
    jump concurrent::accept
    push (event::want_coffee, customer_id::c1)
    roll 1
    set_contains
    assert
    
    push (event::want_coffee, customer_id::c1)
    jump concurrent::process
    
    # 4. Customer 2 wants coffee (accepted from environment)
    pick 0
    jump concurrent::accept
    push (event::want_coffee, customer_id::c2)
    roll 1
    set_contains
    assert
    
    push (event::want_coffee, customer_id::c2)
    jump concurrent::process
    
    # 5. Customer 1 orders coffee (emitted request from customer)
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (super::queue::push_back, (customer_id::c1, event::latte))
    assert_eq
    
    push (super::queue::push_back, (customer_id::c1, event::latte))
    jump concurrent::process
    jump drive_concurrent_tau
    
    # 6. Queue responds to await_front request with the popped customer 1 value
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (super::queue::await_front, (super::prelude::resp, (super::prelude::some, ((customer_id::c1, event::latte), ()))))
    assert_eq
    
    push (super::queue::await_front, (super::prelude::resp, (super::prelude::some, ((customer_id::c1, event::latte), ()))))
    jump concurrent::process
    
    # 7. Customer 2 orders coffee (emitted request from customer)
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (super::queue::push_back, (customer_id::c2, event::espresso))
    assert_eq
    
    push (super::queue::push_back, (customer_id::c2, event::espresso))
    jump concurrent::process
    jump drive_concurrent_tau
    
    # 8. Barista finishes brewing for Customer 1
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (event::coffee, customer_id::c1, event::latte)
    assert_eq
    
    push (event::coffee, customer_id::c1, event::latte)
    jump concurrent::process
    
    # 9. Customer 1 enjoys coffee
    pick 0
    jump concurrent::accept
    push (event::enjoy, customer_id::c1)
    roll 1
    set_contains
    assert
    
    push (event::enjoy, customer_id::c1)
    jump concurrent::process
    
    # 10. Barista requests await_front
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (super::queue::await_front, (super::prelude::req, ()))
    assert_eq
    
    push (super::queue::await_front, (super::prelude::req, ()))
    jump concurrent::process
    
    # 11. Queue immediately responds to await_front request with the popped customer 2 value
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (super::queue::await_front, (super::prelude::resp, (super::prelude::some, ((customer_id::c2, event::espresso), ()))))
    assert_eq
    
    push (super::queue::await_front, (super::prelude::resp, (super::prelude::some, ((customer_id::c2, event::espresso), ()))))
    jump concurrent::process
    
    # 12. Barista finishes brewing for Customer 2
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (event::coffee, customer_id::c2, event::espresso)
    assert_eq
    
    push (event::coffee, customer_id::c2, event::espresso)
    jump concurrent::process
    
    # 13. Customer 2 enjoys coffee
    pick 0
    jump concurrent::accept
    push (event::enjoy, customer_id::c2)
    roll 1
    set_contains
    assert
    
    push (event::enjoy, customer_id::c2)
    jump concurrent::process
    
    # Verify final states
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 # customers
    
    push super::queue::idle
    push ()
    push ()
    push ()
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::idle # barista
    
    tuple 2 # joint
    equal
    assert
    
    drop 0 # clean up state
}

# Test the rejection of invalid events for Barista
test sentence verify_barista_rejection {
    # 1. Trigger invalid coffee event on idle (coffee is emit, not accept)
    jump barista::init
    
    jump barista::accept
    push (event::coffee, customer_id::c1, event::latte)
    roll 1
    set_contains
    push false
    assert_eq

    # 2. Test that barista in idle does NOT accept order directly (since orders are queued)
    jump barista::init
    jump barista::accept
    push (super::queue::push_back, (customer_id::c1, event::latte))
    roll 1
    set_contains
    push false
    assert_eq
    
    # 3. Test that barista in idle emits await_front.req
    jump barista::init
    jump barista::emit
    untuple 2
    assert
    push (super::queue::await_front, (super::prelude::req, ()))
    assert_eq
    
    # 4. Test that barista in awaiting_order accepts await_front.resp.some.val
    jump barista::init
    push (super::queue::await_front, (super::prelude::req, ()))
    jump barista::process # Transition to awaiting_order
    
    jump barista::accept
    push (super::queue::await_front, (super::prelude::resp, (super::prelude::some, ((customer_id::c1, event::latte), ()))))
    roll 1
    set_contains
    assert
    
    # 5. Test that barista in awaiting_order does NOT emit coffee
    jump barista::init
    push (super::queue::await_front, (super::prelude::req, ()))
    jump barista::process # Transition to awaiting_order
    
    jump barista::emit
    untuple 2
    not
    assert
    drop 0
}
