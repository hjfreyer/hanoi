# CSP Customer and Barista interaction simulation with state machines
# Modified to support multiple concurrent customers with preferred drinks

mod customer_id {
    symbol c1 "Customer 1"
    symbol c2 "Customer 2"
}

mod event {
    # Declare events
    symbol order       "Order event"
    symbol coffee      "Prepared coffee drink event"
    symbol want_coffee "Customer wants coffee event"
    symbol enjoy       "Customer enjoys coffee event"
    symbol latte       "Latte drink"
    symbol espresso    "Espresso drink"
}

mod customer_impl {
    mod state {
        # Declare Customer states
        symbol idle        "Customer is idle"
        symbol thirsty     "Customer is thirsty"
        symbol ordered     "Customer ordered coffee"
        symbol has_coffee  "Customer received coffee and has coffee"
    }

    # accept takes state: (id, preferred_drink, internal_state) and returns ValueSet of accepted events.
    # The accepted events are:
    # - If internal_state is idle: {(want_coffee, id)} (from environment)
    # - If internal_state is ordered: {(coffee, id, preferred_drink)} (from barista)
    # - If internal_state is has_coffee: {(enjoy, id)} (from environment)
    accept {
        pick 0
        untuple 3 # Stack: [state, id, preferred_drink, internal_state]
        pick 0
        push state::idle
        equal
        branch {
            # Customer accepts want_coffee from environment
            push super::event::want_coffee
            pick 3 # id
            tuple 2
            set_singleton
            drop 1
            drop 1
            drop 1
        } {
            pick 0
            push state::ordered
            equal
            branch {
                # Customer accepts coffee from barista
                push super::event::coffee
                pick 3 # id
                pick 3 # preferred_drink
                tuple 3
                set_singleton
                drop 1
                drop 1
                drop 1
            } {
                pick 0
                push state::has_coffee
                equal
                branch {
                    # Customer accepts enjoy from environment
                    push super::event::enjoy
                    pick 3 # id
                    tuple 2
                    set_singleton
                    drop 1
                    drop 1
                    drop 1
                } {
                    # Thirsty state does not accept any inputs (empty_set)
                    push empty_set
                    drop 1
                    drop 1
                    drop 1
                }
            }
        }
    }

    # emit takes state: (id, preferred_drink, internal_state) and returns ValueSet of emitted events.
    # The emitted events are:
    # - If internal_state is thirsty: {(order, id, preferred_drink)} (proactive request to barista)
    emit {
        pick 0
        untuple 3 # Stack: [state, id, preferred_drink, internal_state]
        pick 0
        push state::thirsty
        equal
        branch {
            # Customer emits order request to barista
            push super::event::order
            pick 3 # id
            pick 3 # preferred_drink
            tuple 3
            set_singleton
            drop 1
            drop 1
            drop 1
        } {
            # Idle, Ordered, and HasCoffee states do not emit requests (empty_set)
            push empty_set
            drop 1
            drop 1
            drop 1
        }
    }

    # process takes [state, event] and returns next_state.
    # state is (id, preferred_drink, internal_state)
    # event is one of the above.
    process {
        # Stack: [(id, preferred_drink, internal_state), event]
        roll 1 # Stack: [event, (id, preferred_drink, internal_state)]
        untuple 3 # Stack: [event, id, preferred_drink, internal_state]
        
        # Check internal_state
        pick 0
        push state::idle
        equal
        branch {
            # Transition from idle to thirsty
            drop 0
            roll 2
            drop 0
            push state::thirsty
            tuple 3
        } {
            pick 0
            push state::thirsty
            equal
            branch {
                # Transition from thirsty to ordered
                drop 0
                roll 2
                drop 0
                push state::ordered
                tuple 3
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    # Transition from ordered to has_coffee
                    drop 0
                    roll 2
                    drop 0
                    push state::has_coffee
                    tuple 3
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        # Transition from has_coffee to idle
                        drop 0
                        roll 2
                        drop 0
                        push state::idle
                        tuple 3
                    } {
                        panic
                    }
                }
            }
        }
    }
}

mod customer1 {
    init {
        push super::customer_id::c1
        push super::event::latte
        push super::customer_impl::state::idle
        tuple 3
    }
    accept {
        jump super::customer_impl::accept
    }
    emit {
        jump super::customer_impl::emit
    }
    process {
        jump super::customer_impl::process
    }
}

mod customer2 {
    init {
        push super::customer_id::c2
        push super::event::espresso
        push super::customer_impl::state::idle
        tuple 3
    }
    accept {
        jump super::customer_impl::accept
    }
    emit {
        jump super::customer_impl::emit
    }
    process {
        jump super::customer_impl::process
    }
}

mod barista {
    mod state {
        # Declare Barista states
        symbol idle      "Barista is idle"
        symbol brewing   "Barista is brewing coffee"
    }

    # Initializes barista state
    init {
        push state::idle
    }

    # accept takes [state] and returns ValueSet.
    # idle: accepts (order, id, drink) (passive input from customer)
    accept {
        pick 0
        push state::idle
        equal
        branch {
            push set_tuple(singleton(super::event::order), universal_set, universal_set)
        } {
            push empty_set
        }
    }

    # emit takes [state] and returns ValueSet.
    # brewing: emits (coffee, id, drink) (proactive request to serve coffee)
    emit {
        pick 0
        push state::idle
        equal
        branch {
            # Barista is idle, so emit nothing (empty_set)
            push empty_set
        } {
            pick 0
            untuple 2 # Stack: [state, state_status, (id, drink)]
            roll 1 # Stack: [state, (id, drink), state_status]
            push state::brewing
            equal
            branch {
                # Barista is brewing, so emit coffee delivery: {(coffee, id, drink)}
                # Stack: [state, (id, drink)]
                untuple 2 # Stack: [state, id, drink]
                push super::event::coffee # Stack: [state, id, drink, coffee]
                roll 2 # Stack: [state, drink, coffee, id]
                roll 2 # Stack: [state, coffee, id, drink]
                tuple 3 # Stack: [state, (coffee, id, drink)]
                set_singleton
            } {
                panic
            }
        }
    }

    # process takes [state, event] and returns next_state.
    process {
        # Inputs: [state, event]
        pick 1
        push state::idle
        equal
        branch {
            # Transition from idle to brewing.
            # event is (order, id, drink). We want next state to be (state::brewing, (id, drink)).
            # Stack: [state, event]
            roll 1 # Stack: [event, state]
            drop 0 # Stack: [event]
            
            untuple 3 # Stack: [order, id, drink]
            roll 2 # Stack: [id, drink, order]
            drop 0 # Stack: [id, drink]
            tuple 2 # Stack: [(id, drink)]
            push state::brewing
            roll 1
            tuple 2 # Stack: [(state::brewing, (id, drink))]
        } {
            # Transition from brewing to idle: state is (state::brewing, (id, drink)), event is (coffee, id, drink).
            # We want to return state::idle.
            # Stack: [state, event]
            drop 0
            drop 0
            push state::idle
        }
    }
}

customers_sync {
    push empty_set
}

sync_events {
    push union(
        set_tuple(singleton(event::order), universal_set, universal_set),
        set_tuple(singleton(event::coffee), universal_set, universal_set)
    )
}

mod customers compose_concurrent(customer1, customer2, customers_sync);
mod concurrent compose_concurrent(customers, barista, sync_events);
mod hidden compose_hidden(concurrent, sync_events);

# Test the hidden joint Customer-Barista system
test verify_hidden_system {
    # 1. Initialize hidden joint state -> [(((c1, latte, idle), (c2, espresso, idle)), idle)]
    jump hidden::init
    
    # customer 1 wants coffee. Let's verify it is accepted (from environment).
    push (event::want_coffee, customer_id::c1)
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 2. Trigger event::want_coffee for c1 -> [(((c1, latte, thirsty), (c2, espresso, idle)), idle)]
    push (event::want_coffee, customer_id::c1)
    jump hidden::process
    
    # customer 1 is thirsty, barista is idle.
    # Thus, the joint state should emit tau to perform order.
    push crate::prelude::event::tau
    pick 1
    jump hidden::emit
    drop 1
    set_contains
    assert
    
    # 3. Drive tau -> [(((c1, latte, ordered), (c2, espresso, idle)), (brewing, (c1, latte)))]
    push crate::prelude::event::tau
    jump hidden::process
    
    # customer 2 wants coffee. Let's verify it is accepted.
    push (event::want_coffee, customer_id::c2)
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 4. Trigger event::want_coffee for c2 -> [(((c1, latte, ordered), (c2, espresso, thirsty)), (brewing, (c1, latte)))]
    push (event::want_coffee, customer_id::c2)
    jump hidden::process
    
    # Barista is brewing for c1, so customer 2 cannot order yet.
    # Barista can finish brewing (coffee delivery), which is a hidden/sync event -> emits tau.
    push crate::prelude::event::tau
    pick 1
    jump hidden::emit
    drop 1
    set_contains
    assert
    
    # 5. Drive tau -> [(((c1, latte, has_coffee), (c2, espresso, thirsty)), idle)]
    push crate::prelude::event::tau
    jump hidden::process
    
    # customer 2 is thirsty, barista is idle. Emits tau (order).
    push crate::prelude::event::tau
    pick 1
    jump hidden::emit
    drop 1
    set_contains
    assert
    
    # 6. Drive tau -> [(((c1, latte, has_coffee), (c2, espresso, ordered)), (brewing, (c2, espresso)))]
    push crate::prelude::event::tau
    jump hidden::process
    
    # customer 1 enjoys coffee (unsynchronized). Let's verify it is accepted (from environment).
    push (event::enjoy, customer_id::c1)
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 7. Trigger enjoy for c1 -> [(((c1, latte, idle), (c2, espresso, ordered)), (brewing, (c2, espresso)))]
    push (event::enjoy, customer_id::c1)
    jump hidden::process
    
    # Barista finishes brewing for c2 (hidden) -> emits tau.
    push crate::prelude::event::tau
    pick 1
    jump hidden::emit
    drop 1
    set_contains
    assert
    
    # 8. Drive tau -> [(((c1, latte, idle), (c2, espresso, has_coffee)), idle)]
    push crate::prelude::event::tau
    jump hidden::process
    
    # customer 2 enjoys coffee (unsynchronized). Let's verify it is accepted.
    push (event::enjoy, customer_id::c2)
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 9. Trigger enjoy for c2 -> [(((c1, latte, idle), (c2, espresso, idle)), idle)]
    push (event::enjoy, customer_id::c2)
    jump hidden::process
    
    # Verify final states
    untuple 2
    push barista::state::idle
    assert_eq
    untuple 2
    untuple 3
    push customer_impl::state::idle
    assert_eq
    push event::espresso
    assert_eq
    push customer_id::c2
    assert_eq
    untuple 3
    push customer_impl::state::idle
    assert_eq
    push event::latte
    assert_eq
    push customer_id::c1
    assert_eq
}

# Test the concurrent joint Customer-Barista system
test verify_concurrent_system {
    # 1. Initialize joint state -> [(((c1, latte, idle), (c2, espresso, idle)), idle)]
    jump concurrent::init
    
    # 2. Customer 1 wants coffee (accepted from environment)
    push (event::want_coffee, customer_id::c1)
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push (event::want_coffee, customer_id::c1)
    jump concurrent::process
    
    # 3. Customer 2 wants coffee (accepted from environment)
    push (event::want_coffee, customer_id::c2)
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push (event::want_coffee, customer_id::c2)
    jump concurrent::process
    
    # 4. Customer 1 orders coffee (emitted request)
    push (event::order, customer_id::c1, event::latte)
    pick 1
    jump concurrent::emit
    drop 1
    set_contains
    assert
    
    push (event::order, customer_id::c1, event::latte)
    jump concurrent::process
    
    # 5. Barista finishes brewing for Customer 1 (emitted request)
    push (event::coffee, customer_id::c1, event::latte)
    pick 1
    jump concurrent::emit
    drop 1
    set_contains
    assert
    
    push (event::coffee, customer_id::c1, event::latte)
    jump concurrent::process
    
    # 6. Customer 2 orders coffee (emitted request)
    push (event::order, customer_id::c2, event::espresso)
    pick 1
    jump concurrent::emit
    drop 1
    set_contains
    assert
    
    push (event::order, customer_id::c2, event::espresso)
    jump concurrent::process
    
    # 7. Customer 1 enjoys coffee (accepted from environment)
    push (event::enjoy, customer_id::c1)
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push (event::enjoy, customer_id::c1)
    jump concurrent::process
    
    # 8. Barista finishes brewing for Customer 2 (emitted request)
    push (event::coffee, customer_id::c2, event::espresso)
    pick 1
    jump concurrent::emit
    drop 1
    set_contains
    assert
    
    push (event::coffee, customer_id::c2, event::espresso)
    jump concurrent::process
    
    # 9. Customer 2 enjoys coffee (accepted from environment)
    push (event::enjoy, customer_id::c2)
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push (event::enjoy, customer_id::c2)
    jump concurrent::process
    
    # Verify final states
    untuple 2
    push barista::state::idle
    assert_eq
    untuple 2
    untuple 3
    push customer_impl::state::idle
    assert_eq
    push event::espresso
    assert_eq
    push customer_id::c2
    assert_eq
    untuple 3
    push customer_impl::state::idle
    assert_eq
    push event::latte
    assert_eq
    push customer_id::c1
    assert_eq
}

# Test the rejection of invalid events for Customer
test verify_customer_rejection {
    # 1. Initialize state -> [(c1, latte, idle)]
    jump customer1::init
    
    # 2. Test that customer in idle accepts want_coffee but rejects coffee
    push (event::coffee, customer_id::c1, event::latte)
    pick 1
    jump customer1::accept
    drop 1
    set_contains
    push false
    assert_eq
    
    # Clean up state from the stack
    drop 0

    # 3. Test that customer 1 in thirsty emits (order, c1, latte)
    jump customer1::init
    push (event::want_coffee, customer_id::c1)
    jump customer1::process
    
    push (event::order, customer_id::c1, event::latte)
    pick 1
    jump customer1::emit
    drop 1
    set_contains
    assert
    
    # 4. Test that customer 1 in thirsty rejects (order, c1, espresso) as emit
    push (event::order, customer_id::c1, event::espresso)
    pick 1
    jump customer1::emit
    drop 1
    set_contains
    push false
    assert_eq
    
    # Clean up state
    drop 0

    # 5. Test that customer 1 in ordered accepts (coffee, c1, latte)
    jump customer1::init
    push (event::want_coffee, customer_id::c1)
    jump customer1::process
    push (event::order, customer_id::c1, event::latte)
    jump customer1::process # now in customer_impl::state::ordered
    
    push (event::coffee, customer_id::c1, event::latte)
    pick 1
    jump customer1::accept
    drop 1
    set_contains
    assert

    # 6. Test that customer 1 in ordered rejects (coffee, c1, espresso)
    push (event::coffee, customer_id::c1, event::espresso)
    pick 1
    jump customer1::accept
    drop 1
    set_contains
    push false
    assert_eq

    # Clean up state
    drop 0
}

# Test the rejection of invalid events for Barista
test verify_barista_rejection {
    # 1. Initialize state -> [barista::state::idle]
    jump barista::init
    
    # 2. Trigger invalid coffee event on idle (coffee is emit, not accept)
    push (event::coffee, customer_id::c1, event::latte)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0

    # 3. Test that barista in idle accepts (order, c1, latte)
    jump barista::init
    push (event::order, customer_id::c1, event::latte)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    assert
    drop 0
    
    # 4. Test that barista in idle accepts (order, c2, espresso)
    jump barista::init
    push (event::order, customer_id::c2, event::espresso)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    assert
    drop 0
    
    # 5. Test that barista in idle does NOT accept order (as a raw symbol)
    jump barista::init
    push event::order
    pick 1
    jump barista::accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0

    # 6. Test that barista in brewing (c1, latte) emits (coffee, c1, latte)
    jump barista::init
    push (event::order, customer_id::c1, event::latte)
    jump barista::process # now in brewing: (state::brewing, (c1, latte))
    
    push (event::coffee, customer_id::c1, event::latte)
    pick 1
    jump barista::emit
    drop 1
    set_contains
    assert
    drop 0

    # 7. Test that barista in brewing (c1, latte) rejects (coffee, c1, espresso) as emit
    jump barista::init
    push (event::order, customer_id::c1, event::latte)
    jump barista::process
    
    push (event::coffee, customer_id::c1, event::espresso)
    pick 1
    jump barista::emit
    drop 1
    set_contains
    push false
    assert_eq
    drop 0

    # 8. Test that barista in brewing (c1, latte) rejects (coffee, c2, latte) as emit
    jump barista::init
    push (event::order, customer_id::c1, event::latte)
    jump barista::process
    
    push (event::coffee, customer_id::c2, event::latte)
    pick 1
    jump barista::emit
    drop 1
    set_contains
    push false
    assert_eq
    drop 0
}
