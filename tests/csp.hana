# CSP Customer and Barista interaction simulation with state machines

mod event {
    # Declare events
    symbol order       "Order event"
    symbol coffee      "Prepared coffee drink event"
    symbol want_coffee "Customer wants coffee event"
    symbol enjoy       "Customer enjoys coffee event"
    symbol latte       "Latte drink"
    symbol espresso    "Espresso drink"
}

mod customer {
    mod state {
        # Declare Customer states
        symbol idle        "Customer is idle"
        symbol thirsty     "Customer is thirsty"
        symbol ordered     "Customer ordered coffee"
        symbol has_coffee  "Customer received coffee and has coffee"
    }

    # Initializes customer state
    init {
        push state::idle
    }

    # accept takes [state] and returns ValueSet.
    # It does not consume the state.
    accept {
        pick 0
        push state::idle
        equal
        branch {
            push singleton(super::event::want_coffee)
        } {
            pick 0
            push state::thirsty
            equal
            branch {
                push singleton((super::event::order, super::event::latte))
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    push singleton((super::event::coffee, super::event::latte))
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        push singleton(super::event::enjoy)
                    } {
                        panic
                    }
                }
            }
        }
    }

    # process takes [state, event] and returns next_state.
    # Assumes valid transition.
    process {
        pick 1
        push state::idle
        equal
        branch {
            drop 0
            drop 0
            push state::thirsty
        } {
            pick 1
            push state::thirsty
            equal
            branch {
                drop 0
                drop 0
                push state::ordered
            } {
                pick 1
                push state::ordered
                equal
                branch {
                    drop 0
                    drop 0
                    push state::has_coffee
                } {
                    pick 1
                    push state::has_coffee
                    equal
                    branch {
                        drop 0
                        drop 0
                        push state::idle
                    } {
                        panic
                    }
                }
            }
        }
    }
}

mod barista {
    mod state {
        # Declare Barista states
        symbol idle      "Barista is idle"
        symbol brewing   "Barista is brewing coffee"
    }

    # Initializes barista state
    init {
        push state::idle
    }

    # accept takes [state] and returns ValueSet.
    # It does not consume the state.
    accept {
        pick 0
        push state::idle
        equal
        branch {
            push set_tuple(singleton(super::event::order), universal_set)
        } {
            pick 0
            untuple 2
            roll 1
            push state::brewing
            equal
            branch {
                # Stack: [state, drink]
                push super::event::coffee
                roll 1
                tuple 2
                set_singleton
            } {
                panic
            }
        }
    }

    # process takes [state, event] and returns next_state.
    # Assumes valid transition.
    process {
        pick 1
        push state::idle
        equal
        branch {
            # Transition from idle to brewing: state is idle, event is (order, drink)
            # Inputs: [state, event]
            untuple 2 # Stack: [state, order, drink]
            roll 1    # Swaps order and drink. Stack: [state, drink, order]
            drop 0    # Drops order. Stack: [state, drink]
            roll 1    # Swaps state and drink. Stack: [drink, state]
            drop 0    # Drops state. Stack: [drink]
            
            # Construct (brewing, drink)
            push state::brewing
            roll 1    # Swaps state::brewing and drink. Stack: [state::brewing, drink]
            tuple 2
        } {
            # Transition from brewing to idle: state is (brewing, drink), event is (coffee, drink)
            # Check if the state is indeed a brewing state
            pick 1
            untuple 2 # Stack: [state, event, state_status, drink]
            drop 0    # Drops drink. Stack: [state, event, state_status]
            push state::brewing
            equal
            branch {
                drop 0
                drop 0
                push state::idle
            } {
                panic
            }
        }
    }
}

mod concurrent {
    # init initializes a joint state tuple: (customer_state, barista_state)
    init {
        push super::customer::state::idle
        push super::barista::state::idle
        tuple 2
    }

    # accept takes [joint_state] and returns ValueSet.
    # It does not consume the joint_state.
    accept {
        pick 0
        untuple 2
        roll 1
        jump super::customer::accept
        drop 1
        roll 1
        jump super::barista::accept
        drop 1
        # Stack: [joint_state, C_accept, B_accept]
        
        # We want to compute:
        # 1. SyncAccepted = intersection(intersection(C_accept, B_accept), SyncSet)
        # 2. NonHiddenAccepted = intersection(union(C_accept, B_accept), NonHiddenSet)
        # 3. Result = union(SyncAccepted, NonHiddenAccepted)
        
        # Let's copy C_accept and B_accept to compute union:
        pick 1
        pick 1
        set_union
        # Stack: [joint_state, C_accept, B_accept, C_union_B]
        
        # NonHiddenSet = union(singleton(super::event::want_coffee), singleton(super::event::enjoy))
        push union(singleton(super::event::want_coffee), singleton(super::event::enjoy))
        set_intersection
        # Stack: [joint_state, C_accept, B_accept, NonHiddenAccepted]
        
        # Now compute SyncAccepted. We have C_accept and B_accept at depth 2 and 1:
        roll 2 # moves C_accept to top. Stack: [joint_state, B_accept, NonHiddenAccepted, C_accept]
        roll 2 # moves B_accept to top. Stack: [joint_state, NonHiddenAccepted, C_accept, B_accept]
        set_intersection
        # Stack: [joint_state, NonHiddenAccepted, C_B_intersection]
        
        # SyncSet = union(set_tuple(singleton(super::event::order), universal_set), set_tuple(singleton(super::event::coffee), universal_set))
        push union(set_tuple(singleton(super::event::order), universal_set), set_tuple(singleton(super::event::coffee), universal_set))
        set_intersection
        # Stack: [joint_state, NonHiddenAccepted, SyncAccepted]
        
        # Finally, union the two results:
        set_union
        # Stack: [joint_state, Result]
    }

    # process takes [joint_state, event] and returns [next_joint_state]
    process {
        # Check if event is synchronized
        pick 0
        push union(set_tuple(singleton(super::event::order), universal_set), set_tuple(singleton(super::event::coffee), universal_set))
        set_contains
        
        # Stack: [joint_state, event, is_synchronized]
        branch {
            # --- SYNCHRONIZED CASE ---
            # Event is order or coffee. Send to both.
            # Stack: [joint_state, event]
            roll 1
            # Stack: [event, joint_state]
            untuple 2
            # Stack: [event, C, B]
            
            pick 2  # copies event -> Stack: [event, C, B, event]
            roll 2  # moves C to top -> Stack: [event, B, event, C]
            roll 1  # swaps event and C -> Stack: [event, B, C, event]
            jump super::customer::process
            # Stack: [event, B, C']
            
            roll 1  # swaps C' and B -> Stack: [event, C', B]
            roll 2  # moves event to top -> Stack: [C', B, event]
            jump super::barista::process
            # Stack: [C', B']
            tuple 2
        } {
            # --- UNSYNCHRONIZED CASE ---
            # Stack: [joint_state, event]
            roll 1
            # Stack: [event, joint_state]
            untuple 2
            # Stack: [event, C, B]
            
            # Check if Customer accepts event
            pick 1  # copies C -> Stack: [event, C, B, C]
            jump super::customer::accept
            # Stack: [event, C, B, C, C_accept]
            drop 1  # drops C -> Stack: [event, C, B, C_accept]
            pick 3  # copies event -> Stack: [event, C, B, C_accept, event]
            roll 1  # swaps C_accept and event -> Stack: [event, C, B, event, C_accept]
            set_contains
            # Stack: [event, C, B, customer_accepts]
            
            # Check if Barista accepts event
            pick 1  # copies B -> Stack: [event, C, B, customer_accepts, B]
            jump super::barista::accept
            # Stack: [event, C, B, customer_accepts, B, B_accept]
            drop 1  # drops B -> Stack: [event, C, B, customer_accepts, B_accept]
            pick 4  # copies event -> Stack: [event, C, B, customer_accepts, B_accept, event]
            roll 1  # swaps B_accept and event -> Stack: [event, C, B, customer_accepts, event, B_accept]
            set_contains
            # Stack: [event, C, B, customer_accepts, barista_accepts]
            
            # Now branch on customer_accepts (which is at depth 1, so let's roll it to top)
            roll 1  # swaps customer_accepts and barista_accepts -> Stack: [event, C, B, barista_accepts, customer_accepts]
            branch {
                # Customer accepts!
                # Clean up barista_accepts
                drop 0  # drops barista_accepts -> Stack: [event, C, B]
                
                # Send event to Customer only
                pick 2  # copies event -> Stack: [event, C, B, event]
                roll 2  # moves C to top -> Stack: [event, B, event, C]
                roll 1  # swaps event and C -> Stack: [event, B, C, event]
                jump super::customer::process
                # Stack: [event, B, C']
                
                roll 2  # moves event to top -> Stack: [B, C', event]
                drop 0  # drops event -> Stack: [B, C']
                roll 1  # swaps C' and B -> Stack: [C', B]
                tuple 2
            } {
                # Customer did not accept. Check if Barista accepts (which is at top of stack!)
                # Stack: [event, C, B, barista_accepts]
                branch {
                    # Barista accepts!
                    # Send event to Barista only
                    # Stack: [event, C, B]
                    pick 2  # copies event -> Stack: [event, C, B, event]
                    jump super::barista::process
                    # Stack: [event, C, B']
                    
                    roll 2  # moves event to top -> Stack: [C, B', event]
                    drop 0  # drops event -> Stack: [C, B']
                    tuple 2
                } {
                    # Neither accepts! Panic!
                    panic
                }
            }
        }
    }
}

mod hidden {
    # init initializes the joint state.
    init {
        jump super::concurrent::init
    }

    # set pushes the ValueSet of hidden events.
    set {
        push union(set_tuple(singleton(super::event::order), universal_set), set_tuple(singleton(super::event::coffee), universal_set))
    }

    # accept takes [joint_state] and returns ValueSet.
    # It does not consume the joint_state.
    accept {
        pick 0
        jump super::concurrent::accept
        drop 1
        # Stack: [joint_state, JointAccept]
        
        # Compute NonHiddenAccepted = difference(JointAccept, SyncSet)
        pick 0
        jump set
        set_difference
        # Stack: [joint_state, JointAccept, NonHiddenAccepted]
        
        # Compute HasSync = intersection(JointAccept, SyncSet)
        roll 1 # moves JointAccept to top. Stack: [joint_state, NonHiddenAccepted, JointAccept]
        jump set
        set_intersection
        # Stack: [joint_state, NonHiddenAccepted, HasSync]
        
        # Check if HasSync is empty
        push empty_set
        equal
        branch {
            # HasSync is empty. Just return NonHiddenAccepted.
            # Stack: [joint_state, NonHiddenAccepted]
        } {
            # HasSync is not empty! Union with singleton(crate::prelude::event::tau).
            # Stack: [joint_state, NonHiddenAccepted]
            push singleton(crate::prelude::event::tau)
            set_union
            # Stack: [joint_state, Result]
        }
    }

    # process takes [joint_state, event] and returns next_joint_state.
    process {
        pick 0
        push crate::prelude::event::tau
        equal
        branch {
            drop 0 # drop crate::prelude::event::tau
            
            jump super::concurrent::accept
            jump set
            set_intersection
            set_choose
            untuple 2
            branch {
                jump super::concurrent::process
            } {
                panic
            }
        } {
            jump super::concurrent::process
        }
    }
}

# Test the hidden joint Customer-Barista system
test verify_hidden_system {
    # 1. Initialize hidden joint state -> [(customer::state::idle, barista::state::idle)]
    jump hidden::init
    
    # customer::state::idle accepts event::want_coffee. Let's verify.
    push event::want_coffee
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 2. Trigger event::want_coffee -> [(customer::state::thirsty, barista::state::idle)]
    push event::want_coffee
    jump hidden::process
    
    # In customer::state::thirsty, customer wants to order (event::order, which is synchronized/hidden).
    # Thus, the joint state should accept crate::prelude::event::tau.
    push crate::prelude::event::tau
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 3. Drive tau -> [(customer::state::ordered, barista::state::brewing)]
    push crate::prelude::event::tau
    jump hidden::process
    
    # In customer::state::ordered / barista::state::brewing, event::coffee is synchronized/hidden.
    # Thus, the joint state should accept crate::prelude::event::tau.
    push crate::prelude::event::tau
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 4. Drive tau -> [(customer::state::has_coffee, barista::state::idle)]
    push crate::prelude::event::tau
    jump hidden::process
    
    # In customer::state::has_coffee, customer wants event::enjoy (unsynchronized).
    # Thus, the joint state should accept event::enjoy.
    push event::enjoy
    pick 1
    jump hidden::accept
    drop 1
    set_contains
    assert
    
    # 5. Trigger event::enjoy -> [(customer::state::idle, barista::state::idle)]
    push event::enjoy
    jump hidden::process
    
    # Verify final states
    untuple 2
    push barista::state::idle
    assert_eq
    push customer::state::idle
    assert_eq
}

# Test the concurrent joint Customer-Barista system
test verify_concurrent_system {
    # 1. Initialize joint state -> [(customer::state::idle, barista::state::idle)]
    jump concurrent::init
    
    # 2. Customer wants coffee
    push event::want_coffee
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push event::want_coffee
    jump concurrent::process # [(customer::state::thirsty, barista::state::idle)]
    
    # 3. Customer orders coffee / Barista receives order: trigger (event::order, event::latte)
    push (event::order, event::latte)
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push (event::order, event::latte)
    jump concurrent::process # [(customer::state::ordered, barista::state::brewing)]
    
    # 4. Barista finishes brewing / Customer receives coffee: trigger (event::coffee, event::latte)
    push (event::coffee, event::latte)
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push (event::coffee, event::latte)
    jump concurrent::process # [(customer::state::has_coffee, barista::state::idle)]
    
    # 5. Customer enjoys coffee
    push event::enjoy
    pick 1
    jump concurrent::accept
    drop 1
    set_contains
    assert
    
    push event::enjoy
    jump concurrent::process # [(customer::state::idle, barista::state::idle)]
    
    # Verify final states
    untuple 2
    push barista::state::idle
    assert_eq
    push customer::state::idle
    assert_eq
}

# Test the rejection of invalid events for Customer
test verify_customer_rejection {
    # 1. Initialize state -> [customer::state::idle]
    jump customer::init
    
    # 2. Trigger invalid coffee event on idle -> [customer::state::idle]
    push event::coffee
    pick 1
    jump customer::accept
    drop 1
    set_contains
    
    # Assert that the return value is false
    push false
    assert_eq
    
    # Clean up state from the stack
    drop 0

    # 3. Test that customer in thirsty accepts (event::order, event::latte)
    jump customer::init
    push event::want_coffee
    jump customer::process
    
    push (event::order, event::latte)
    pick 1
    jump customer::accept
    drop 1
    set_contains
    assert
    
    # 4. Test that customer in thirsty rejects (event::order, event::espresso)
    push (event::order, event::espresso)
    pick 1
    jump customer::accept
    drop 1
    set_contains
    push false
    assert_eq
    
    # Clean up state
    drop 0

    # 5. Test that customer in ordered accepts (event::coffee, event::latte)
    jump customer::init
    push event::want_coffee
    jump customer::process
    push (event::order, event::latte)
    jump customer::process # now in customer::state::ordered
    
    push (event::coffee, event::latte)
    pick 1
    jump customer::accept
    drop 1
    set_contains
    assert

    # 6. Test that customer in ordered rejects (event::coffee, event::espresso)
    push (event::coffee, event::espresso)
    pick 1
    jump customer::accept
    drop 1
    set_contains
    push false
    assert_eq

    # Clean up state
    drop 0
}

# Test the rejection of invalid events for Barista
test verify_barista_rejection {
    # 1. Initialize state -> [barista::state::idle]
    jump barista::init
    
    # 2. Trigger invalid coffee event on idle -> [barista::state::idle]
    push event::coffee
    pick 1
    jump barista::accept
    drop 1
    set_contains
    
    # Assert that the return value is false
    push false
    assert_eq
    
    # Clean up state from the stack
    drop 0

    # 3. Test that barista in idle accepts (event::order, event::latte)
    jump barista::init
    push (event::order, event::latte)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    assert
    drop 0
    
    # 4. Test that barista in idle accepts (event::order, event::espresso)
    jump barista::init
    push (event::order, event::espresso)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    assert
    drop 0
    
    # 5. Test that barista in idle does NOT accept event::order (as a raw symbol)
    jump barista::init
    push event::order
    pick 1
    jump barista::accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0

    # 6. Test that barista in brewing (latte) accepts (event::coffee, event::latte)
    jump barista::init
    push (event::order, event::latte)
    jump barista::process # now in barista::state::brewing state: (barista::state::brewing, latte)
    
    push (event::coffee, event::latte)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    assert
    drop 0

    # 7. Test that barista in brewing (latte) rejects (event::coffee, event::espresso)
    jump barista::init
    push (event::order, event::latte)
    jump barista::process # now in barista::state::brewing state: (barista::state::brewing, latte)
    
    push (event::coffee, event::espresso)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0

    # 8. Test that barista in brewing (espresso) accepts (event::coffee, event::espresso)
    jump barista::init
    push (event::order, event::espresso)
    jump barista::process # now in barista::state::brewing state: (barista::state::brewing, espresso)
    
    push (event::coffee, event::espresso)
    pick 1
    jump barista::accept
    drop 1
    set_contains
    assert
    drop 0

    # 9. Test that barista in brewing (latte) does NOT accept event::coffee (as a raw symbol)
    jump barista::init
    push (event::order, event::latte)
    jump barista::process # now in barista::state::brewing state: (barista::state::brewing, latte)
    
    push event::coffee
    pick 1
    jump barista::accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0
}
