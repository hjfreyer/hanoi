# CSP Customer and Barista interaction simulation with state machines

# Declare Customer states
symbol customer_state_idle        "Customer is idle"
symbol customer_state_thirsty     "Customer is thirsty"
symbol customer_state_ordered     "Customer ordered coffee"
symbol customer_state_has_coffee  "Customer received coffee and has coffee"

# Declare Barista states
symbol barista_state_idle      "Barista is idle"
symbol barista_state_brewing   "Barista is brewing coffee"

# Declare events
symbol event_order       "Order event"
symbol event_coffee      "Prepared coffee drink event"
symbol event_want_coffee "Customer wants coffee event"
symbol event_enjoy       "Customer enjoys coffee event"
symbol event_tau          "Tau event"
symbol event_latte       "Latte drink"
symbol event_espresso    "Espresso drink"

# Declare statuses
symbol status_rejected    "Event was rejected"

# Initializes customer state
init_customer {
    push customer_state_idle
}

# Initializes barista state
init_barista {
    push barista_state_idle
}

# customer_accept takes [state] and returns ValueSet.
# It does not consume the state.
customer_accept {
    pick 0
    push customer_state_idle
    equal
    branch {
        push singleton(event_want_coffee)
    } {
        pick 0
        push customer_state_thirsty
        equal
        branch {
            push singleton((event_order, event_latte))
        } {
            pick 0
            push customer_state_ordered
            equal
            branch {
                push singleton((event_coffee, event_latte))
            } {
                pick 0
                push customer_state_has_coffee
                equal
                branch {
                    push singleton(event_enjoy)
                } {
                    panic
                }
            }
        }
    }
}

# customer_process takes [state, event] and returns next_state.
# Assumes valid transition.
customer_process {
    pick 1
    push customer_state_idle
    equal
    branch {
        drop 0
        drop 0
        push customer_state_thirsty
    } {
        pick 1
        push customer_state_thirsty
        equal
        branch {
            drop 0
            drop 0
            push customer_state_ordered
        } {
            pick 1
            push customer_state_ordered
            equal
            branch {
                drop 0
                drop 0
                push customer_state_has_coffee
            } {
                pick 1
                push customer_state_has_coffee
                equal
                branch {
                    drop 0
                    drop 0
                    push customer_state_idle
                } {
                    panic
                }
            }
        }
    }
}

# barista_accept takes [state] and returns ValueSet.
# It does not consume the state.
barista_accept {
    pick 0
    push barista_state_idle
    equal
    branch {
        push set_tuple(singleton(event_order), universal_set)
    } {
        pick 0
        untuple 2
        roll 1
        push barista_state_brewing
        equal
        branch {
            # Stack: [state, drink]
            push event_coffee
            roll 1
            tuple 2
            set_singleton
        } {
            panic
        }
    }
}

# barista_process takes [state, event] and returns next_state.
# Assumes valid transition.
barista_process {
    pick 1
    push barista_state_idle
    equal
    branch {
        # Transition from idle to brewing: state is barista_state_idle, event is (event_order, drink)
        # Inputs: [state, event]
        untuple 2 # Stack: [state, event_order, drink]
        roll 1    # Swaps event_order and drink. Stack: [state, drink, event_order]
        drop 0    # Drops event_order. Stack: [state, drink]
        roll 1    # Swaps state and drink. Stack: [drink, state]
        drop 0    # Drops state. Stack: [drink]
        
        # Construct (barista_state_brewing, drink)
        push barista_state_brewing
        roll 1    # Swaps barista_state_brewing and drink. Stack: [barista_state_brewing, drink]
        tuple 2
    } {
        # Transition from brewing to idle: state is (barista_state_brewing, drink), event is (event_coffee, drink)
        # Check if the state is indeed a brewing state
        pick 1
        untuple 2 # Stack: [state, event, state_status, drink]
        drop 0    # Drops drink. Stack: [state, event, state_status]
        push barista_state_brewing
        equal
        branch {
            drop 0
            drop 0
            push barista_state_idle
        } {
            panic
        }
    }
}

# concurrent_init initializes a joint state tuple: (customer_state, barista_state)
concurrent_init {
    push customer_state_idle
    push barista_state_idle
    tuple 2
}

# concurrent_accept takes [joint_state] and returns ValueSet.
# It does not consume the joint_state.
concurrent_accept {
    pick 0
    untuple 2
    roll 1
    jump customer_accept
    drop 1
    roll 1
    jump barista_accept
    drop 1
    # Stack: [joint_state, C_accept, B_accept]
    
    # We want to compute:
    # 1. SyncAccepted = intersection(intersection(C_accept, B_accept), SyncSet)
    # 2. NonHiddenAccepted = intersection(union(C_accept, B_accept), NonHiddenSet)
    # 3. Result = union(SyncAccepted, NonHiddenAccepted)
    
    # Let's copy C_accept and B_accept to compute union:
    pick 1
    pick 1
    set_union
    # Stack: [joint_state, C_accept, B_accept, C_union_B]
    
    # NonHiddenSet = union(singleton(event_want_coffee), singleton(event_enjoy))
    push union(singleton(event_want_coffee), singleton(event_enjoy))
    set_intersection
    # Stack: [joint_state, C_accept, B_accept, NonHiddenAccepted]
    
    # Now compute SyncAccepted. We have C_accept and B_accept at depth 2 and 1:
    roll 2 # moves C_accept to top. Stack: [joint_state, B_accept, NonHiddenAccepted, C_accept]
    roll 2 # moves B_accept to top. Stack: [joint_state, NonHiddenAccepted, C_accept, B_accept]
    set_intersection
    # Stack: [joint_state, NonHiddenAccepted, C_B_intersection]
    
    # SyncSet = union(set_tuple(singleton(event_order), universal_set), set_tuple(singleton(event_coffee), universal_set))
    push union(set_tuple(singleton(event_order), universal_set), set_tuple(singleton(event_coffee), universal_set))
    set_intersection
    # Stack: [joint_state, NonHiddenAccepted, SyncAccepted]
    
    # Finally, union the two results:
    set_union
    # Stack: [joint_state, Result]
}

# concurrent_process takes [joint_state, event] and returns [next_joint_state]
concurrent_process {
    # Check if event is synchronized
    pick 0
    push union(set_tuple(singleton(event_order), universal_set), set_tuple(singleton(event_coffee), universal_set))
    set_contains
    
    # Stack: [joint_state, event, is_synchronized]
    branch {
        # --- SYNCHRONIZED CASE ---
        # Event is order or coffee. Send to both.
        # Stack: [joint_state, event]
        roll 1
        # Stack: [event, joint_state]
        untuple 2
        # Stack: [event, C, B]
        
        pick 2  # copies event -> Stack: [event, C, B, event]
        roll 2  # moves C to top -> Stack: [event, B, event, C]
        roll 1  # swaps event and C -> Stack: [event, B, C, event]
        jump customer_process
        # Stack: [event, B, C']
        
        roll 1  # swaps C' and B -> Stack: [event, C', B]
        roll 2  # moves event to top -> Stack: [C', B, event]
        jump barista_process
        # Stack: [C', B']
        tuple 2
    } {
        # --- UNSYNCHRONIZED CASE ---
        # Stack: [joint_state, event]
        roll 1
        # Stack: [event, joint_state]
        untuple 2
        # Stack: [event, C, B]
        
        # Check if Customer accepts event
        pick 1  # copies C -> Stack: [event, C, B, C]
        jump customer_accept
        # Stack: [event, C, B, C, C_accept]
        drop 1  # drops C -> Stack: [event, C, B, C_accept]
        pick 3  # copies event -> Stack: [event, C, B, C_accept, event]
        roll 1  # swaps C_accept and event -> Stack: [event, C, B, event, C_accept]
        set_contains
        # Stack: [event, C, B, customer_accepts]
        
        # Check if Barista accepts event
        pick 1  # copies B -> Stack: [event, C, B, customer_accepts, B]
        jump barista_accept
        # Stack: [event, C, B, customer_accepts, B, B_accept]
        drop 1  # drops B -> Stack: [event, C, B, customer_accepts, B_accept]
        pick 4  # copies event -> Stack: [event, C, B, customer_accepts, B_accept, event]
        roll 1  # swaps B_accept and event -> Stack: [event, C, B, customer_accepts, event, B_accept]
        set_contains
        # Stack: [event, C, B, customer_accepts, barista_accepts]
        
        # Now branch on customer_accepts (which is at depth 1, so let's roll it to top)
        roll 1  # swaps customer_accepts and barista_accepts -> Stack: [event, C, B, barista_accepts, customer_accepts]
        branch {
            # Customer accepts!
            # Clean up barista_accepts
            drop 0  # drops barista_accepts -> Stack: [event, C, B]
            
            # Send event to Customer only
            pick 2  # copies event -> Stack: [event, C, B, event]
            roll 2  # moves C to top -> Stack: [event, B, event, C]
            roll 1  # swaps event and C -> Stack: [event, B, C, event]
            jump customer_process
            # Stack: [event, B, C']
            
            roll 2  # moves event to top -> Stack: [B, C', event]
            drop 0  # drops event -> Stack: [B, C']
            roll 1  # swaps C' and B -> Stack: [C', B]
            tuple 2
        } {
            # Customer did not accept. Check if Barista accepts (which is at top of stack!)
            # Stack: [event, C, B, barista_accepts]
            branch {
                # Barista accepts!
                # Send event to Barista only
                # Stack: [event, C, B]
                pick 2  # copies event -> Stack: [event, C, B, event]
                jump barista_process
                # Stack: [event, C, B']
                
                roll 2  # moves event to top -> Stack: [C, B', event]
                drop 0  # drops event -> Stack: [C, B']
                tuple 2
            } {
                # Neither accepts! Panic!
                panic
            }
        }
    }
}

# hidden_init initializes the joint state.
hidden_init {
    jump concurrent_init
}

# hidden_set pushes the ValueSet of hidden events.
hidden_set {
    push union(set_tuple(singleton(event_order), universal_set), set_tuple(singleton(event_coffee), universal_set))
}

# hidden_accept takes [joint_state] and returns ValueSet.
# It does not consume the joint_state.
hidden_accept {
    pick 0
    jump concurrent_accept
    drop 1
    # Stack: [joint_state, JointAccept]
    
    # Compute NonHiddenAccepted = difference(JointAccept, SyncSet)
    pick 0
    jump hidden_set
    set_difference
    # Stack: [joint_state, JointAccept, NonHiddenAccepted]
    
    # Compute HasSync = intersection(JointAccept, SyncSet)
    roll 1 # moves JointAccept to top. Stack: [joint_state, NonHiddenAccepted, JointAccept]
    jump hidden_set
    set_intersection
    # Stack: [joint_state, NonHiddenAccepted, HasSync]
    
    # Check if HasSync is empty
    push empty_set
    equal
    branch {
        # HasSync is empty. Just return NonHiddenAccepted.
        # Stack: [joint_state, NonHiddenAccepted]
    } {
        # HasSync is not empty! Union with singleton(event_tau).
        # Stack: [joint_state, NonHiddenAccepted]
        push singleton(event_tau)
        set_union
        # Stack: [joint_state, Result]
    }
}

# hidden_process takes [joint_state, event] and returns next_joint_state.
hidden_process {
    pick 0
    push event_tau
    equal
    branch {
        drop 0 # drop event_tau
        
        jump concurrent_accept
        jump hidden_set
        set_intersection
        set_choose
        untuple 2
        branch {
            jump concurrent_process
        } {
            panic
        }
    } {
        jump concurrent_process
    }
}

# Test the hidden joint Customer-Barista system
test verify_hidden_system {
    # 1. Initialize hidden joint state -> [(customer_state_idle, barista_state_idle)]
    jump hidden_init
    
    # customer_state_idle accepts event_want_coffee. Let's verify.
    push event_want_coffee
    pick 1
    jump hidden_accept
    drop 1
    set_contains
    assert
    
    # 2. Trigger event_want_coffee -> [(customer_state_thirsty, barista_state_idle)]
    push event_want_coffee
    jump hidden_process
    
    # In customer_state_thirsty, customer wants to order (event_order, which is synchronized/hidden).
    # Thus, the joint state should accept event_tau.
    push event_tau
    pick 1
    jump hidden_accept
    drop 1
    set_contains
    assert
    
    # 3. Drive event_tau -> [(customer_state_ordered, barista_state_brewing)]
    push event_tau
    jump hidden_process
    
    # In customer_state_ordered / barista_state_brewing, event_coffee is synchronized/hidden.
    # Thus, the joint state should accept event_tau.
    push event_tau
    pick 1
    jump hidden_accept
    drop 1
    set_contains
    assert
    
    # 4. Drive event_tau -> [(customer_state_has_coffee, barista_state_idle)]
    push event_tau
    jump hidden_process
    
    # In customer_state_has_coffee, customer wants event_enjoy (unsynchronized).
    # Thus, the joint state should accept event_enjoy.
    push event_enjoy
    pick 1
    jump hidden_accept
    drop 1
    set_contains
    assert
    
    # 5. Trigger event_enjoy -> [(customer_state_idle, barista_state_idle)]
    push event_enjoy
    jump hidden_process
    
    # Verify final states
    untuple 2
    push barista_state_idle
    assert_eq
    push customer_state_idle
    assert_eq
}

# Test the concurrent joint Customer-Barista system
test verify_concurrent_system {
    # 1. Initialize joint state -> [(customer_state_idle, barista_state_idle)]
    jump concurrent_init
    
    # 2. Customer wants coffee
    push event_want_coffee
    pick 1
    jump concurrent_accept
    drop 1
    set_contains
    assert
    
    push event_want_coffee
    jump concurrent_process # [(customer_state_thirsty, barista_state_idle)]
    
    # 3. Customer orders coffee / Barista receives order: trigger (event_order, event_latte)
    push (event_order, event_latte)
    pick 1
    jump concurrent_accept
    drop 1
    set_contains
    assert
    
    push (event_order, event_latte)
    jump concurrent_process # [(customer_state_ordered, barista_state_brewing)]
    
    # 4. Barista finishes brewing / Customer receives coffee: trigger (event_coffee, event_latte)
    push (event_coffee, event_latte)
    pick 1
    jump concurrent_accept
    drop 1
    set_contains
    assert
    
    push (event_coffee, event_latte)
    jump concurrent_process # [(customer_state_has_coffee, barista_state_idle)]
    
    # 5. Customer enjoys coffee
    push event_enjoy
    pick 1
    jump concurrent_accept
    drop 1
    set_contains
    assert
    
    push event_enjoy
    jump concurrent_process # [(customer_state_idle, barista_state_idle)]
    
    # Verify final states
    untuple 2
    push barista_state_idle
    assert_eq
    push customer_state_idle
    assert_eq
}

# Test the rejection of invalid events for Customer
test verify_customer_rejection {
    # 1. Initialize state -> [customer_state_idle]
    jump init_customer
    
    # 2. Trigger invalid coffee event on idle -> [customer_state_idle]
    push event_coffee
    pick 1
    jump customer_accept
    drop 1
    set_contains
    
    # Assert that the return value is false
    push false
    assert_eq
    
    # Clean up state from the stack
    drop 0

    # 3. Test that customer in thirsty accepts (event_order, event_latte)
    jump init_customer
    push event_want_coffee
    jump customer_process
    
    push (event_order, event_latte)
    pick 1
    jump customer_accept
    drop 1
    set_contains
    assert
    
    # 4. Test that customer in thirsty rejects (event_order, event_espresso)
    push (event_order, event_espresso)
    pick 1
    jump customer_accept
    drop 1
    set_contains
    push false
    assert_eq
    
    # Clean up state
    drop 0

    # 5. Test that customer in ordered accepts (event_coffee, event_latte)
    jump init_customer
    push event_want_coffee
    jump customer_process
    push (event_order, event_latte)
    jump customer_process # now in customer_state_ordered
    
    push (event_coffee, event_latte)
    pick 1
    jump customer_accept
    drop 1
    set_contains
    assert

    # 6. Test that customer in ordered rejects (event_coffee, event_espresso)
    push (event_coffee, event_espresso)
    pick 1
    jump customer_accept
    drop 1
    set_contains
    push false
    assert_eq

    # Clean up state
    drop 0
}

# Test the rejection of invalid events for Barista
test verify_barista_rejection {
    # 1. Initialize state -> [barista_state_idle]
    jump init_barista
    
    # 2. Trigger invalid coffee event on idle -> [barista_state_idle]
    push event_coffee
    pick 1
    jump barista_accept
    drop 1
    set_contains
    
    # Assert that the return value is false
    push false
    assert_eq
    
    # Clean up state from the stack
    drop 0

    # 3. Test that barista in idle accepts (event_order, event_latte)
    jump init_barista
    push (event_order, event_latte)
    pick 1
    jump barista_accept
    drop 1
    set_contains
    assert
    drop 0
    
    # 4. Test that barista in idle accepts (event_order, event_espresso)
    jump init_barista
    push (event_order, event_espresso)
    pick 1
    jump barista_accept
    drop 1
    set_contains
    assert
    drop 0
    
    # 5. Test that barista in idle does NOT accept event_order (as a raw symbol)
    jump init_barista
    push event_order
    pick 1
    jump barista_accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0

    # 6. Test that barista in brewing (latte) accepts (event_coffee, event_latte)
    jump init_barista
    push (event_order, event_latte)
    jump barista_process # now in barista_state_brewing state: (barista_state_brewing, event_latte)
    
    push (event_coffee, event_latte)
    pick 1
    jump barista_accept
    drop 1
    set_contains
    assert
    drop 0

    # 7. Test that barista in brewing (latte) rejects (event_coffee, event_espresso)
    jump init_barista
    push (event_order, event_latte)
    jump barista_process # now in barista_state_brewing state: (barista_state_brewing, event_latte)
    
    push (event_coffee, event_espresso)
    pick 1
    jump barista_accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0

    # 8. Test that barista in brewing (espresso) accepts (event_coffee, event_espresso)
    jump init_barista
    push (event_order, event_espresso)
    jump barista_process # now in barista_state_brewing state: (barista_state_brewing, event_espresso)
    
    push (event_coffee, event_espresso)
    pick 1
    jump barista_accept
    drop 1
    set_contains
    assert
    drop 0

    # 9. Test that barista in brewing (latte) does NOT accept event_coffee (as a raw symbol)
    jump init_barista
    push (event_order, event_latte)
    jump barista_process # now in barista_state_brewing state: (barista_state_brewing, event_latte)
    
    push event_coffee
    pick 1
    jump barista_accept
    drop 1
    set_contains
    push false
    assert_eq
    drop 0
}
