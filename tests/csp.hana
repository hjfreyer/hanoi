# Customer-Queue-Barista Coffee Shop CSP System

mod customer_id {
    symbol c1 "Customer 1 ID"
    symbol c2 "Customer 2 ID"
}

mod event {
    symbol want_coffee  "Customer wants coffee"
    symbol coffee       "Barista serves coffee"
    symbol enjoy        "Customer enjoys coffee"
    symbol latte        "Latte coffee type"
    symbol espresso     "Espresso coffee type"
}

mod customer_impl {
    mod state {
        symbol idle       "Customer is idle"
        symbol thirsty    "Customer is thirsty"
        symbol ordered    "Customer has ordered"
        symbol has_coffee "Customer has coffee"
    }

    # Initializes customer state: (id, preferred_drink, internal_state)
    sentence init {
    }

    # accept takes state: (id, preferred_drink, internal_state) and returns ValueSet of accepted events.
    sentence accept {
        untuple 3 # Stack: [id, preferred_drink, internal_state]
        pick 0
        push state::idle
        equal
        branch {
            drop 0 # drop internal_state
            drop 0 # drop preferred_drink
            push super::event::want_coffee
            tuple 2
            set_singleton
        } {
            pick 0
            push state::ordered
            equal
            branch {
                drop 0 # drop internal_state
                push super::event::coffee
                tuple 3
                set_singleton
            } {
                pick 0
                push state::has_coffee
                equal
                branch {
                    drop 0 # drop internal_state
                    drop 0 # drop preferred_drink
                    push super::event::enjoy
                    tuple 2
                    set_singleton
                } {
                    pick 0
                    push state::thirsty
                    equal
                    branch {
                        drop 0
                        drop 0
                        drop 0
                        push empty_set
                    } {
                        panic
                    }
                }
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit takes state: (id, preferred_drink, internal_state) and returns ValueSet of emitted events.
    sentence emit {
        untuple 3 # Stack: [id, preferred_drink, internal_state]
        pick 0
        push state::thirsty
        equal
        branch {
            # Customer emits order request to queue (push_back event)
            drop 0 # drop internal_state. Stack: [id, preferred_drink]
            tuple 2 # (id, preferred_drink)
            push super::super::queue::push_back
            tuple 2
            push true
            tuple 2
        } {
            pick 0
            push state::idle
            equal
            branch {
                drop 0
                drop 0
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    tuple 0
                    push false
                    tuple 2
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        drop 0
                        drop 0
                        drop 0
                        tuple 0
                        push false
                        tuple 2
                    } {
                        panic
                    }
                }
            }
        }
    }

    # process takes [state, event] and returns next_state.
    sentence process {
        # Stack: [(id, preferred_drink, internal_state), event]
        roll 1 # Stack: [event, (id, preferred_drink, internal_state)]
        untuple 3 # Stack: [event, id, preferred_drink, internal_state]
        
        # Check internal_state
        pick 0
        push state::idle
        equal
        branch {
            push state::idle
            assert_eq
            roll 2
            untuple 2
            push super::event::want_coffee
            assert_eq
            drop 0
            push state::thirsty
            tuple 3
        } {
            pick 0
            push state::thirsty
            equal
            branch {
                push state::thirsty
                assert_eq
                roll 2
                untuple 2
                push super::super::queue::push_back
                assert_eq
                drop 0
                push state::ordered
                tuple 3
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    push state::ordered
                    assert_eq
                    roll 2
                    untuple 3
                    push super::event::coffee
                    assert_eq
                    drop 0
                    drop 0
                    push state::has_coffee
                    tuple 3
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        push state::has_coffee
                        assert_eq
                        roll 2
                        untuple 2
                        push super::event::enjoy
                        assert_eq
                        drop 0
                        push state::idle
                        tuple 3
                    } {
                        panic
                    }
                }
            }
        }
    }

    sentence is_done {
        drop 0
        push false
    }

    sentence is_ready_to_finish {
        untuple 3
        pick 0
        push state::idle
        equal
        roll 3
        drop 0
        roll 2
        drop 0
        roll 1
        drop 0
    }
}

test sentence verify_customer_logic {
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    # Idle state accepts want_coffee
    pick 0
    jump customer_impl::accept
    push (customer_id::c1, event::want_coffee)
    roll 1
    set_contains
    assert
    
    # Process want_coffee -> thirsty
    push (customer_id::c1, event::want_coffee)
    jump customer_impl::process
    
    # Thirsty state emits push_back
    pick 0
    jump customer_impl::emit
    untuple 2
    assert
    push ((customer_id::c1, event::latte), super::queue::push_back)
    assert_eq
    
    # Process push_back -> ordered
    push ((customer_id::c1, event::latte), super::queue::push_back)
    jump customer_impl::process
    
    # Ordered state accepts coffee
    pick 0
    jump customer_impl::accept
    push (customer_id::c1, event::latte, event::coffee)
    roll 1
    set_contains
    assert
    
    # Process coffee -> has_coffee
    push (customer_id::c1, event::latte, event::coffee)
    jump customer_impl::process
    
    # Has coffee accepts enjoy
    pick 0
    jump customer_impl::accept
    push (customer_id::c1, event::enjoy)
    roll 1
    set_contains
    assert
    
    # Process enjoy -> idle
    push (customer_id::c1, event::enjoy)
    jump customer_impl::process
    
    drop 0
}

mod customer1 compose_static_closure(customer_impl, (super::customer_id::c1, super::event::latte, super::customer_impl::state::idle));
mod customer2 compose_static_closure(customer_impl, (super::customer_id::c2, super::event::espresso, super::customer_impl::state::idle));

mod barista {
    mod state {
        symbol idle             "Barista is idle"
        symbol awaiting_order   "Barista is awaiting order from queue"
        symbol brewing          "Barista is brewing coffee"
    }

    # Initializes barista state
    sentence init {
        push state::idle
    }

    # accept takes [state] and returns ValueSet.
    sentence accept {
        pick 0
        push state::idle
        equal
        branch {
            drop 0
            push empty_set
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0
                # Construct set of await_front.resp response (some.val)
                push universal_set
                push ()
                set_singleton
                set_tuple 2 # {(val, ())}
                
                push super::super::prelude::some
                set_singleton
                set_tuple 2 # {((val, ()), some)}
                
                push super::super::prelude::resp
                set_singleton
                set_tuple 2 # {(((val, ()), some), resp)}
                
                push super::super::queue::await_front
                set_singleton
                set_tuple 2 # {((((val, ()), some), resp), await_front)}
            } {
                drop 0
                push empty_set
            }
        }
    }

    sentence tau_reduce {
        push false
        tuple 2
    }

    # emit takes [state] and returns ValueSet.
    sentence emit {
        # Stack: [state]
        pick 0
        push state::idle
        equal
        branch {
            drop 0
            tuple 0
            push super::super::prelude::req
            tuple 2 # ((), req)
            push super::super::queue::await_front
            tuple 2 # (((), req), await_front)
            push true
            tuple 2
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                # Must be brewing
                untuple 2 # Stack: [(id, drink), state_status]
                push state::brewing
                equal
                branch {
                    # Stack: [(id, drink)]
                    untuple 2 # Stack: [id, drink]
                    push super::event::coffee # Stack: [id, drink, coffee]
                    tuple 3 # Stack: [(id, drink, coffee)]
                    push true
                    tuple 2
                } {
                    panic
                }
            }
        }
    }

    # process takes [state, event] and returns next_state.
    sentence process {
        # Inputs: [state, event]
        pick 1 # state
        push state::idle
        equal
        branch {
            # Transition from idle to awaiting_order
            tuple 0
            push super::super::prelude::req
            tuple 2
            push super::super::queue::await_front
            tuple 2
            assert_eq
            push state::idle
            assert_eq
            push state::awaiting_order
        } {
            pick 1 # state
            push state::awaiting_order
            equal
            branch {
                # Transition from awaiting_order to brewing.
                roll 1 # Stack: [event, state]
                push state::awaiting_order
                assert_eq
                
                # Destructure event: ((((val, ()), some), resp), await_front)
                untuple 2
                push super::super::queue::await_front
                assert_eq
                
                untuple 2
                push super::super::prelude::resp
                assert_eq
                
                untuple 2
                push super::super::prelude::some
                assert_eq
                
                untuple 2
                push ()
                assert_eq
                
                push state::brewing
                tuple 2 # (val, state::brewing)
            } {
                # Must be brewing. Transition to idle.
                roll 1 # Stack: [event, state]
                untuple 2 # Stack: [event, state_status]
                push state::brewing
                assert_eq
                drop 0
                untuple 3 # Stack: [id, drink, coffee]
                push super::event::coffee
                assert_eq
                drop 0
                drop 0
                push state::idle
            }
        }
    }

    sentence is_done {
        drop 0
        push false
    }

    sentence is_ready_to_finish {
        push state::idle
        equal
    }
}

sentence customers_sync {
    push empty_set
}

mod customers compose_concurrent(customer1, customer2, customers_sync);

sentence customers_queue_sync {
    push set_tuple(universal_set, singleton(super::queue::push_back))
}

mod customers_and_queue compose_concurrent(customers, super::queue::queue, customers_queue_sync);

sentence joint_sync {
    # Sync barista and queue on await_front
    push set_tuple(universal_set, singleton(super::queue::await_front))
    
    # Sync customers and barista on coffee
    push set_tuple(universal_set, universal_set, singleton(event::coffee))
    set_union
}

mod concurrent compose_concurrent(customers_and_queue, barista, joint_sync);

sentence hidden_events {
    push set_tuple(universal_set, singleton(super::queue::push_back))
    
    push set_tuple(universal_set, universal_set, singleton(event::coffee))
    set_union
    
    push set_tuple(universal_set, singleton(super::queue::await_front))
    set_union
}

mod hidden compose_hidden(concurrent, hidden_events);

# Helpers to drive tau transitions in tests
sentence drive_tau {
    # Stack: [state]
    pick 0
    jump hidden::tau_reduce
    untuple 2
    branch {
        drop 1 # drop old state
        jump drive_tau
    } {
        drop 0
    }
}

sentence drive_concurrent_tau {
    pick 0
    jump concurrent::tau_reduce
    untuple 2
    branch {
        drop 1
        jump drive_concurrent_tau
    } {
        drop 0
    }
}

test sentence verify_hidden_system {
    # 1. Initialize joint state
    jump hidden::init
    
    # 2. Trigger want_coffee for c1. Let's verify it is accepted.
    pick 0
    jump hidden::accept
    push (customer_id::c1, event::want_coffee)
    roll 1
    set_contains
    assert
    
    # 2. Trigger event::want_coffee for c1
    push (customer_id::c1, event::want_coffee)
    jump hidden::process
    
    # 3. Drive tau -> Barista serves Customer 1
    jump drive_tau
    
    # Verify state: Customer 1 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 # customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint state
    equal
    assert
    
    # customer 2 wants coffee. Let's verify it is accepted.
    pick 0
    jump hidden::accept
    push (customer_id::c2, event::want_coffee)
    roll 1
    set_contains
    assert
    
    # 4. Trigger event::want_coffee for c2
    push (customer_id::c2, event::want_coffee)
    jump hidden::process
    
    # 5. Drive tau -> Barista serves Customer 2
    jump drive_tau
    
    # Verify state: Customer 1 and Customer 2 both have coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 # customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint state
    equal
    assert
    
    # customer 1 enjoys coffee. Let's verify it is accepted.
    pick 0
    jump hidden::accept
    push (customer_id::c1, event::enjoy)
    roll 1
    set_contains
    assert
    
    # 6. Trigger enjoy for c1
    push (customer_id::c1, event::enjoy)
    jump hidden::process
    
    # Verify state: Customer 1 is idle, Customer 2 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 # customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint
    equal
    assert
    
    # customer 2 enjoys coffee. Let's verify it is accepted.
    pick 0
    jump hidden::accept
    push (customer_id::c2, event::enjoy)
    roll 1
    set_contains
    assert
    
    # 7. Trigger enjoy for c2
    push (customer_id::c2, event::enjoy)
    jump hidden::process
    
    # Verify state: both idle
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 # customers
    
    push ()
    push ()
    push ()
    push super::queue::awaiting_push
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::awaiting_order # barista
    
    tuple 2 # joint
    equal
    assert
    
    drop 0 # clean up state
}

# Test the concurrent joint Customer-Queue-Barista system
test sentence verify_concurrent_system {
    # 1. Initialize joint state
    jump concurrent::init
    
    # 2. Barista requests await_front
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    jump concurrent::process
    
    # 3. Customer 1 wants coffee (accepted from environment)
    pick 0
    jump concurrent::accept
    push (customer_id::c1, event::want_coffee)
    roll 1
    set_contains
    assert
    
    push (customer_id::c1, event::want_coffee)
    jump concurrent::process
    
    # 4. Customer 2 wants coffee (accepted from environment)
    pick 0
    jump concurrent::accept
    push (customer_id::c2, event::want_coffee)
    roll 1
    set_contains
    assert
    
    push (customer_id::c2, event::want_coffee)
    jump concurrent::process
    
    # 5. Customer 1 orders coffee (emitted request from customer)
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (customer_id::c1, event::latte)
    push super::queue::push_back
    tuple 2
    assert_eq
    
    push (customer_id::c1, event::latte)
    push super::queue::push_back
    tuple 2
    jump concurrent::process
    jump drive_concurrent_tau
    
    # 6. Queue responds to await_front request with the popped customer 1 value
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    push (customer_id::c1, event::latte)
    push ()
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    push (customer_id::c1, event::latte)
    push ()
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    jump concurrent::process
    
    # 7. Customer 2 orders coffee (emitted request from customer)
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (customer_id::c2, event::espresso)
    push super::queue::push_back
    tuple 2
    assert_eq
    
    push (customer_id::c2, event::espresso)
    push super::queue::push_back
    tuple 2
    jump concurrent::process
    jump drive_concurrent_tau
    
    # 8. Barista finishes brewing for Customer 1
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (customer_id::c1, event::latte, event::coffee)
    assert_eq
    
    push (customer_id::c1, event::latte, event::coffee)
    jump concurrent::process
    
    # 9. Customer 1 enjoys coffee
    pick 0
    jump concurrent::accept
    push (customer_id::c1, event::enjoy)
    roll 1
    set_contains
    assert
    
    push (customer_id::c1, event::enjoy)
    jump concurrent::process
    
    # 10. Barista requests await_front
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    jump concurrent::process
    
    # 11. Queue immediately responds to await_front request with the popped customer 2 value
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    
    push (customer_id::c2, event::espresso)
    push ()
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    push (customer_id::c2, event::espresso)
    push ()
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    jump concurrent::process
    
    # 12. Barista finishes brewing for Customer 2
    pick 0
    jump concurrent::emit
    untuple 2
    assert
    push (customer_id::c2, event::espresso, event::coffee)
    assert_eq
    
    push (customer_id::c2, event::espresso, event::coffee)
    jump concurrent::process
    
    # 13. Customer 2 enjoys coffee
    pick 0
    jump concurrent::accept
    push (customer_id::c2, event::enjoy)
    roll 1
    set_contains
    assert
    
    push (customer_id::c2, event::enjoy)
    jump concurrent::process
    
    # Verify final states
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 # customers
    
    push ()
    push ()
    push ()
    push super::queue::idle
    tuple 4 # queue
    
    tuple 2 # customers and queue
    
    push barista::state::idle # barista
    
    tuple 2 # joint
    equal
    assert
    
    drop 0 # clean up state
}

# Test the rejection of invalid events for Barista
test sentence verify_barista_rejection {
    # 1. Trigger invalid coffee event on idle (coffee is emit, not accept)
    jump barista::init
    
    jump barista::accept
    push (customer_id::c1, event::latte, event::coffee)
    roll 1
    set_contains
    push false
    assert_eq

    # 2. Test that barista in idle does NOT accept order directly (since orders are queued)
    jump barista::init
    jump barista::accept
    push ((customer_id::c1, event::latte), super::queue::push_back)
    roll 1
    set_contains
    push false
    assert_eq
    
    # 3. Test that barista in idle emits await_front.req
    jump barista::init
    jump barista::emit
    untuple 2
    assert
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    assert_eq
    
    # 4. Test that barista in awaiting_order accepts await_front.resp.some.val
    jump barista::init
    
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    jump barista::process # Transition to awaiting_order
    
    jump barista::accept
    push (customer_id::c1, event::latte)
    push ()
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    push super::queue::await_front
    tuple 2
    roll 1
    set_contains
    assert
    
    # 5. Test that barista in awaiting_order does NOT emit coffee
    jump barista::init
    tuple 0
    push super::prelude::req
    tuple 2
    push super::queue::await_front
    tuple 2
    jump barista::process # Transition to awaiting_order
    
    jump barista::emit
    untuple 2
    not
    assert
    drop 0
}
