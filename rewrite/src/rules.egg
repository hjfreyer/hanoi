;; The prover's engine, whole: the program model as an egglog datatype, the
;; facts saturation reads, and every law it applies.
;;
;; This file *is* the e-graph. Nothing here is generated — the datatype below
;; is the term model of `rewrite/src/term.rs` written out node for node, and
;; the arities, codomains and opcodes of the instruction leaves are the
;; instruction set written out entry for entry. `lang.rs` holds the tests that
;; hold this file to both.
;;
;; What `lang.rs` *does* provide is the vocabulary a rule cannot state for
;; itself, registered before this file is read:
;;
;; | name                              | what it answers |
;; |---|---|
;; | `Lits`                            | the sort of a run of interned values, `(Vec i64)` |
;; | `(value-is-bool i)`               | matches when the interned value is a `Bool` |
;; | `(value-truthy i)` / `-falsy`     | matches on the branch the value takes |
;; | `(call-inputs c)` / `-outputs`    | the arity of the sentence a `Call` names |
;; | `(vm-eval vs op width k)`         | a literal window run on the real machine |
;;
;; A `Push` and a `Call` carry an `i64` rather than the value or the sentence
;; itself: neither is something an e-node can hold, so `lang.rs` interns them
;; and the node carries the index. The two constants a rule conjures out of
;; nothing are interned first, at the indices named at the bottom of the
;; declarations.
;;
;; # Spellings
;;
;; egglog reads `;` as a comment and already owns `*`, so compose and par are
;; `Seq` and `Par` rather than the `;` and `*` the algebra and the residual
;; printer use. Every other node is its instruction's mnemonic in CamelCase.
;; A width rides *inside* its node — `(Id 3)` — which is what lets the laws
;; the algebra indexes by width be written down at all: a width is an ordinary
;; pattern variable here.

;; ============================================================================
;; The model
;; ============================================================================

(datatype Hana
  (Seq Hana Hana)
  (Par Hana Hana)
  (Branch Hana Hana)
  (Id i64)
  (Drop i64)
  (Copy i64)
  (Push i64)
  (Call i64)
  (Swap)
  (Equal)
  (Greater)
  (Less)
  (Add)
  (Subtract)
  (Multiply)
  (Divide)
  (Modulo)
  (Not)
  (Negate)
  (And)
  (Or)
  (Tuple i64)
  (Untuple i64)
  (ConstStringLen)
  (ConstStringCharAt)
  (IsInt)
  (IsBool)
  (IsConstString)
  (IsSymbol)
  (IsTuple)
  (TupleLength)
  (AsBool)
  (AsInt)
  (AsTuple i64)
)

;; A `Push` and a `Call` carry an index rather than the value or the sentence
;; itself. These two are the values a rule conjures out of nothing, so their
;; indices have to be known here: `lang.rs` interns them before reading this
;; file, and `the_constants_are_interned_first` is the test that says so.
(let $unit-value 0)
(let $true-value 1)

;; ============================================================================
;; The facts
;; ============================================================================
;;
;; What each one means, and why it is here:
;;
;; - `arity-in` / `arity-out` are the invariant. Every rule instance over this
;;   model is arity-preserving — padding made that so — so arity is constant
;;   across a class, and `:no-merge` is what enforces it: uniting two classes
;;   with different stack effects is an illegal merge and the engine refuses
;;   it. That is the net under every law in this file.
;; - `yields-bool` says whatever this computes leaves a `Bool` on top. The
;;   `Instruction::yields_bool` list, lifted through composition. It is
;;   measured by `vm`, so a wrong entry below is a soundness bug rather than
;;   an inaccurate comment.
;; - `literal` says the class behaves as `id(inputs) * (push v1 ; … ; push
;;   vk)` — it pushes exactly those values over an untouched stack. What the
;;   folding rules read.
;; - `opcode` / `opwidth` name the instruction a leaf stands for, for the two
;;   rules that run the machine. `Push` deliberately has neither: a literal is
;;   not an operation to fold.
;; - `commutative` is `Instruction::commutative`, for the one rule that spends
;;   it.
;;
;; There is deliberately no `is-id` / `is-drop` / `is-copy`. A class is an
;; identity exactly when it holds an `(Id n)` node — every law that concludes
;; identity-ness emits one, and the unit and fusing rules put one in the class
;; of any composite that is one — so `(Id ?n)` in a pattern says it, and says
;; the width at the same time, where a fact would need a second join against
;; `arity-in` to get it. The same goes for `(Drop n)` and `(Copy n)`.
;;
;; All of them but the arities are one-way: absent means "not known to hold",
;; never "known not to". egglog has no negation, so no rule may ask whether a
;; fact is *missing*, and none below needs to.

(function arity-in  (Hana) i64 :no-merge)
(function arity-out (Hana) i64 :no-merge)
(relation yields-bool (Hana))
(function literal (Hana) Lits :merge old)
(function opcode  (Hana) String :no-merge)
(function opwidth (Hana) i64 :no-merge)
(relation commutative (Hana))

;; The canonical spelling of "push these values over `n` untouched ones" — the
;; shape `lower` gives a run of pushes, and the shape whose class the literal
;; fact recognizes. A rule builds one by naming the run; these unfold it. The
;; helpers are unextractable so a residual is printed in the term language and
;; never in the scaffolding that built it.
(constructor lit-chain (i64 Lits) Hana :unextractable)
(constructor lit-step  (i64 i64)  Hana :unextractable)
(constructor top-drop  (i64)      Hana :unextractable)

;; ============================================================================
;; The facts, computed
;; ============================================================================

;; lit-chain-empty
(rule ((= c (lit-chain ?n ?vs)) (= 0 (vec-length ?vs)))
      ((union c (Id ?n))))
;; lit-chain-step
(rule ((= c (lit-chain ?n ?vs))
       (= ?k (- (vec-length ?vs) 1))
       (>= ?k 0)
       (= ?v (vec-get ?vs ?k)))
      ((union c (Seq (lit-chain ?n (vec-remove ?vs ?k)) (lit-step (+ ?n ?k) ?v)))))
;; lit-step-bare
(rule ((= s (lit-step 0 ?v)))            ((union s (Push ?v))))
;; lit-step-framed
(rule ((= s (lit-step ?d ?v)) (> ?d 0))  ((union s (Par (Id ?d) (Push ?v)))))

;; `drop(1)` at the top of `n + 1` values: the deep `n` pass through.
;; top-drop-bare
(rule ((= d (top-drop 0)))            ((union d (Drop 1))))
;; top-drop-framed
(rule ((= d (top-drop ?n)) (> ?n 0))  ((union d (Par (Id ?n) (Drop 1)))))

;; ---- the structural leaves --------------------------------------------------
;; leaf-id
(rule ((= t (Id ?n)))
      ;; `id(0)` pushes nothing over an untouched stack, which is what lets a
      ;; literal prefix compose past it — hence the empty run.
      ((set (arity-in t) ?n) (set (arity-out t) ?n)
       (set (literal t) (vec-of))))
;; leaf-drop
(rule ((= t (Drop ?n)))
      ((set (arity-in t) ?n) (set (arity-out t) 0)))
;; leaf-copy
(rule ((= t (Copy ?n)))
      ((set (arity-in t) ?n) (set (arity-out t) (+ ?n ?n))))
;; leaf-push
(rule ((= t (Push ?v)))
      ((set (arity-in t) 0) (set (arity-out t) 1) (set (literal t) (vec-of ?v))))
;; leaf-push-bool
(rule ((= t (Push ?v)) (value-is-bool ?v))
      ((yields-bool t)))
;; leaf-call
(rule ((= t (Call ?c)))
      ((set (arity-in t) (call-inputs ?c)) (set (arity-out t) (call-outputs ?c))))

;; ---- compose ----------------------------------------------------------------
;; compose-arity
(rule ((= t (Seq ?a ?b)) (= ?i (arity-in ?a)) (= ?o (arity-out ?b)))
      ((set (arity-in t) ?i) (set (arity-out t) ?o)))
;; compose-meets
(rule ((= t (Seq ?a ?b)) (= ?o (arity-out ?a)) (= ?i (arity-in ?b)) (!= ?o ?i))
      ((panic "a compose node whose halves do not meet")))
;; The suffix answers for the top of the stack; an identity suffix leaves the
;; prefix's answer standing. The second rule is the other side of that `if`:
;; egglog cannot ask whether the suffix is *not* an identity, and it need not —
;; an identity class that also yielded a bool would be claiming its own input is
;; always a `Bool`, which no sound union can put there.
;; compose-bool-through-id
(rule ((= t (Seq ?a (Id ?n))) (> ?n 0) (yields-bool ?a))
      ((yields-bool t)))
;; compose-bool
(rule ((= t (Seq ?a ?b)) (yields-bool ?b))
      ((yields-bool t)))
;; Both halves push over an untouched stack, so the pushes concatenate: the
;; suffix's land on top.
;; compose-literal
(rule ((= t (Seq ?a ?b)) (= ?xs (literal ?a)) (= ?ys (literal ?b)))
      ((set (literal t) (vec-append ?xs ?ys))))

;; ---- par --------------------------------------------------------------------
;; par-arity
(rule ((= t (Par ?a ?b))
       (= ?ai (arity-in ?a)) (= ?bi (arity-in ?b))
       (= ?ao (arity-out ?a)) (= ?bo (arity-out ?b)))
      ((set (arity-in t) (+ ?ai ?bi)) (set (arity-out t) (+ ?ao ?bo))))
;; par-bool-top
(rule ((= t (Par ?a ?b)) (> (arity-out ?b) 0) (yields-bool ?b)) ((yields-bool t)))
;; par-bool-deep
(rule ((= t (Par ?a ?b)) (= 0 (arity-out ?b)) (yields-bool ?a)) ((yields-bool t)))
;; The deep side's pushes land under the shallow side's inputs, so this is a
;; literal only when the shallow side reads nothing (its pushes then sit
;; directly on the deep side's) or the deep side pushes nothing at all.
;; par-literal
(rule ((= t (Par ?a ?b)) (= ?xs (literal ?a)) (= ?ys (literal ?b)) (= 0 (arity-in ?b)))
      ((set (literal t) (vec-append ?xs ?ys))))
;; par-literal-over-id
(rule ((= t (Par (Id ?n) ?b)) (= ?ys (literal ?b)))
      ((set (literal t) ?ys)))

;; ---- branch -----------------------------------------------------------------
;; branch-arity
(rule ((= t (Branch ?x ?y)) (= ?i (arity-in ?x)) (= ?o (arity-out ?x)))
      ((set (arity-in t) (+ ?i 1)) (set (arity-out t) ?o)))
;; branch-arms-agree-in
(rule ((= t (Branch ?x ?y)) (= ?p (arity-in ?x)) (= ?q (arity-in ?y)) (!= ?p ?q))
      ((panic "a branch node whose arms differ")))
;; branch-arms-agree-out
(rule ((= t (Branch ?x ?y)) (= ?p (arity-out ?x)) (= ?q (arity-out ?y)) (!= ?p ?q))
      ((panic "a branch node whose arms differ")))
;; branch-bool
(rule ((= t (Branch ?x ?y)) (> (arity-out ?x) 0) (yields-bool ?x) (yields-bool ?y))
      ((yields-bool t)))

;; ---- the instruction leaves -------------------------------------------------
;; One rule per instruction, holding its arity, its codomain, whether it
;; commutes, and the name `vm-eval` folds it under. This is
;; `Prim::arity`, `Instruction::yields_bool` and `Instruction::commutative`
;; written out; `lang.rs` has the test that says so.

;; leaf-swap
(rule ((= t (Swap)))
      ((set (arity-in t) 2) (set (arity-out t) 2)
       (set (opcode t) "Swap") (set (opwidth t) 0)))
;; leaf-equal
(rule ((= t (Equal)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Equal") (set (opwidth t) 0) (yields-bool t) (commutative t)))
;; leaf-greater
(rule ((= t (Greater)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Greater") (set (opwidth t) 0) (yields-bool t)))
;; leaf-less
(rule ((= t (Less)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Less") (set (opwidth t) 0) (yields-bool t)))
;; leaf-add
(rule ((= t (Add)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Add") (set (opwidth t) 0) (commutative t)))
;; leaf-subtract
(rule ((= t (Subtract)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Subtract") (set (opwidth t) 0)))
;; leaf-multiply
(rule ((= t (Multiply)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Multiply") (set (opwidth t) 0) (commutative t)))
;; leaf-divide
(rule ((= t (Divide)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Divide") (set (opwidth t) 0)))
;; leaf-modulo
(rule ((= t (Modulo)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Modulo") (set (opwidth t) 0)))
;; leaf-not
(rule ((= t (Not)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "Not") (set (opwidth t) 0) (yields-bool t)))
;; leaf-negate
(rule ((= t (Negate)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "Negate") (set (opwidth t) 0)))
;; leaf-and
(rule ((= t (And)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "And") (set (opwidth t) 0) (yields-bool t) (commutative t)))
;; leaf-or
(rule ((= t (Or)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "Or") (set (opwidth t) 0) (yields-bool t) (commutative t)))
;; leaf-tuple
(rule ((= t (Tuple ?n)))
      ((set (arity-in t) ?n) (set (arity-out t) 1)
       (set (opcode t) "Tuple") (set (opwidth t) ?n)))
;; leaf-untuple
(rule ((= t (Untuple ?n)))
      ((set (arity-in t) 1) (set (arity-out t) ?n)
       (set (opcode t) "Untuple") (set (opwidth t) ?n)))
;; leaf-conststringlen
(rule ((= t (ConstStringLen)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "ConstStringLen") (set (opwidth t) 0)))
;; leaf-conststringcharat
(rule ((= t (ConstStringCharAt)))
      ((set (arity-in t) 2) (set (arity-out t) 1)
       (set (opcode t) "ConstStringCharAt") (set (opwidth t) 0)))
;; leaf-isint
(rule ((= t (IsInt)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "IsInt") (set (opwidth t) 0) (yields-bool t)))
;; leaf-isbool
(rule ((= t (IsBool)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "IsBool") (set (opwidth t) 0) (yields-bool t)))
;; leaf-isconststring
(rule ((= t (IsConstString)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "IsConstString") (set (opwidth t) 0) (yields-bool t)))
;; leaf-issymbol
(rule ((= t (IsSymbol)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "IsSymbol") (set (opwidth t) 0) (yields-bool t)))
;; leaf-istuple
(rule ((= t (IsTuple)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "IsTuple") (set (opwidth t) 0) (yields-bool t)))
;; leaf-tuplelength
(rule ((= t (TupleLength)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "TupleLength") (set (opwidth t) 0)))
;; leaf-asbool
(rule ((= t (AsBool)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "AsBool") (set (opwidth t) 0) (yields-bool t)))
;; leaf-asint
(rule ((= t (AsInt)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "AsInt") (set (opwidth t) 0)))
;; leaf-astuple
(rule ((= t (AsTuple ?n)))
      ((set (arity-in t) 1) (set (arity-out t) 1)
       (set (opcode t) "AsTuple") (set (opwidth t) ?n)))


;; ============================================================================
;; The laws
;; ============================================================================
;;
;; Every rule below is an equation between programs; saturation applies them
;; all, in both directions where both are bounded, and equality is discovered
;; rather than steered. Three kinds appear, in increasing order of machinery:
;;
;; - **Pattern rules** say both sides syntactically, and are used wherever a
;;   law needs no fact — associativity, the branch laws, the tuple
;;   cancellations.
;; - **Fact rules** add a `:when` reading the tables above.
;; - **The evaluation rules** consult the interpreter itself, through
;;   `vm-eval`: a literal window is run on a scratch `vm::VM`, so folding
;;   cannot disagree with the machine. What `eval` owes is an obligation, not
;;   a licence.
;;
;; Deliberately absent: unfolding a call — that is a goal-level decision, see
;; `rewrite/src/strategy.rs` — and any rule that conjures code from nothing
;; (`drop(n) = X ; drop(m)` backwards); a stepping stone written as a `via`
;; waypoint is how that direction is reached.
;;
;; The comment above each rule is its name: what the firings report prints and
;; what `docs/algebra.md` cites.

;; The rules that grow the graph on shape alone, banned by match count when
;; they run away — see `Backoff` in `rewrite/src/strategy.rs`. A fact rule must
;; never go in here: its pattern is small, so it matches everywhere and
;; *declines* nearly everywhere, and banning it on its match count would
;; silence exactly the rare application it exists for.
(ruleset growth)

;; ---- associativity: both operators, both ways -------------------------------
;; assoc-compose
(birewrite (Seq (Seq ?a ?b) ?c) (Seq ?a (Seq ?b ?c)) :ruleset growth)
;; assoc-par
(birewrite (Par (Par ?a ?b) ?c) (Par ?a (Par ?b ?c)) :ruleset growth)

;; ---- units ------------------------------------------------------------------
;; `id ; a` = `a` = `a ; id`, and the width-0 structural leaves are the unit of
;; `*`. Elimination only: introduction is unbounded, and the staircase rules
;; below are the bounded way shapes get re-padded.
;; unit-compose-left
(rewrite (Seq (Id ?n) ?b) ?b)
;; unit-compose-right
(rewrite (Seq ?a (Id ?n)) ?a)
;; par-unit-deep
(rewrite (Par (Id 0) ?b) ?b)
;; par-unit-top
(rewrite (Par ?a (Id 0)) ?a)
;; par-id-fuse
(rewrite (Par (Id ?n) (Id ?m)) (Id (+ ?n ?m)))
;; copy-nothing
(rewrite (Copy 0) (Id 0))
;; drop-nothing
(rewrite (Drop 0) (Id 0))

;; ---- interchange, as staircases ---------------------------------------------
;; `a * b` = `(a * id) ; (id * b)` = `(id * b) ; (a * id)`: the two sides of a
;; par happen in either order once the other side is padded out. This is the
;; middle-four interchange in the bounded shape, and the recognizers reading a
;; staircase back into a par are what let two different paddings of one program
;; meet.
;; stair-deep-first
(rewrite (Par ?a ?b) (Seq (Par ?a (Id ?bi)) (Par (Id ?ao) ?b))
  :when ((= ?bi (arity-in ?b)) (= ?ao (arity-out ?a))) :ruleset growth)
;; stair-top-first
(rewrite (Par ?a ?b) (Seq (Par (Id ?ai) ?b) (Par ?a (Id ?bo)))
  :when ((= ?ai (arity-in ?a)) (= ?bo (arity-out ?b))) :ruleset growth)
;; stair-read-deep-first
(rewrite (Seq (Par ?a (Id ?i)) (Par (Id ?j) ?b)) (Par ?a ?b)
  :when ((= ?i (arity-in ?b)) (= ?j (arity-out ?a))))
;; stair-read-top-first
(rewrite (Seq (Par (Id ?i) ?b) (Par ?a (Id ?j))) (Par ?a ?b)
  :when ((= ?i (arity-in ?a)) (= ?j (arity-out ?b))))
;; The full middle-four interchange, forward: two pars in sequence whose split
;; lines up fuse into one par of composes. The staircases above are its
;; identity cases; this is the general one, and it is what lets a computation
;; and the counit meet across a par boundary.
;; par-fuse
(rewrite (Seq (Par ?a ?b) (Par ?c ?d)) (Par (Seq ?a ?c) (Seq ?b ?d))
  :when ((= (arity-out ?a) (arity-in ?c)) (= (arity-out ?b) (arity-in ?d))))
;; A producer beside a computation: `a ; (id(a.out) * b)` is `a * b` when `b`
;; reads nothing — `b`'s pushes land on top of `a`'s untouched answer.
;; compose-to-par
(rewrite (Seq ?a (Par (Id ?i) ?b)) (Par ?a ?b)
  :when ((= ?i (arity-out ?a)) (= 0 (arity-in ?b))))

;; ---- the symmetry -----------------------------------------------------------
;; swap-cycle
(rewrite (Seq (Swap) (Swap)) (Id 2))
;; swap-nat
(birewrite (Seq (Par ?a ?b) (Swap)) (Seq (Swap) (Par ?b ?a))
  :when ((= 1 (arity-in ?a)) (= 1 (arity-out ?a))
         (= 1 (arity-in ?b)) (= 1 (arity-out ?b))))

;; ---- the comonoid -----------------------------------------------------------
;; Copy a block and discard one of the two: either one, and nothing happened.
;; The first takes the copy (on top), the second takes the original out from
;; underneath it.
;; counit-copy
(rewrite (Seq (Copy ?n) (Par (Id ?n) (Drop ?n))) (Id ?n))
;; counit-original
(rewrite (Seq (Copy ?n) (Par (Drop ?n) (Id ?n))) (Id ?n))
;; cocommutative
(rewrite (Seq (Copy 1) (Swap)) (Copy 1))
;; A block copy of two is the two `pick 1`s it lowers from. One direction only
;; — recognize the frame spelling and give its class the `(Copy 2)` leaf. That
;; is enough for both ways of meeting: two `(Copy 2)` leaves are one e-node, so
;; a block the naturality rules built and a block the compiler spelled as
;; frames land in one class without ever *expanding* a `(Copy 2)` into frames,
;; which was a growth engine.
;; copy-block-two
(rewrite (Seq (Par (Copy 1) (Id 1))
              (Seq (Par (Id 1) (Swap))
                   (Seq (Par (Id 1) (Par (Copy 1) (Id 1)))
                        (Par (Id 2) (Swap)))))
         (Copy 2))
;; coassociative
(birewrite (Seq (Copy 1) (Par (Id 1) (Copy 1)))
           (Seq (Copy 1) (Par (Copy 1) (Id 1))))

;; ---- the two naturalities ---------------------------------------------------
;; Copying is natural: run once and copy the outputs, or copy the inputs and
;; run twice. Both directions are bounded, and backwards — un-sharing a copy
;; into a second run — is the reading proofs reach for.
;;
;; The egg rule declined when `?x` was itself an identity or a copy: those
;; instances are true but useless, and it was cheaper not to build them.
;; egglog has no negation, so the guard is gone and they are built. It costs a
;; node or two per class and nothing else — the instance a copy produces is
;; `(Copy n) ; ((Copy n) * (Copy n))`, whose suffix is a `Par` and so is not
;; itself a copy, so the rule does not chase its own output. Same for the
;; identity instance, which the unit rules collapse straight back.
;; copy-nat
(rewrite (Seq ?x (Copy ?m)) (Seq (Copy ?n) (Par ?x ?x))
  :when ((= ?m (arity-out ?x)) (= ?n (arity-in ?x))))
;; copy-nat-rev
(rewrite (Seq (Copy ?n) (Par ?x ?x)) (Seq ?x (Copy ?o))
  :when ((= ?n (arity-in ?x)) (= ?o (arity-out ?x))))
;; Discarding is natural: a computation whose results are all dropped is the
;; dropping of its inputs. One direction — the other conjures work. Its egg
;; guard is gone for the same reason as copy naturality's, and here the
;; instances it excluded are outright already-derivable: `id(n) ; drop(n)` and
;; `drop(n) ; drop(0)` are both `drop(n)` by the unit rules.
;; drop-nat
(rewrite (Seq ?x (Drop ?m)) (Drop ?n) :when ((= ?n (arity-in ?x))))
;; drop-par-fuse
(rewrite (Par (Drop ?n) (Drop ?m)) (Drop (+ ?n ?m)))
;; drop-split-two
(birewrite (Drop 2) (Par (Drop 1) (Drop 1)) :ruleset growth)
;; The symmetry slides past a dropping leg: exchange two values and drop one,
;; or drop the other one where it stood. The naturality above wants both legs
;; `1 -> 1`, and a `drop` is the one-legged case it cannot say.
;; swap-drop-top
(birewrite (Seq (Swap) (Par (Id 1) (Drop 1))) (Par (Drop 1) (Id 1)))
;; swap-drop-deep
(birewrite (Seq (Swap) (Par (Drop 1) (Id 1))) (Par (Id 1) (Drop 1)))

;; ---- evaluation -------------------------------------------------------------
;; A literal window is run on the machine itself, so the fold and the
;; interpreter cannot disagree; see `vm-eval` in `lang.rs`.
;; eval
(rewrite (Seq ?l ?op) (lit-chain ?n ?out)
  :when ((= ?vs (literal ?l)) (= ?n (arity-in ?l))
         (= ?out (vm-eval ?vs (opcode ?op) (opwidth ?op) (arity-in ?op)))))
;; The same fold when the operation sits over a frame: the identity part passes
;; literals (or anything else) through untouched, and the operation still reads
;; the top of the pushed run.
;; eval-padded
(rewrite (Seq ?l (Par (Id ?i) ?op)) (lit-chain ?n ?out)
  :when ((= ?vs (literal ?l)) (= ?n (arity-in ?l))
         (= ?out (vm-eval ?vs (opcode ?op) (opwidth ?op) (arity-in ?op)))))
;; eval-nothing
(rewrite (Tuple 0) (Push $unit-value))
;; A branch whose condition is already a literal takes the arm the value picks,
;; and the rest of the run stands in front of it.
;; fold-branch-then
(rewrite (Seq ?l (Branch ?t ?f)) (Seq (lit-chain ?n ?rest) ?t)
  :when ((= ?vs (literal ?l)) (= ?n (arity-in ?l))
         (= ?k (- (vec-length ?vs) 1)) (>= ?k 0)
         (= ?c (vec-get ?vs ?k)) (value-truthy ?c)
         (= ?rest (vec-remove ?vs ?k))))
;; fold-branch-else
(rewrite (Seq ?l (Branch ?t ?f)) (Seq (lit-chain ?n ?rest) ?f)
  :when ((= ?vs (literal ?l)) (= ?n (arity-in ?l))
         (= ?k (- (vec-length ?vs) 1)) (>= ?k 0)
         (= ?c (vec-get ?vs ?k)) (value-falsy ?c)
         (= ?rest (vec-remove ?vs ?k))))
;; commute
(rewrite (Seq (Swap) ?op) ?op :when ((commutative ?op)))

;; ---- codomains --------------------------------------------------------------
;; The one fact no case split reaches: what an operation is *known to leave*.
;; `Instruction::yields_bool` is measured by `vm`; `lang.rs` lifts it through
;; composition, and this is the rule that spends it.
;; bool-result
(rewrite (Seq ?x (IsBool))
         (Seq ?x (Seq (top-drop (- ?o 1)) (lit-chain (- ?o 1) (vec-of $true-value))))
  :when ((yields-bool ?x) (= ?o (arity-out ?x)) (>= ?o 1)))

;; ---- branches ---------------------------------------------------------------
;; A shared suffix distributes into both arms and factors back out.
;; branch-distribute
(birewrite (Seq (Branch ?t ?f) ?k) (Branch (Seq ?t ?k) (Seq ?f ?k)))
;; A framed computation slides into both arms of the branch it precedes: the
;; frame hid exactly the condition.
;; branch-hoist
(birewrite (Seq (Par ?x (Id 1)) (Branch ?t ?f)) (Branch (Seq ?x ?t) (Seq ?x ?f)))
;; And what runs *beside* a branch runs inside whichever arm it takes: the
;; deeper region the branch never looks at does not care which one that was.
;; The conversion the rule above cannot say, and the one lowering makes
;; constantly — a branch whose arms are narrower than the stack is emitted
;; framed, and every law about branches is stated unframed.
;; branch-beside
(birewrite (Par ?x (Branch ?t ?f)) (Branch (Par ?x ?t) (Par ?x ?f)))
;; The condition was a copy, and both arms open by dropping it: nothing is left
;; of the copy at all.
;; branch-absorbs-copy
(rewrite (Seq (Copy 1) (Branch (Seq (Drop 1) ?a) (Seq (Drop 1) ?b))) (Branch ?a ?b))

;; The same value tested twice answers the same: the arm an outer branch took
;; already decides an inner branch on a copy of its condition, so the other
;; inner arm is dead. Four rules: either arm, with or without a continuation
;; after the inner branch.
;; retest-then
(rewrite (Seq (Copy 1) (Branch (Seq (Branch ?p ?q) ?r) ?e))
         (Seq (Copy 1) (Branch (Seq (Seq (top-drop ?n) ?p) ?r) ?e))
  :when ((= ?n (arity-in ?p))))
;; retest-then-bare
(rewrite (Seq (Copy 1) (Branch (Branch ?p ?q) ?e))
         (Seq (Copy 1) (Branch (Seq (top-drop ?n) ?p) ?e))
  :when ((= ?n (arity-in ?p))))
;; retest-else
(rewrite (Seq (Copy 1) (Branch ?t (Seq (Branch ?p ?q) ?r)))
         (Seq (Copy 1) (Branch ?t (Seq (Seq (top-drop ?n) ?q) ?r)))
  :when ((= ?n (arity-in ?q))))
;; retest-else-bare
(rewrite (Seq (Copy 1) (Branch ?t (Branch ?p ?q)))
         (Seq (Copy 1) (Branch ?t (Seq (top-drop ?n) ?q)))
  :when ((= ?n (arity-in ?q))))

;; A value that tested `equal` to a literal *is* that literal, inside the arm
;; that saw `true`. The copy keeps the original one deep, so the `equal`
;; reading the copy against the literal is always framed over it; the then arm
;; holds the original on top, so drop it and write the literal in its place.
;; specialize-equal
(rewrite (Seq (Copy 1) (Seq ?p (Seq (Par (Id 1) (Equal)) (Branch ?t ?f))))
         (Seq (Copy 1) (Seq ?p (Seq (Par (Id 1) (Equal))
                                    (Branch (Seq (Seq (Drop 1) (Push ?v)) ?t) ?f))))
  :when ((= ?lit (literal ?p)) (= 1 (vec-length ?lit)) (= ?v (vec-get ?lit 0))))

;; ---- coercions and tuples ---------------------------------------------------
;; as-bool-idem
(birewrite (Seq (AsBool) (AsBool)) (AsBool))
;; as-int-idem
(birewrite (Seq (AsInt) (AsInt)) (AsInt))
;; as-tuple-idem
(rewrite (Seq (AsTuple ?n) (AsTuple ?n)) (AsTuple ?n))
;; tuple-cancel
(rewrite (Seq (Tuple ?n) (Untuple ?n)) (Id ?n))
;; untuple-retuple
(rewrite (Seq (Untuple ?n) (Tuple ?n)) (AsTuple ?n))
