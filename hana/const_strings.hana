// Tests for ConstString, the value that is exactly its text.

const_string greeting "hello"
const_string same_greeting "hello"
const_string empty ""
const_string unicode "café"

test sentence a_const_string_is_its_text {
    // Two declarations reading the same are the same value — the whole
    // difference from a symbol, which is a fresh identity every time.
    push greeting
    push same_greeting
    equal
    jump crate::prelude::check_true
    ?
    drop 0

    // And a literal is that same value, with nothing to declare.
    push greeting
    push "hello"
    equal
    jump crate::prelude::check_true
    ?
    drop 0

    push greeting
    push "goodbye"
    equal
    not
    jump crate::prelude::check_true
}

test sentence const_string_len_counts_characters {
    push greeting
    const_string_len
    push 5
    jump crate::prelude::check_equals
    ?
    drop 0

    push empty
    const_string_len
    push 0
    jump crate::prelude::check_equals
    ?
    drop 0

    // Characters, not bytes: `café` is five bytes and four characters.
    push unicode
    const_string_len
    push 4
    jump crate::prelude::check_equals
}

test sentence const_string_len_answers_zero_off_the_strings {
    // A length is an `Int` whatever it was asked about, so a value with no
    // characters to count measures `0`. Nothing here says the count was
    // invented rather than read; `is_const_string` is what asks that.
    push 3
    const_string_len
    push 0
    jump crate::prelude::check_equals
}

test sentence const_string_char_at_reads_a_code_point {
    push greeting
    push 0
    const_string_char_at
    push 104 // 'h'
    jump crate::prelude::check_equals
    ?
    drop 0

    push greeting
    push 4
    const_string_char_at
    push 111 // 'o'
    jump crate::prelude::check_equals
    ?
    drop 0

    push unicode
    push 3
    const_string_char_at
    push 233 // 'é'
    jump crate::prelude::check_equals
}

test sentence const_string_char_at_answers_zero_out_of_range {
    // An index past the end reads no code point, so the answer is `0` — the
    // same `0` a string holding a NUL would have given. A caller that means to
    // tell the two apart asks `const_string_len` first.
    push greeting
    push 5
    const_string_char_at
    push 0
    jump crate::prelude::check_equals
    ?
    drop 0

    push empty
    push 0
    const_string_char_at
    push 0
    jump crate::prelude::check_equals
    ?
    drop 0

    // A wrong operand type answers the same way.
    push 7
    push 0
    const_string_char_at
    push 0
    jump crate::prelude::check_equals
}

test sentence is_const_string_answers_on_every_shape {
    push greeting
    is_const_string
    jump crate::prelude::check_true
    ?
    drop 0

    push ""
    is_const_string
    jump crate::prelude::check_true
    ?
    drop 0

    push 42
    is_const_string
    not
    jump crate::prelude::check_true
    ?
    drop 0

    push (1, greeting)
    is_const_string
    not
    jump crate::prelude::check_true
}

// A const string is a value like any other, so it works as a type spec too.
type Greeting const_string;
type Hello "hello";

test sentence const_string_type_checks {
    push greeting
    jump Greeting::check
    jump crate::prelude::check_true
    ?
    drop 0

    push 42
    jump Greeting::check
    not
    jump crate::prelude::check_true
    ?
    drop 0

    push "hello"
    jump Hello::check
    jump crate::prelude::check_true
    ?
    drop 0

    push "goodbye"
    jump Hello::check
    not
    jump crate::prelude::check_true
}
