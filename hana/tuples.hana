// Tests for tuples and nested tuples

test sentence simple_tuple {
    push 1
    push 2
    push 3
    tuple 3
    untuple 3
    push 3
    jump crate::prelude::check_equals
    ?
    drop 0
    push 2
    jump crate::prelude::check_equals
    ?
    drop 0
    push 1
    jump crate::prelude::check_equals
}

test sentence nested_tuples {
    push 10
    push (30, 20)
    tuple 2
    
    // Destructure outer tuple
    untuple 2
    
    // Destructure inner tuple
    untuple 2
    
    push 20
    jump crate::prelude::check_equals
    ?
    drop 0
    push 30
    jump crate::prelude::check_equals
    ?
    drop 0
    push 10
    jump crate::prelude::check_equals
}
