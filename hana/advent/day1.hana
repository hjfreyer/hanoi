const_string input0 "39472"

sentence sync_char_iterator_in {
    pick 0
    push crate::prelude::start
    equal
    pick 1
    push crate::prelude::pass
    equal
    or
    pick 1
    push crate::prelude::fail
    equal
    or
    branch {
        drop 0
        push false
    } {
        untuple 2
        drop 1
        push crate::string::char_iterator::in
        equal
    }
}

sentence sync_parseint_in {
    pick 0
    push crate::prelude::start
    equal
    pick 1
    push crate::prelude::pass
    equal
    or
    pick 1
    push crate::prelude::fail
    equal
    or
    branch {
        drop 0
        push false
    } {
        untuple 2
        drop 1
        push crate::string::parseint::in
        equal
    }
}

mod input0_hidden compose_hidden(
    compose_concurrent(
        compose_prefix(compose_static_closure(crate::string::string_ref, input0), crate::string::char_iterator::in),
        crate::string::char_iterator,
        sync_char_iterator_in
    ),
    sync_char_iterator_in
);

mod sut compose_hidden(
    compose_concurrent(
        crate::string::parseint,
        compose_rename_prefix(crate::string::char_iterator::out, crate::string::parseint::in, input0_hidden),
        sync_parseint_in
    ),
    sync_parseint_in
);

// Parameterized validator machine that receives SUT output event
mod harness compose_accept_static(
    crate::prelude::start,
    compose_emit_static(
        (((), crate::string::copy), crate::string::parseint::out),
        compose_accept_static(
            (((39472, crate::string::ok), crate::string::value), crate::string::parseint::out),
            compose_emit_static(
                crate::prelude::pass,
                compose_done()
            )
        )
    )
);

sentence sync_set {
    pick 0
    push crate::prelude::start
    equal
    pick 1
    push crate::prelude::pass
    equal
    or
    pick 1
    push crate::prelude::fail
    equal
    or
    branch {
        drop 0
        push false
    } {
        untuple 2
        drop 1
        push crate::string::parseint::out
        equal
    }
}

mod sut_and_harness compose_concurrent(sut, harness, sync_set);

mod test0 compose_hidden(sut_and_harness, sync_set);

// One tau reduction of the system under test together with its harness, which
// has to be there to take: the test spells out how many reductions the run
// takes, so a `tau_step` that finds nothing to reduce is a mistake in the test
// rather than a stopping condition.
sentence tau_step {
    // Stack: [state]
    jump test0::tau_reduce
    // Stack: [(next_state, did_change)]
    untuple 2
    // Stack: [next_state, did_change]
    branch {
        push crate::prelude::ok
        tuple 2
    } {
        push crate::prelude::err
        tuple 2
    }
}

test sentence verify_day1_manually {
    tuple 0
    jump test0::init
    
    // Trigger start: process start event
    push crate::prelude::start
    roll 1
    tuple 2
    jump test0::process
    
    // Run the twenty tau reductions the system takes to reach its answer
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    jump tau_step
    ?
    
    // Assert that it emitted the pass event
    pick 0
    jump test0::emit
    untuple 2
    jump crate::prelude::check_true // ... and that there is an event
    ?
    drop 0
    push crate::prelude::pass
    jump crate::prelude::check_equals
    ?
    drop 0
    
    // Process the emitted event to transition to final state
    push crate::prelude::pass
    roll 1
    tuple 2
    jump test0::process
    
    // Check is_done
    pick 0
    jump test0::is_done
    jump crate::prelude::check_true
    ?
    drop 0
    
    drop 0
    push ((), crate::prelude::ok)
}
