// Test the rejection of invalid events for Barista
test sentence verify_barista_rejection {
    // 1. Trigger invalid coffee event on idle (coffee is emit, not accept)
    tuple 0
    jump barista::init
    
    push ((customer_id::c1, event::latte), event::coffee)
    roll 1
    tuple 2
    jump barista::accept
    push false
    jump crate::prelude::check_equals
    ?
    drop 0

    // 2. Test that barista in idle does NOT accept order directly (since orders are queued)
    tuple 0
    jump barista::init
    push (((customer_id::c1, event::latte)), super::queue::Event::PushBack::tag)
    roll 1
    tuple 2
    jump barista::accept
    push false
    jump crate::prelude::check_equals
    ?
    drop 0
    
    // 3. Test that barista in idle emits await_front.req
    tuple 0
    jump barista::init
    jump barista::emit
    untuple 2
    jump crate::prelude::check_true
    ?
    drop 0
    
    tuple 0
    push super::prelude::req
    tuple 2
    tuple 1
    push super::queue::Event::AwaitFront::tag
    tuple 2
    jump crate::prelude::check_equals
    ?
    drop 0
    
    // 4. Test that barista in awaiting_order accepts await_front.resp.some.val
    tuple 0
    jump barista::init
    
    tuple 0
    push super::prelude::req
    tuple 2
    tuple 1
    push super::queue::Event::AwaitFront::tag
    tuple 2
    roll 1
    tuple 2
    jump barista::process // Transition to awaiting_order
    
    push ()
    push (customer_id::c1, event::latte)
    tuple 2
    push super::prelude::some
    tuple 2
    push super::prelude::resp
    tuple 2
    tuple 1
    push super::queue::Event::AwaitFront::tag
    tuple 2
    roll 1
    tuple 2
    jump barista::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // 5. Test that barista in awaiting_order does NOT emit coffee
    tuple 0
    jump barista::init
    push ()
    push super::prelude::req
    tuple 2
    tuple 1
    push super::queue::Event::AwaitFront::tag
    tuple 2
    roll 1
    tuple 2
    jump barista::process // Transition to awaiting_order
    
    jump barista::emit
    untuple 2
    not
    jump crate::prelude::check_true
    ?
    drop 0
    drop 0
    push ((), crate::prelude::ok)
}
