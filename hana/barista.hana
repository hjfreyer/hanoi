// Customer-Queue-Barista Coffee Shop CSP System

mod customer_id {
    symbol c1
    symbol c2
}

mod event {
    symbol want_coffee
    symbol coffee
    symbol enjoy
    symbol latte
    symbol espresso
}

mod customer_impl {
    mod state {
        symbol idle
        symbol thirsty
        symbol ordered
        symbol has_coffee
    }

    // Initializes customer state: (id, preferred_drink, internal_state)
    function init {
    }

    type is_internal_state state::idle | state::thirsty | state::ordered | state::has_coffee;

    type is_state (symbol, symbol, is_internal_state);

    type want_coffee_payload ((), symbol);
    type coffee_payload (symbol, symbol);

    type is_event 
        (want_coffee_payload, super::event::want_coffee) |
        (coffee_payload, super::event::coffee) |
        (want_coffee_payload, super::event::enjoy) |
        ((coffee_payload), super::super::queue::Event::PushBack::tag);

    function anything {
        drop 0
        push true
    }

    type accept_type (is_event, is_state);

    #[precondition(accept_type::check)]
    function accept {
        untuple 2
        untuple 3
        pick 0
        push state::idle
        equal
        branch {
            drop 0 // drop internal_state
            drop 0 // drop preferred_drink
            // Stack: [event, id]
            tuple 0
            roll 1 // Stack: [event, (), id]
            tuple 2 // Stack: [event, ((), id)]
            push super::event::want_coffee
            tuple 2 // Stack: [event, (((), id), want_coffee)]
            equal
        } {
            pick 0
            push state::ordered
            equal
            branch {
                drop 0 // drop internal_state
                // Stack: [event, id, preferred_drink]
                tuple 2 // Stack: [event, (id, preferred_drink)]
                push super::event::coffee
                tuple 2 // Stack: [event, ((id, preferred_drink), coffee)]
                equal
            } {
                pick 0
                push state::has_coffee
                equal
                branch {
                    drop 0 // drop internal_state
                    drop 0 // drop preferred_drink
                    // Stack: [event, id]
                    tuple 0
                    roll 1 // Stack: [event, (), id]
                    tuple 2 // Stack: [event, ((), id)]
                    push super::event::enjoy
                    tuple 2 // Stack: [event, (((), id), enjoy)]
                    equal
                } {
                    pick 0
                    push state::thirsty
                    equal
                    branch {
                        drop 0
                        drop 0
                        drop 0
                        drop 0 // drop event
                        push false
                    } {
                        drop 0
                        drop 0
                        drop 0
                        drop 0
                        push false
                    }
                }
            }
        }
    }

    function tau_reduce {
        push false
        tuple 2
    }

    function emit_postcondition {
        untuple 2
        pick 0
        is_bool
        branch {
            branch {
                jump is_event::check
            } {
                drop 0
                push true
            }
        } {
            drop 0
            drop 0
            push false
        }
    }

    function emit_does_pre_and_post {
        pick 0
        jump is_state::check
        branch {
            jump emit
            jump emit_postcondition
        } {
            drop 0
            push true
        }
    }

    identity emit_does_pre_and_post_is_constant { jump emit_does_pre_and_post } = { drop 0 push true };

    // emit takes state: (id, preferred_drink, internal_state) and returns ValueSet of emitted events.
    #[precondition(is_state::check)]
    #[postcondition(emit_postcondition)]
    function emit {
        untuple 3
        // Stack: [id, preferred_drink, internal_state]
        pick 0
        push state::thirsty
        equal
        branch {
            // Customer emits order request to queue (push_back event)
            drop 0 // drop internal_state. Stack: [id, preferred_drink]
            tuple 2 // (id, preferred_drink)
            tuple 1
            push super::super::queue::Event::PushBack::tag
            tuple 2
            push true
            tuple 2
        } {
            pick 0
            push state::idle
            equal
            branch {
                drop 0
                drop 0
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    drop 0
                    drop 0
                    drop 0
                    tuple 0
                    push false
                    tuple 2
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        drop 0
                        drop 0
                        drop 0
                        tuple 0
                        push false
                        tuple 2
                    } {
                        // Unrecognized internal state: emit nothing.
                        drop 0
                        drop 0
                        drop 0
                        tuple 0
                        push false
                        tuple 2
                    }
                }
            }
        }
    }

    // process takes [state, event] and returns next_state.
    function process {
        untuple 2
        // Stack: [event, state]
        untuple 3
        
        // Check internal_state
        pick 0
        push state::idle
        equal
        branch {
            drop 0 // the tag the branch above already read
            roll 2
            untuple 2
            push super::event::want_coffee
            equal
            branch {
                untuple 2
                drop 0
                drop 0
                push state::thirsty
                tuple 3
            } {
                drop 0
                drop 0
                drop 0
                push ()
            }
        } {
            pick 0
            push state::thirsty
            equal
            branch {
                drop 0 // the tag the branch above already read
                roll 2
                untuple 2
                push super::super::queue::Event::PushBack::tag
                equal
                branch {
                    drop 0
                    push state::ordered
                    tuple 3
                } {
                    drop 0
                    drop 0
                    drop 0
                    push ()
                }
            } {
                pick 0
                push state::ordered
                equal
                branch {
                    drop 0 // the tag the branch above already read
                    roll 2
                    untuple 2
                    push super::event::coffee
                    equal
                    branch {
                        untuple 2
                        drop 0
                        drop 0
                        push state::has_coffee
                        tuple 3
                    } {
                        drop 0
                        drop 0
                        drop 0
                        push ()
                    }
                } {
                    pick 0
                    push state::has_coffee
                    equal
                    branch {
                        drop 0 // the tag the branch above already read
                        roll 2
                        untuple 2
                        push super::event::enjoy
                        equal
                        branch {
                            untuple 2
                            drop 0
                            drop 0
                            push state::idle
                            tuple 3
                        } {
                            drop 0
                            drop 0
                            drop 0
                            push ()
                        }
                    } {
                        drop 0
                        drop 0
                        drop 0
                        drop 0
                        push ()
                    }
                }
            }
        }
    }

    function is_done {
        drop 0
        push false
    }

    function is_ready_to_finish {
        untuple 3
        pick 0
        push state::idle
        equal
        roll 3
        drop 0
        roll 2
        drop 0
        roll 1
        drop 0
    }
}
test sentence verify_customer_is_event {
    // 1. Valid want_coffee event
    push (((), customer_id::c1), event::want_coffee)
    jump customer_impl::is_event::check
    jump crate::prelude::check_true
    ?
    drop 0

    // 2. Valid push_back event
    push (((customer_id::c1, event::latte)), super::queue::Event::PushBack::tag)
    jump customer_impl::is_event::check
    jump crate::prelude::check_true
    ?
    drop 0

    // 3. Valid coffee event
    push ((customer_id::c1, event::latte), event::coffee)
    jump customer_impl::is_event::check
    jump crate::prelude::check_true
    ?
    drop 0

    // 4. Valid enjoy event
    push (((), customer_id::c1), event::enjoy)
    jump customer_impl::is_event::check
    jump crate::prelude::check_true
    ?
    drop 0

    // 5. Invalid event (wrong type)
    push 123
    jump customer_impl::is_event::check
    not
    jump crate::prelude::check_true
    ?
    drop 0

    // 6. Invalid event (missing payload nesting)
    push (customer_id::c1, event::want_coffee)
    jump customer_impl::is_event::check
    not
    jump crate::prelude::check_true
}

test sentence verify_customer_logic {
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    // Idle state accepts want_coffee
    push (((), customer_id::c1), event::want_coffee)
    pick 1
    tuple 2
    jump customer_impl::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // Process want_coffee -> thirsty
    push (((), customer_id::c1), event::want_coffee)
    roll 1
    tuple 2
    jump customer_impl::process
    
    // Thirsty state emits push_back
    pick 0
    jump customer_impl::emit
    untuple 2
    jump crate::prelude::check_true
    ?
    drop 0
    push (((customer_id::c1, event::latte)), super::queue::Event::PushBack::tag)
    jump crate::prelude::check_equals
    ?
    drop 0
    
    // Process push_back -> ordered
    push (((customer_id::c1, event::latte)), super::queue::Event::PushBack::tag)
    roll 1
    tuple 2
    jump customer_impl::process
    
    // Ordered state accepts coffee
    push ((customer_id::c1, event::latte), event::coffee)
    pick 1
    tuple 2
    jump customer_impl::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // Process coffee -> has_coffee
    push ((customer_id::c1, event::latte), event::coffee)
    roll 1
    tuple 2
    jump customer_impl::process
    
    // Has coffee accepts enjoy
    push (((), customer_id::c1), event::enjoy)
    pick 1
    tuple 2
    jump customer_impl::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // Process enjoy -> idle
    push (((), customer_id::c1), event::enjoy)
    roll 1
    tuple 2
    jump customer_impl::process
    
    drop 0
    push ((), crate::prelude::ok)
}

// emit, its postcondition, and the combined check all answer on every input:
// off their intended domain they answer negatively rather than halting.
test sentence verify_emit_totality {
    // Not a triple at all: emit nothing.
    push 42
    jump customer_impl::emit
    push ((), false)
    jump crate::prelude::check_equals
    ?
    drop 0

    // A triple whose internal state is unrecognized: emit nothing.
    push (customer_id::c1, event::latte, event::latte)
    jump customer_impl::emit
    push ((), false)
    jump crate::prelude::check_equals
    ?
    drop 0

    // The postcondition rejects a value that is not an (event, flag) pair, ...
    push 42
    jump customer_impl::emit_postcondition
    not
    jump crate::prelude::check_true
    ?
    drop 0

    // ... and holds for what emit answers on junk.
    push ((), false)
    jump customer_impl::emit_postcondition
    jump crate::prelude::check_true
    ?
    drop 0

    // The combined check holds on a value that is not a state at all, ...
    push 42
    jump customer_impl::emit_does_pre_and_post
    jump crate::prelude::check_true
    ?
    drop 0

    // ... and on a real state, where it runs emit and checks its output.
    push (customer_id::c1, event::latte, customer_impl::state::thirsty)
    jump customer_impl::emit_does_pre_and_post
    jump crate::prelude::check_true
}

mod customer1 compose_static_closure(customer_impl, (super::customer_id::c1, super::event::latte, super::customer_impl::state::idle));
mod customer2 compose_static_closure(customer_impl, (super::customer_id::c2, super::event::espresso, super::customer_impl::state::idle));

mod barista {
    mod state {
        symbol idle
        symbol awaiting_order
        symbol brewing
    }

    // Initializes barista state
    function init {
        // `untuple 0` takes the argument either way, which is the whole of
        // what it does.
        untuple 0
        push state::idle
    }


    function accept {
        untuple 2
        pick 0
        push state::idle
        equal
        branch {
            drop 0 // drop state
            drop 0 // drop event
            push false
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0 // drop state
                // Stack: [event]
                untuple 2
                // Stack: [channel, inner]
                push super::super::queue::Event::AwaitFront::tag
                equal
                branch {
                    // channel == await_front
                    // Stack: [Body]
                    untuple 1
                    // Stack: [reqresp]
                    untuple 2
                    // Stack: [resp_tag, option]
                    push super::super::prelude::resp
                    equal
                    branch {
                        // resp_tag == resp
                        // Stack: [option]
                        untuple 2
                        // Stack: [some_tag, val_tuple]
                        push super::super::prelude::some
                        equal
                        branch {
                            // some_tag == some
                            // Stack: [val_tuple]
                            untuple 2
                            // Stack: [empty_tuple, val]
                            drop 0 // drop val (can be anything)
                            // Stack: [empty_tuple]
                            tuple 0 // push ()
                            equal
                        } {
                            // some_tag != some
                            drop 0
                            push false
                        }
                    } {
                        // resp_tag != resp
                        drop 0
                        push false
                    }
                } {
                    // channel != await_front
                    drop 0
                    push false
                }
            } {
                drop 0 // drop state
                drop 0 // drop event
                push false
            }
        }
    }

    function tau_reduce {
        push false
        tuple 2
    }

    // emit takes [state] and returns ValueSet.
    function emit {
        // Stack: [state]
        pick 0
        push state::idle
        equal
        branch {
            drop 0
            push ()
            push super::super::prelude::req
            tuple 2
            tuple 1
            push super::super::queue::Event::AwaitFront::tag
            tuple 2
            push true
            tuple 2
        } {
            pick 0
            push state::awaiting_order
            equal
            branch {
                drop 0
                tuple 0
                push false
                tuple 2
            } {
                // Must be brewing
                untuple 2
                push state::brewing
                equal
                branch {
                    // Stack: [(id, drink)]
                    untuple 2
                    tuple 2
                    push super::event::coffee
                    tuple 2
                    push true
                    tuple 2
                } {
                    drop 0
                    push ((), false)
                }
            }
        }
    }

    // process takes [state, event] and returns next_state.
    function process {
        untuple 2
        // Inputs: [event, state]
        pick 0 // state
        push state::idle
        equal
        branch {
            // Transition from idle to awaiting_order
            drop 0 // the tag the branch above already read
        
            push ()
            push super::super::prelude::req
            tuple 2
            tuple 1
            push super::super::queue::Event::AwaitFront::tag
            tuple 2
            equal
            branch {
                push state::awaiting_order
            } {
                push state::idle
            }
        } {
            pick 0 // state
            push state::awaiting_order
            equal
            branch {
                // Transition from awaiting_order to brewing.
                drop 0 // the tag the branch above already read
            
                // Destructure event: (((((), val), some), resp), await_front)
                untuple 2
                push super::super::queue::Event::AwaitFront::tag
                equal
                branch {
                    untuple 1

                    untuple 2
                    push super::super::prelude::resp
                    equal
                    branch {
            
                        untuple 2
                        push super::super::prelude::some
                        equal
                        branch {
            
                            untuple 2
                            roll 1
                            push ()
                            equal
                            branch {
            
                                push state::brewing
                                tuple 2 // (val, state::brewing)
                            } {
                                drop 0
                                push state::awaiting_order
                            }
                        } {
                            drop 0
                            push state::awaiting_order
                        }
                    } {
                        drop 0
                        push state::awaiting_order
                    }
                } {
                    drop 0
                    push state::awaiting_order
                }
            } {
                // Must be brewing. Transition to idle.
                untuple 2
                push state::brewing
                equal
                branch {
                    drop 0
                    untuple 2
                    push super::event::coffee
                    equal
                    branch {
                        untuple 2
                        drop 0
                        drop 0
                        push state::idle
                    } {
                        drop 0
                        push ()
                    }
                } {
                    drop 0
                    drop 0
                    push ()
                }
            }
        }
    }

    function is_done {
        drop 0
        push false
    }

    function is_ready_to_finish {
        push state::idle
        equal
    }
}

sentence customers_sync {
    drop 0
    push false
}

mod customers compose_concurrent(customer1, customer2, customers_sync);

sentence customers_queue_sync {
    pick 0
    push crate::prelude::start
    equal
    pick 1
    push crate::prelude::pass
    equal
    or
    pick 1
    push crate::prelude::fail
    equal
    or
    branch {
        drop 0
        push false
    } {
        untuple 2
        drop 1
        push super::queue::Event::PushBack::tag
        equal
    }
}

mod customers_and_queue compose_concurrent(customers, super::queue::queue, customers_queue_sync);

sentence joint_sync {
    pick 0
    push crate::prelude::start
    equal
    pick 1
    push crate::prelude::pass
    equal
    or
    pick 1
    push crate::prelude::fail
    equal
    or
    branch {
        drop 0
        push false
    } {
        untuple 2
        drop 1 // drop payload
        pick 0
        push super::queue::Event::AwaitFront::tag
        equal
        branch {
            drop 0
            push true
        } {
            push event::coffee
            equal
        }
    }
}

mod concurrent compose_concurrent(customers_and_queue, barista, joint_sync);

sentence hidden_events {
    pick 0
    push crate::prelude::start
    equal
    pick 1
    push crate::prelude::pass
    equal
    or
    pick 1
    push crate::prelude::fail
    equal
    or
    branch {
        drop 0
        push false
    } {
        untuple 2
        drop 1 // drop payload
        pick 0
        push super::queue::Event::PushBack::tag
        equal
        branch {
            drop 0
            push true
        } {
            pick 0
            push event::coffee
            equal
            branch {
                drop 0
                push true
            } {
                push super::queue::Event::AwaitFront::tag
                equal
            }
        }
    }
}

mod hidden compose_hidden(concurrent, hidden_events);

// One tau transition of the joint system, which has to be there to take: the
// call sites below spell out how many transitions each step of the test runs,
// so a `tau_step` that finds nothing to reduce is a mistake in the test rather
// than a stopping condition.
sentence hidden_tau_step {
    // Stack: [state]
    jump hidden::tau_reduce
    // Stack: [(next_state, did_reduce)]
    untuple 2
    // Stack: [next_state, did_reduce]
    branch {
        push crate::prelude::ok
        tuple 2
    } {
        push crate::prelude::err
        tuple 2
    }
}

sentence concurrent_tau_step {
    jump concurrent::tau_reduce
    untuple 2
    // Stack: [next_state, did_reduce]
    branch {
        push crate::prelude::ok
        tuple 2
    } {
        push crate::prelude::err
        tuple 2
    }
}

test sentence verify_hidden_system {
    // 1. Initialize joint state
    tuple 0
    jump hidden::init
    
    // 2. Trigger want_coffee for c1. Let's verify it is accepted.
    push (((), customer_id::c1), event::want_coffee)
    pick 1
    tuple 2
    jump hidden::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // 2. Trigger event::want_coffee for c1
    push (((), customer_id::c1), event::want_coffee)
    roll 1
    tuple 2
    jump hidden::process
    
    // 3. Drive tau -> Barista serves Customer 1, in seven transitions
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    
    // Verify state: Customer 1 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 // customers
    
    push ((), super::queue::State::AwaitingPush::tag) // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint state
    equal
    jump crate::prelude::check_true
    ?
    drop 0
    
    // customer 2 wants coffee. Let's verify it is accepted.
    push (((), customer_id::c2), event::want_coffee)
    pick 1
    tuple 2
    jump hidden::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // 4. Trigger event::want_coffee for c2
    push (((), customer_id::c2), event::want_coffee)
    roll 1
    tuple 2
    jump hidden::process
    
    // 5. Drive tau -> Barista serves Customer 2, in four transitions
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    jump hidden_tau_step
    ?
    
    // Verify state: Customer 1 and Customer 2 both have coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::has_coffee
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 // customers
    
    push ((), super::queue::State::AwaitingPush::tag) // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint state
    equal
    jump crate::prelude::check_true
    ?
    drop 0
    
    // customer 1 enjoys coffee. Let's verify it is accepted.
    push (((), customer_id::c1), event::enjoy)
    pick 1
    tuple 2
    jump hidden::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // 6. Trigger enjoy for c1
    push (((), customer_id::c1), event::enjoy)
    roll 1
    tuple 2
    jump hidden::process
    
    // Verify state: Customer 1 is idle, Customer 2 has coffee
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::has_coffee
    tuple 3
    
    tuple 2 // customers
    
    push ((), super::queue::State::AwaitingPush::tag) // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint
    equal
    jump crate::prelude::check_true
    ?
    drop 0
    
    // customer 2 enjoys coffee. Let's verify it is accepted.
    push (((), customer_id::c2), event::enjoy)
    pick 1
    tuple 2
    jump hidden::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    // 7. Trigger enjoy for c2
    push (((), customer_id::c2), event::enjoy)
    roll 1
    tuple 2
    jump hidden::process
    
    // Verify state: both idle
    pick 0
    push customer_id::c1
    push event::latte
    push customer_impl::state::idle
    tuple 3
    
    push customer_id::c2
    push event::espresso
    push customer_impl::state::idle
    tuple 3
    
    tuple 2 // customers
    
    push ((), super::queue::State::AwaitingPush::tag) // queue
    
    tuple 2 // customers and queue
    
    push barista::state::awaiting_order // barista
    
    tuple 2 // joint
    equal
    jump crate::prelude::check_true
    ?
    drop 0
    
    drop 0 // clean up state
    push ((), crate::prelude::ok)
}

// Test the concurrent joint Customer-Queue-Barista system
test sentence verify_concurrent_system {
    // 1. Initialize joint state
    tuple 0
    jump concurrent::init
    
    // 2. Barista requests await_front
    pick 0
    jump concurrent::emit
    untuple 2
    jump crate::prelude::check_true
    ?
    drop 0
    
    push ()
    push super::prelude::req
    tuple 2
    tuple 1
    push super::queue::Event::AwaitFront::tag
    tuple 2
    jump crate::prelude::check_equals
    ?
    drop 0
    
    push ()
    push super::prelude::req
    tuple 2
    tuple 1
    push super::queue::Event::AwaitFront::tag
    tuple 2
    roll 1
    tuple 2
    jump concurrent::process
    
    // 3. Customer 1 wants coffee (accepted from environment)
    push (((), customer_id::c1), event::want_coffee)
    pick 1
    tuple 2
    jump concurrent::accept
    jump crate::prelude::check_true
    ?
    drop 0
    
    push (((), customer_id::c1), event::want_coffee)
    roll 1
    tuple 2
    jump concurrent::process
    
    // 4. Customer 2 wants coffee (accepted from environment)
    push (((), customer_id::c2), event::want_coffee)
    pick 1
