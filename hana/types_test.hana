// The shape of `barista::customer_impl::emit_does_pre_and_post`, with
// everything but the shape taken away.
//
// A function guarded by a precondition and answering a postcondition is
// *constantly true* when you ask "either the precondition failed, or the answer
// satisfies the postcondition" — that is what a contract means, and it is a
// claim about the code rather than about any value it runs on. The barista's
// version of that claim is buried under four states, a tuple of three and an
// event enum. This one has two symbols and a pair, and states the same thing.

symbol t1
symbol t2

// The precondition: the input is one of the two symbols we know.
function is_tag {
    pick 0
    push t1
    equal
    branch {
        drop 0
        push true
    } {
        push t2
        equal
    }
}

// The postcondition: the answer is one of the two pairs we make.
function is_numbered {
    pick 0
    push t1
    push 1
    tuple 2
    equal
    branch {
        drop 0
        push true
    } {
        push t2
        push 2
        tuple 2
        equal
    }
}

// The function under contract: `t1` numbers as 1, `t2` as 2, and anything else
// gets the empty tuple — which is exactly the answer the postcondition rejects,
// and exactly the input the precondition rules out.
//
// `#[type(is_tag -> is_numbered)]` is the contract stated as a type, and a
// type is a claim: the compiler writes `number_has_type` beside this function,
// which is `number_does_pre_and_post_is_constant` below with nothing changed
// but the name. The two are kept side by side so the generated claim can be
// read against the spelled-out one.
#[precondition(is_tag)]
#[postcondition(is_numbered)]
#[type(is_tag -> is_numbered)]
function number {
    pick 0
    push t1
    equal
    branch {
        drop 0
        push t1
        push 1
        tuple 2
    } {
        pick 0
        push t2
        equal
        branch {
            drop 0
            push t2
            push 2
            tuple 2
        } {
            drop 0
            tuple 0
        }
    }
}

// `not precondition or (function ; postcondition)`, written the way a branch
// writes it. Nothing about this reads as constant — it copies its input, tests
// it, and on one path runs the whole of `number` and checks the answer.
function number_does_pre_and_post {
    pick 0
    jump is_tag
    branch {
        jump number
        jump is_numbered
    } {
        drop 0
        push true
    }
}

identity number_does_pre_and_post_is_constant
    { jump number_does_pre_and_post }
  = { drop 0 push true };

// What `#[type(is_tag -> is_numbered)]` on `number` states, written out. The
// annotation lowers to exactly this claim, under the name `number_has_type`:
//
//     identity number_has_type
//         { pick 0 jump is_tag branch { jump number jump is_numbered }
//                                      { drop 0 push true } }
//       = { drop 0 push true };
//
// A spec that names a `type` compiles as it would inside one — `is_tag` is a
// function here, so it is called; a `type Tag …;` would be `Tag::check`, and
// a symbol would be `push sym ; equal`.
